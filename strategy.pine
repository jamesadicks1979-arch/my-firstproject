//@version=5
strategy("DKO Pattern Strategy + SMA Filter", overlay = true, format=format.price, precision=2, max_lines_count = 500, max_labels_count = 500, max_bars_back=500)

// ==========================================
// 1. INPUTS
// ==========================================
useTrendFilter = input.bool(true, "Use SMA Trend Filter?")
fastLen        = input.int(5, "Fast SMA Length", minval=1)
slowLen        = input.int(9, "Slow SMA Length", minval=1)
rangePct       = input.float(0.60, "Min Candle Range Pct (0.60 = 60%)", minval=0.0, maxval=1.0)
extremeLen     = input.int(20, "Extreme Lookback Length", minval=1)


// ==========================================
// 2. TREND FILTER (SMA 5 & 9)
// ==========================================
smaFast = ta.sma(close, fastLen) // SMA 5
smaSlow = ta.sma(close, slowLen) // SMA 9

// Plot SMAs for visual reference
plot(useTrendFilter ? smaFast : na, "Fast SMA (5)", color=color.blue, linewidth=1)
plot(useTrendFilter ? smaSlow : na, "Slow SMA (9)", color=color.orange, linewidth=1)

// Trend Logic:
// 5 > 9 => Uptrend (Take PERs/Buys)
// 5 < 9 => Downtrend (Take COVERs/Sells)
isUptrend   = not useTrendFilter or (smaFast > smaSlow)
isDowntrend = not useTrendFilter or (smaFast < smaSlow)


// ==========================================
// 3. EXTREME FILTER (20-bar Low/High)
// ==========================================
// Check if current candle matches the 20-bar extreme
isLowest20  = (low <= ta.lowest(low, extremeLen))
isHighest20 = (high >= ta.highest(high, extremeLen))


// ==========================================
// 4. PATTERN DEFINITIONS (DKO)
// ==========================================

// Helper: Calculate where the close is relative to the High-Low range (0.0 to 1.0)
// 1.0 = Close at High, 0.0 = Close at Low
candleRange = high - low
rangePos    = (candleRange > 0) ? (close - low) / candleRange : 0.5

// COVER (sell) pattern
// Logic: Higher Low, Close < Open (Bearish), Higher High
// Added: Close must be in the lower part of the candle (Strong Bearish Close)
dkoCover = (low > low[1]) and (close < open) and (high > high[1]) and (rangePos < (1.0 - rangePct))

// PER (buy) pattern
// Logic: Lower High, Close > Open (Bullish), Lower Low
// Added: Close must be in the upper part of the candle (Strong Bullish Close)
dkoPer   = (high < high[1]) and (close > open) and (low < low[1]) and (rangePos > rangePct)


// ==========================================
// 5. STRATEGY EXECUTION
// ==========================================

// --- SELL LOGIC ---
// Valid if: (Pattern AND Downtrend) OR (Pattern AND Highest High of last 20)
// Note: We prioritize the Pattern logic.
if (dkoCover and (isDowntrend or isHighest20))
    strategy.entry("Sell", strategy.short, stop=low)
    alert("Sell Signal (DKO Cover)", alert.freq_once_per_bar_close)

// --- BUY LOGIC ---
// Valid if: (Pattern AND Uptrend) OR (Pattern AND Lowest Low of last 20)
if (dkoPer and (isUptrend or isLowest20))
    strategy.entry("Buy", strategy.long, stop=high)
    alert("Buy Signal (DKO Per)", alert.freq_once_per_bar_close)


// ==========================================
// 6. VISUALS
// ==========================================
plotshape(dkoCover and (isDowntrend or isHighest20), title="Sell Pattern", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small, text="COVER")
plotshape(dkoPer   and (isUptrend   or isLowest20),  title="Buy Pattern",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="PER")
