// Modified: added strategy entries/exits + stop/target plotting

//@version=5
strategy("Nadaraya-Watson Envelope [LuxAlgo] + R:R Trades", "LuxAlgo - Nadaraya-Watson Envelope + Trades", overlay = true, format=format.price, precision=2,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back=500, pyramiding=0)

// ───────── Trade inputs ─────────
enableLongs  = input.bool(true,  "Enable Longs",  group="Trades")
enableShorts = input.bool(true,  "Enable Shorts", group="Trades")
stopLen      = input.int(5,      "Stop lookback bars", minval=1, group="Trades")
rr           = input.float(2.0,  "Profit target (R multiple)", minval=0.1, step=0.1, group="Trades")
signalMode   = input.string("Within window", "Signal mode", options=["Same bar", "Within window"], group="Trades")
confirmBars  = input.int(5, "MA confirm window (bars)", minval=1, group="Trades", tooltip="In 'Within window' mode: after price closes beyond the band, a BUY/SELL can trigger within this many bars once price closes back across the MA.")
plotSignals  = input.bool(true, "Plot BUY/SELL markers", group="Trades")
plotBoxes    = input.bool(false, "Plot signal box", group="Trades")
boxLookback  = input.int(10, "Box lookback bars", minval=1, group="Trades", tooltip="Box will cover the high/low range of the last N bars ending on the signal bar.")
boxOpacity   = input.int(85, "Box fill opacity (0-100)", minval=0, maxval=100, group="Trades")
maxSigBoxes  = input.int(50, "Max signal boxes to keep", minval=0, group="Trades")
maExit       = input.bool(true, "Exit when close crosses MA (market)", group="Trades", tooltip="If in a trade, exit when price CLOSES back on the other side of the MA.")
markPnL      = input.bool(true, "Mark PROFIT/STOP on exits", group="Trades")

// ───────── Original inputs ─────────
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input.int(14, 'Common Period')
ATR = ta.sma(ta.tr, AP)
// Match original LuxAlgo input style
src = input(close)
showsignalsk = input.bool(title='Show Signals?', defval=true)
novolumedata = input.bool(title='Change calculation (no volume data)?', defval=false)
upT = low - ATR * coeff
downT = high + ATR * coeff

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
h = input.float(8.,'Bandwidth', minval = 0)
mult = input.float(3., minval = 0)

repaint = input.bool(true, 'Repainting Smoothing', tooltip = 'Repainting is an effect where the indicators historical output is subject to change over time. Disabling repainting will cause the indicator to output the endpoints of the calculations')

//Style
upCss = input.color(color.teal, 'Colors', inline = 'inline1', group = 'Style')
dnCss = input.color(color.red, '', inline = 'inline1', group = 'Style')
bandHistoryBars = input.int(2000, "Repaint band history (bars)", minval=200, maxval=5000, group="Style", tooltip="How far back the repainting bands draw. Larger values are heavier.")
showSignalBands = input.bool(false, "Show signal bands (non-repainting)", group="Style", tooltip="Signals/trades use these non-repainting bands. Turn ON to visually verify every BUY/SELL condition.")
sigBandOpacity  = input.int(35, "Signal band opacity (0-100)", minval=0, maxval=100, group="Style")

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Gaussian window
gauss(x, h) => math.exp(-(math.pow(x, 2) / (h * h * 2)))

//-----------------------------------------------------------------------------}
//Append lines
//-----------------------------------------------------------------------------{
n = bar_index

// (kept to match original LuxAlgo structure)
var ln = array.new_line(0)
if barstate.isfirst and repaint
    for _ = 0 to 499
        array.push(ln, line.new(na, na, na, na))

//-----------------------------------------------------------------------------}
//End point method (NON-repainting series for trading/signals)
//-----------------------------------------------------------------------------{
var coefs = array.new_float(0)
var float den = na

if barstate.isfirst
    for i = 0 to 499
        w = gauss(i, h)
        coefs.push(w)
    den := coefs.sum()

float outNR = na
if not na(den)
    float acc = 0.0
    for i = 0 to 499
        acc += src[i] * coefs.get(i)
    outNR := acc / den

maeNR = ta.sma(math.abs(src - outNR), 499) * mult

upperNR = outNR + maeNR
lowerNR = outNR - maeNR

//-----------------------------------------------------------------------------}
//Crossing Arrows (from non-repainting values)
plotshape(showsignalsk and ta.crossunder(close, outNR - maeNR) ? low : na, "Crossunder", shape.labelup, location.absolute, color(na), 0, text='▲', textcolor=upCss, size=size.tiny)
plotshape(showsignalsk and ta.crossover(close, outNR + maeNR) ? high : na, "Crossover", shape.labeldown, location.absolute, color(na), 0, text='▼', textcolor=dnCss, size=size.tiny)

// ───────── Moving Average (make it visible) ─────────
length = input.int(9, minval=1, group="MA")
src1 = input(close, title="Source", group="MA")
lenHalf = math.max(1, int(math.floor(length / 2.0)))
lenSqrt = math.max(1, int(math.floor(math.sqrt(length))))
hullma = ta.wma(2 * ta.wma(src1, lenHalf) - ta.wma(src1, length), lenSqrt)
plot(hullma, title="Hull MA", color=color.new(color.blue, 0), linewidth=2)

//-----------------------------------------------------------------------------}
//Compute and display NWE (repainting visual mode) — matches original LuxAlgo
//-----------------------------------------------------------------------------{
float y2 = na
float y1 = na

nwe = array.new<float>(0)
if barstate.islast and repaint
    sae = 0.
    //Compute and set NWE point
    // NOTE: TradingView limits history lookbacks; keep this <= 499 to avoid runtime errors.
    hist = math.min(499, n - 1)
    for i = 0 to hist
        sum = 0.
        sumw = 0.
        //Compute weighted mean
        for j = 0 to math.min(499, n - 1)
            w = gauss(i - j, h)
            sum += src[j] * w
            sumw += w

        y2 := sum / sumw
        sae += math.abs(src[i] - y2)
        nwe.push(y2)

    sae := sae / math.max(1, hist) * mult
    for i = 0 to hist
        if i % 2
            line.new(n - i + 1, y1 + sae, n - i, nwe.get(i) + sae, color=upCss)
            line.new(n - i + 1, y1 - sae, n - i, nwe.get(i) - sae, color=dnCss)

        // Labels (visual only)
        if i < hist and src[i] > nwe.get(i) + sae and src[i + 1] < nwe.get(i) + sae
            label.new(n - i, src[i], '▼', color=color(na), style=label.style_label_down, textcolor=dnCss, textalign=text.align_center)
        if i < hist and src[i] < nwe.get(i) - sae and src[i + 1] > nwe.get(i) - sae
            label.new(n - i, src[i], '▲', color=color(na), style=label.style_label_up, textcolor=upCss, textalign=text.align_center)

        y1 := nwe.get(i)

//-----------------------------------------------------------------------------}
//Dashboard
//-----------------------------------------------------------------------------{
var tb = table.new(position.top_right, 1, 1
  , bgcolor = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color = #373a46
  , frame_width = 1)

if repaint
    tb.cell(0, 0, 'Repainting Mode Enabled', text_color=color.white, text_size=size.small)

//-----------------------------------------------------------------------------}
//Plot (match original: hide plots in repaint mode)
//-----------------------------------------------------------------------------}
plot(repaint ? na : upperNR, 'Upper', upCss)
plot(repaint ? na : lowerNR, 'Lower', dnCss)

// Always show the NON-repainting bands used for signals (optional)
plot(showSignalBands ? upperNR : na, 'Signal Upper (NR)', color=color.new(upCss, sigBandOpacity), linewidth=1)
plot(showSignalBands ? lowerNR : na, 'Signal Lower (NR)', color=color.new(dnCss, sigBandOpacity), linewidth=1)

// ───────── Trading rules (use NON-repainting bands) ─────────
// Two modes:
// - Same bar: SELL/BUY must be true on the same candle.
// - Within window: a CLOSE outside the band ARMS the setup; within N bars, a qualifying candle can trigger.
//
// IMPORTANT: per your request, signals must be on a candle that OPENS outside the band
// (above upper for SELL / below lower for BUY).
shortBreak = close > upperNR
longBreak  = close < lowerNR

var int shortArmed = 0
var int longArmed  = 0

if shortBreak
    shortArmed := confirmBars
else
    shortArmed := math.max(shortArmed - 1, 0)

if longBreak
    longArmed := confirmBars
else
    longArmed := math.max(longArmed - 1, 0)

// Same-bar entries (single candle reversal):
// SELL: candle OPENS above upper band AND CLOSES below MA
// BUY : candle OPENS below lower band AND CLOSES above MA
shortSignalSame = enableShorts and (open > upperNR) and (close < hullma)
longSignalSame  = enableLongs  and (open < lowerNR) and (close > hullma)

// Window mode:
// After a CLOSE outside the band (arm), trigger on a candle that OPENS outside the band
// and CLOSES on the other side of the MA.
shortConfirmOk = (open > upperNR) and (close < hullma)
longConfirmOk  = (open < lowerNR) and (close > hullma)

shortSignalWindow = enableShorts and (shortArmed > 0) and shortConfirmOk
longSignalWindow  = enableLongs  and (longArmed  > 0) and longConfirmOk

shortSignal = signalMode == "Same bar" ? shortSignalSame : shortSignalWindow
longSignal  = signalMode == "Same bar" ? longSignalSame  : longSignalWindow

// Avoid repeated signals in window mode after first trigger
if signalMode == "Within window"
    if shortSignalWindow
        shortArmed := 0
    if longSignalWindow
        longArmed := 0

// ───────── Signal box helper ─────────
var sigBoxes = array.new_box(0)
f_addSignalBox(_isShort) =>
    if plotBoxes and bar_index >= boxLookback
        top = ta.highest(high, boxLookback)
        bot = ta.lowest(low, boxLookback)
        if not na(top) and not na(bot)
            c = _isShort ? dnCss : upCss
            b = box.new(left=bar_index - boxLookback + 1, top=top, right=bar_index, bottom=bot, xloc=xloc.bar_index,
                 border_color=c, bgcolor=color.new(c, boxOpacity))
            array.push(sigBoxes, b)
            if array.size(sigBoxes) > maxSigBoxes
                old = array.shift(sigBoxes)
                box.delete(old)

// If boxes are turned off, remove any previously drawn ones
if not plotBoxes and array.size(sigBoxes) > 0
    for i = 0 to array.size(sigBoxes) - 1
        box.delete(array.get(sigBoxes, i))
    array.clear(sigBoxes)

// (Signal mode/confirm window inputs are kept for now, but trading is enforced as STRICT same-bar.)

// Draw boxes on signal bars
if shortSignal
    f_addSignalBox(true)
if longSignal
    f_addSignalBox(false)

var float shortStop   = na
var float shortTarget = na
var float longStop    = na
var float longTarget  = na

flat = strategy.position_size == 0

if flat and shortSignal
    shortStop := ta.highest(high, stopLen)
    risk = shortStop - close
    shortTarget := risk > syminfo.mintick ? (close - rr * risk) : na
    if not na(shortTarget)
        strategy.entry("S", strategy.short)

if flat and longSignal
    longStop := ta.lowest(low, stopLen)
    risk = close - longStop
    longTarget := risk > syminfo.mintick ? (close + rr * risk) : na
    if not na(longTarget)
        strategy.entry("L", strategy.long)

if strategy.position_size < 0 and not na(shortStop) and not na(shortTarget)
    strategy.exit("S-exit", from_entry="S", stop=shortStop, limit=shortTarget)

if strategy.position_size > 0 and not na(longStop) and not na(longTarget)
    strategy.exit("L-exit", from_entry="L", stop=longStop, limit=longTarget)

// Exit when price CLOSES back across the MA (market exit)
if maExit and strategy.position_size < 0 and close > hullma
    strategy.close("S")
if maExit and strategy.position_size > 0 and close < hullma
    strategy.close("L")

if flat
    shortStop := na
    shortTarget := na
    longStop := na
    longTarget := na

// Plot markers on every signal bar (not only when flat)
plotshape(plotSignals and shortSignal, title="SELL", style=shape.labeldown, text="SELL", location=location.abovebar, color=dnCss, textcolor=color.white, size=size.tiny)
plotshape(plotSignals and longSignal,  title="BUY",  style=shape.labelup,   text="BUY",  location=location.belowbar, color=upCss, textcolor=color.white, size=size.tiny)

plot(strategy.position_size < 0 ? shortStop   : na, "Short Stop",   color=color.new(color.red, 0),   linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortTarget : na, "Short Target", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

plot(strategy.position_size > 0 ? longStop    : na, "Long Stop",    color=color.new(color.red, 0),   linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longTarget  : na, "Long Target",  color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

// Mark PROFIT / STOP on the chart when trades close
var int lastClosed = 0
if markPnL and strategy.closedtrades > lastClosed
    for t = lastClosed to strategy.closedtrades - 1
        xb = strategy.closedtrades.exit_bar_index(t)
        yp = strategy.closedtrades.exit_price(t)
        pr = strategy.closedtrades.profit(t)
        isWin = pr > 0
        txt = isWin ? "PROFIT" : "STOP"
        col = isWin ? color.new(color.green, 0) : color.new(color.red, 0)
        style = isWin ? label.style_label_up : label.style_label_down
        label.new(x=xb, y=yp, xloc=xloc.bar_index, text=txt, style=style, color=color.new(col, 75), textcolor=col, size=size.tiny)
    lastClosed := strategy.closedtrades
