//@version=5
strategy("Nadaraya-Watson Envelope [LuxAlgo] + R:R Trades", "LuxAlgo - NWE + Trades", overlay = true, format=format.price, precision=2,
     max_lines_count = 500, max_labels_count = 500, max_bars_back=500, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0)

// ───────── Trade inputs ─────────
enableLongs  = input.bool(true,  "Enable Longs",  group="Trades")
enableShorts = input.bool(true,  "Enable Shorts", group="Trades")
stopLen      = input.int(5,      "Stop lookback bars", minval=1, group="Trades")
rr           = input.float(2.0,  "Profit target (R multiple)", minval=0.1, step=0.1, group="Trades")

// ───────── Original inputs ─────────
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input.int(14, 'Common Period')
ATR = ta.sma(ta.tr, AP)
src = input.source(close, 'Source')
showsignalsk = input.bool(title='Show Signals?', defval=true)
novolumedata = input.bool(title='Change calculation (no volume data)?', defval=false)
upT = low - ATR * coeff
downT = high + ATR * coeff

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
h = input.float(8.,'Bandwidth', minval = 0)
mult = input.float(3., minval = 0)

// NOTE: Trading logic below uses NON-repainting band values.
repaint = input.bool(false, 'Repainting Smoothing (visual only)', tooltip = 'Repainting changes past values; keep this OFF for trading/alerts.')

//Style
upCss = input.color(color.teal, 'Colors', inline = 'inline1', group = 'Style')
dnCss = input.color(color.red, '', inline = 'inline1', group = 'Style')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
//Gaussian window
gauss(x, h) => math.exp(-(math.pow(x, 2)/(h * h * 2)))

//-----------------------------------------------------------------------------}
//Append lines (visual repaint mode only)
//-----------------------------------------------------------------------------{
n = bar_index
var ln = array.new_line(0)

if barstate.isfirst and repaint
    for i = 0 to 499
        array.push(ln, line.new(na, na, na, na))

//-----------------------------------------------------------------------------}
//End point method (NON-repainting bands used for signals)
//-----------------------------------------------------------------------------{
var coefs = array.new_float(0)
var float den = na

if barstate.isfirst
    for i = 0 to 499
        w = gauss(i, h)
        coefs.push(w)
    den := coefs.sum()

float out = na
if not na(den)
    float acc = 0.0
    for i = 0 to 499
        acc += src[i] * coefs.get(i)
    out := acc / den

mae = ta.sma(math.abs(src - out), 499) * mult

upper = out + mae
lower = out - mae

//-----------------------------------------------------------------------------}
//Signals & MA
//-----------------------------------------------------------------------------{
length = input.int(9, minval=1, group="MA")
src1 = input.source(close, title="MA Source", group="MA")
hullma = ta.wma(2 * ta.wma(src1, length / 2) - ta.wma(src1, length), math.floor(math.sqrt(length)))

plot(hullma, "Hull MA", color=color.new(color.white, 0))

// Optional crossing arrows (original)
plotshape(showsignalsk and ta.crossunder(close, lower) ? low : na, "Crossunder", shape.labelup, location.absolute, color(na), 0 , text = '▲', textcolor = upCss, size = size.tiny)
plotshape(showsignalsk and ta.crossover(close, upper) ? high : na, "Crossover", shape.labeldown, location.absolute, color(na), 0 , text = '▼', textcolor = dnCss, size = size.tiny)

//-----------------------------------------------------------------------------}
//Compute and display NWE (visual repaint mode only)
//-----------------------------------------------------------------------------{
float y2 = na
float y1 = na

nwe = array.new<float>(0)
if barstate.islast and repaint
    sae = 0.
    //Compute and set NWE point
    for i = 0 to math.min(499, n - 1)
        sum = 0.
        sumw = 0.
        //Compute weighted mean
        for j = 0 to math.min(499, n - 1)
            w = gauss(i - j, h)
            sum += src[j] * w
            sumw += w

        y2 := sum / sumw
        sae += math.abs(src[i] - y2)
        nwe.push(y2)

    sae := sae / math.min(499, n - 1) * mult
    for i = 0 to math.min(499, n - 1)
        if i % 2
            line.new(n - i + 1, y1 + sae, n - i, nwe.get(i) + sae, color = upCss)
            line.new(n - i + 1, y1 - sae, n - i, nwe.get(i) - sae, color = dnCss)

        if src[i] > nwe.get(i) + sae and src[i + 1] < nwe.get(i) + sae
            label.new(n - i, src[i], '▼', color = color(na), style = label.style_label_down, textcolor = dnCss, textalign = text.align_center)
        if src[i] < nwe.get(i) - sae and src[i + 1] > nwe.get(i) - sae
            label.new(n - i, src[i], '▲', color = color(na), style = label.style_label_up, textcolor = upCss, textalign = text.align_center)

        y1 := nwe.get(i)

//-----------------------------------------------------------------------------}
//Dashboard
//-----------------------------------------------------------------------------{
var tb = table.new(position.top_right, 1, 1
  , bgcolor = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color = #373a46
  , frame_width = 1)

if repaint
    tb.cell(0, 0, 'Repainting Mode Enabled (visual only)', text_color = color.white, text_size = size.small)

//-----------------------------------------------------------------------------}
//Plot bands (non-repainting)
//-----------------------------------------------------------------------------}
plot(upper, 'Upper', upCss)
plot(lower, 'Lower', dnCss)

// ───────── Trading rules ─────────
// Your requested short:
// 1) close above upper band
// 2) and close below the MA (hullma)
shortSignal = enableShorts and (close > upper) and (close < hullma)

// Optional symmetric long (you can disable with Enable Longs)
longSignal  = enableLongs and (close < lower) and (close > hullma)

// Persist stop/target levels so they can be plotted
var float shortStop   = na
var float shortTarget = na
var float longStop    = na
var float longTarget  = na

flat = strategy.position_size == 0

// Entries
if flat and shortSignal
    shortStop := ta.highest(high, stopLen)
    risk = shortStop - close
    shortTarget := risk > syminfo.mintick ? (close - rr * risk) : na

    if not na(shortTarget)
        strategy.entry("S", strategy.short)

if flat and longSignal
    longStop := ta.lowest(low, stopLen)
    risk = close - longStop
    longTarget := risk > syminfo.mintick ? (close + rr * risk) : na

    if not na(longTarget)
        strategy.entry("L", strategy.long)

// Exits (fixed stop & target captured at signal)
if strategy.position_size < 0 and not na(shortStop) and not na(shortTarget)
    strategy.exit("S-exit", from_entry="S", stop=shortStop, limit=shortTarget)

if strategy.position_size > 0 and not na(longStop) and not na(longTarget)
    strategy.exit("L-exit", from_entry="L", stop=longStop, limit=longTarget)

// Reset when flat again
if flat
    shortStop := na
    shortTarget := na
    longStop := na
    longTarget := na

// Plot entries + stop/target lines on chart
plotshape(shortSignal and flat, title="SELL", style=shape.labeldown, text="SELL", location=location.abovebar, color=dnCss, textcolor=color.white, size=size.tiny)
plotshape(longSignal and flat,  title="BUY",  style=shape.labelup,   text="BUY",  location=location.belowbar, color=upCss, textcolor=color.white, size=size.tiny)

plot(strategy.position_size < 0 ? shortStop   : na, "Short Stop",   color=color.new(color.red, 0),   linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortTarget : na, "Short Target", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

plot(strategy.position_size > 0 ? longStop    : na, "Long Stop",    color=color.new(color.red, 0),   linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longTarget  : na, "Long Target",  color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
