// Variable to store 7:15 condition result
var bool conditionMetAt715 = false

if isCheckTime715()
    threshold50Ticks = openPrice700 + (50 * syminfo.mintick)
    // Check if High (up to 7:15 close/high) exceeded threshold
    // `highSince700` tracks highs from 7:00. At 7:15 bar, it includes 7:15 high? 
    // `isCheckTime715` returns true on the bar starting at 7:15. 
    // The "by 7.15" usually excludes the 7.15 price action itself or includes it?
    // Assuming "by 7.15" means from 7:00 up to the moment 7:15 starts (so [7:00, 7:15)).
    // `highSince700` is updated at the start of the bar? No, it updates on every bar.
    // If we are on the 7:15 bar, highSince700 currently holds max(highs 7:00...7:14) + current 7:15 high.
    // Let's use the high so far.
    if highSince700 <= threshold50Ticks
        conditionMetAt715 := true
    else
        conditionMetAt715 := false

// 7:20 Action
isCheckTime720() =>
    h = hour(time, "Europe/London")
    m = minute(time, "Europe/London")
    targetM = londonStartMinute + 20
    h == londonStartHour and m == targetM

if isCheckTime720() and conditionMetAt715
    // "sell 7.20 opening price"
    sellPrice720 = open
    
    // "put a sell above that candle" -> confusing. 
    // Maybe "put a Stop above that candle"? 
    // Or "Sell Limit above that candle"? 
    // Given context of selling, "Sell above that candle" implies a Sell Limit above the High of the 7:20 candle?
    // Or did you mean "put a STOP above that candle"?
    // I will assume "Stop Loss above the 7:20 candle High".
    stopPrice720 = high // This is the high of the 7:20 bar SO FAR? Or Previous candle? 
    // "Above that candle" usually implies the signal candle (7:20).
