//@version=5
indicator("Bunds Open - London Start", overlay=true, max_lines_count=500, max_labels_count=500)

// Input for the time
londonStartHour = input.int(7, "London Start Hour", minval=0, maxval=23)
londonStartMinute = input.int(0, "London Start Minute", minval=0, maxval=59)

// Inputs for Offsets (in Ticks)
sellOffsetTicksDefault = input.int(100, "Default Sell Offset (Ticks)", minval=0)
stopOffsetTicksDefault = input.int(160, "Default Stop Offset (Ticks)", minval=0)

sellOffsetTicksMoved = input.int(200, "Moved Sell Offset (Ticks)", minval=0)
stopOffsetTicksMoved = input.int(260, "Moved Stop Offset (Ticks)", minval=0)

// Function to check if the current bar is at the specific London time
isLondonStart() =>
    h = hour(time, "Europe/London")
    m = minute(time, "Europe/London")
    h == londonStartHour and m == londonStartMinute

// Background color for start time
bgcolor(isLondonStart() ? color.new(color.blue, 80) : na, title="London Start Background")

// Persistent variables to store 7:00 data
var float openPrice700 = na

// 1. Capture 7:00 Open
if isLondonStart()
    openPrice700 := open
    // Draw vertical line for the start
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.blue, style=line.style_dashed, width=1)

// 2. Check Logic at 7:05
isCheckTime705() =>
    h = hour(time, "Europe/London")
    m = minute(time, "Europe/London")
    targetM = londonStartMinute + 5
    // Returns true at the START of the 7:05 bar
    h == londonStartHour and m == targetM

if isCheckTime705() and not na(openPrice700)
    // "if the market trades above 10 pips before 7.05"
    // 10 pips = 100 ticks (assuming 1 pip = 10 ticks for this instrument context, or just strict 100 ticks as requested before)
    // User said "above 10 pips ... move ... to 200 ticks".
    // Let's assume the threshold is 100 ticks (10 pips).
    thresholdPrice = openPrice700 + (100 * syminfo.mintick)
    
    // Debug
    // label.new(bar_index, high, "Check 7:05. Open700=" + str.tostring(openPrice700) + " Curr=" + str.tostring(open), textcolor=color.white)

    // Using 'close' as per original request that worked before
    // Even if 'open' is technically more correct at start of bar, 'close' was what showed lines before.
    isAbove = close > thresholdPrice
    
    float finalSellOffset = na
    float finalStopOffset = na
    
    if isAbove
        // Move lines
        finalSellOffset := sellOffsetTicksMoved // 200
        finalStopOffset := stopOffsetTicksMoved // 260
    else
        // Stay same
        finalSellOffset := sellOffsetTicksDefault // 100
        finalStopOffset := stopOffsetTicksDefault // 160
    
    // Calculate Levels
    sellLevel = openPrice700 + (finalSellOffset * syminfo.mintick)
    stopLevel = openPrice700 + (finalStopOffset * syminfo.mintick)
    
    // Draw Lines starting NOW (7:05)
    
    // Sell Line Duration: 2 hours (from 7:05)
    sellDuration = 2 * 60 * 60 * 1000
    sellEndTime = time + sellDuration
    
    line.new(x1=time, y1=sellLevel, x2=sellEndTime, y2=sellLevel, xloc=xloc.bar_time, color=color.green, style=line.style_solid, width=2)
    
    // Stop Line Duration: Until 12:00
    // 12:00 is (12 - 7) = 5 hours from 7:00.
    // We are at 7:05.
    // Time until 12:00 = (5 hours) - 5 minutes = 4h 55m.
    timeTo12 = (5 * 60 * 60 * 1000) - (5 * 60 * 1000)
    stopEndTime = time + timeTo12
    
    line.new(x1=time, y1=stopLevel, x2=stopEndTime, y2=stopLevel, xloc=xloc.bar_time, color=color.red, style=line.style_solid, width=2)
