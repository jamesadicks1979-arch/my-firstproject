//@version=5
strategy("Outside 2D Timeframe -> Buy/Sell Next Open", overlay=true, pyramiding=0, process_orders_on_close=false, max_bars_back=500)

// ───────── Inputs ─────────
tradeWhenFlatOnly = input.bool(true, "Trade only when flat")
signalSide = input.string("Auto", "Signal side", options=["Auto", "Buy", "Sell"])

highlight2DOutside = input.bool(true, "Highlight 2D outside bar")
highlightColor = input.color(color.new(color.orange, 85), "Highlight color")

plotLabels = input.bool(true, "Plot labels")

// ───────── 2D outside-bar detection (confirmed bars only) ─────────
// Outside bar on 2D: high > prior high AND low < prior low
isOutside2D = request.security(syminfo.tickerid, "2D", high > high[1] and low < low[1], lookahead=barmerge.lookahead_off)

// Bullish/bearish for direction
bull2D = request.security(syminfo.tickerid, "2D", close >= open, lookahead=barmerge.lookahead_off)

// True only on the chart bar that closes the 2D candle
confirmed2D = request.security(syminfo.tickerid, "2D", barstate.isconfirmed, lookahead=barmerge.lookahead_off)

signal2D = confirmed2D and isOutside2D

// ───────── Highlight ─────────
// Highlight the chart bars that correspond to the closing bar of an outside 2D candle
bgcolor(highlight2DOutside and signal2D ? highlightColor : na)

// ───────── Entries (execute next candle open) ─────────
flat = strategy.position_size == 0
canEnter = not tradeWhenFlatOnly or flat

int dir = signalSide == "Buy" ? 1 : signalSide == "Sell" ? -1 : bull2D ? 1 : -1

if canEnter and signal2D
    if dir == 1
        strategy.entry("L", strategy.long)
    else
        strategy.entry("S", strategy.short)

// ───────── Labels ─────────
plotshape(plotLabels and signal2D and dir == 1, title="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny, text="BUY\n(2D outside)\nnext open")
plotshape(plotLabels and signal2D and dir == -1, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny, text="SELL\n(2D outside)\nnext open")
