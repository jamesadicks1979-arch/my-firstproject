//@version=5
indicator('AlphaTrend', shorttitle='AT', overlay=true, format=format.price, precision=2, max_lines_count=100)
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)
// Inputs
showWeekly = input.bool(false, "Show Weekly AlphaTrend")
showDaily = input.bool(false, "Show Daily AlphaTrend")
show2D = input.bool(true, "Show 2D AlphaTrend")
show4H = input.bool(false, "Show 4H AlphaTrend")

// --- Helper Functions ---
// Generic AlphaTrend calculation function to be used in security
// Only returns AlphaTrend and Signals, not pattern details (except for 2D special case)
f_calc_at_only() =>
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    [myAT, myAT[2]]

// --- Calculate & Plot Weekly ---
[atW, atW_prev2] = request.security(syminfo.tickerid, "W", f_calc_at_only())
// Trend color for fill
colorW_fill = atW > atW_prev2 ? #00E60F : atW < atW_prev2 ? #80000B : atW[1] > atW[3] ? #00E60F : #80000B
pW1 = plot(showWeekly ? atW : na, color=color.new(colorW_fill, 0), linewidth=2, title="AT Weekly")
pW2 = plot(showWeekly ? atW_prev2 : na, color=color.new(colorW_fill, 50), linewidth=2, title="AT Weekly Lag")
fill(pW1, pW2, color=showWeekly ? color.new(colorW_fill, 80) : na, title="Weekly Fill")

// --- Calculate & Plot Daily ---
[atD, atD_prev2] = request.security(syminfo.tickerid, "D", f_calc_at_only())
colorD_fill = atD > atD_prev2 ? #00E60F : atD < atD_prev2 ? #80000B : atD[1] > atD[3] ? #00E60F : #80000B
// Reverted to colorD_fill to match your snippet exactly
pD1 = plot(showDaily ? atD : na, color=color.new(colorD_fill, 0), linewidth=2, title="AT Daily")
pD2 = plot(showDaily ? atD_prev2 : na, color=color.new(colorD_fill, 50), linewidth=2, title="AT Daily Lag")
fill(pD1, pD2, color=showDaily ? color.new(colorD_fill, 80) : na, title="Daily Fill")

// --- Calculate & Plot 4H ---
[at4H, at4H_prev2] = request.security(syminfo.tickerid, "240", f_calc_at_only())
color4H_fill = at4H > at4H_prev2 ? #00E60F : at4H < at4H_prev2 ? #80000B : at4H[1] > at4H[3] ? #00E60F : #80000B
p4H1 = plot(show4H ? at4H : na, color=color.new(color4H_fill, 0), linewidth=2, title="AT 4H")
p4H2 = plot(show4H ? at4H_prev2 : na, color=color.new(color4H_fill, 50), linewidth=2, title="AT 4H Lag")
fill(p4H1, p4H2, color=show4H ? color.new(color4H_fill, 80) : na, title="4H Fill")

// --- Calculate Everything on 2D Timeframe (With Patterns) ---
// We define a wrapper function to call inside request.security for 2D
f_calc_2d_full() =>
    // AlphaTrend Calculation
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    // Outside Bar Logic
    isOut = high > high[1] and low < low[1]
    isBull = isOut and close > open
    isBear = isOut and close < open
    
    [myAT, myAT[2], isBull, isBear, high, low, open, close]

// Fetch data from 2D
[at2d, at2d_prev2, bull2d, bear2d, h2d, l2d, o2d, c2d] = request.security(syminfo.tickerid, "2D", f_calc_2d_full())

// --- Plotting AlphaTrend (2D) ---
color1 = at2d > at2d_prev2 ? #00E60F : at2d < at2d_prev2 ? #80000B : at2d[1] > at2d[3] ? #00E60F : #80000B
k1 = plot(show2D ? at2d : na, color=color.new(color1, 0), linewidth=3, title="AT 2D")
k2 = plot(show2D ? at2d_prev2 : na, color=color.new(color1, 50), linewidth=3, title="AT 2D Lag")
fill(k1, k2, color=show2D ? color.new(color1, 80) : na, title="2D Fill")

// Signals based on 2D data
buySignalk = ta.crossover(at2d, at2d_prev2)
sellSignalk = ta.crossunder(at2d, at2d_prev2)
plotshape(show2D and buySignalk and showsignalsk, title='BUY 2D', text='BUY 2D', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0), offset=0)
plotshape(show2D and sellSignalk and showsignalsk, title='SELL 2D', text='SELL 2D', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0), offset=0)

// --- Outside Bar Detection on 2-Day Timeframe ---
plotshape(show2D and bull2d and ta.change(time("2D")), title="Bullish Outside Bar (2D)", location=location.belowbar, color=#00FFFF, style=shape.circle, size=size.small, text="Out\nBull\n(2D)", textcolor=#00FFFF, offset=1)
plotshape(show2D and bear2d and ta.change(time("2D")), title="Bearish Outside Bar (2D)", location=location.abovebar, color=#FF00FF, style=shape.circle, size=size.small, text="Out\nBear\n(2D)", textcolor=#FF00FF, offset=1)

// --- Fibonacci on Outside Bar (2D) ---
if show2D and (bull2d or bear2d)
    barRange = h2d - l2d
    isNew2DBar = ta.change(time("2D"))
    
    if isNew2DBar
        // Draw lines
        line.new(bar_index, l2d, bar_index + 1, l2d, color=color.new(#808080, 50))
        line.new(bar_index, h2d, bar_index + 1, h2d, color=color.new(#808080, 50))
        line.new(bar_index, l2d + barRange * 0.5, bar_index + 1, l2d + barRange * 0.5, color=color.new(#FFFF00, 0))
        line.new(bar_index, l2d + barRange * 0.618, bar_index + 1, l2d + barRange * 0.618, color=color.new(#0000FF, 50))
        line.new(bar_index, l2d + barRange * 0.382, bar_index + 1, l2d + barRange * 0.382, color=color.new(#0000FF, 50))

// --- Daily vs Weekly Crossover Signals & Fibs ---
dailyCrossOverWeekly = ta.crossover(atD, atW)
dailyCrossUnderWeekly = ta.crossunder(atD, atW)

plotshape(showDaily and showWeekly and dailyCrossOverWeekly, title='Bull Cross', text='Bull\nCross', location=location.belowbar, style=shape.labelup, size=size.small, color=color.new(#00E60F, 0), textcolor=color.white)
plotshape(showDaily and showWeekly and dailyCrossUnderWeekly, title='Bear Cross', text='Bear\nCross', location=location.abovebar, style=shape.labeldown, size=size.small, color=color.new(#80000B, 0), textcolor=color.white)

// Logic for dynamic Fibs based on Cross
var float trackLow = na
var float trackHigh = na
var float anchorPrice = na
var float extremePrice = na
var int crossIndex = na
var line fibLine50 = na
var line fibLine618 = na

// Update Tracking for "Before Cross" (The Setup)
if atD < atW
    // Bearish Phase: Track Lowest Low
    trackLow := na(trackLow) ? low : math.min(trackLow, low)
    trackHigh := na // Reset Bull High tracker
else if atD > atW
    // Bullish Phase: Track Highest High
    trackHigh := na(trackHigh) ? high : math.max(trackHigh, high)
    trackLow := na // Reset Bear Low tracker

// Detect Crosses and Draw Initial Lines
if dailyCrossOverWeekly
    // Start Bull Leg
    // Anchor is the Low of the previous Bear phase
    anchorPrice := trackLow
    extremePrice := high // Start with current bar high
    crossIndex := bar_index
    
    // Create new lines (We DO NOT delete old lines, so they persist for history)
    fibLine50 := line.new(bar_index, close, bar_index, close, color=color.new(#00E60F, 0), style=line.style_solid, width=2)
    fibLine618 := line.new(bar_index, close, bar_index, close, color=color.new(#00E60F, 0), style=line.style_dashed, width=2)

if dailyCrossUnderWeekly
    // Start Bear Leg
    // Anchor is the High of the previous Bull phase
    anchorPrice := trackHigh
    extremePrice := low // Start with current bar low
    crossIndex := bar_index
    
    // Create new lines
    fibLine50 := line.new(bar_index, close, bar_index, close, color=color.new(#FF0000, 0), style=line.style_solid, width=2)
    fibLine618 := line.new(bar_index, close, bar_index, close, color=color.new(#FF0000, 0), style=line.style_dashed, width=2)

// Update Lines if inside a trend
// We check if fibLine50 is not na, which implies a line has been created
if not na(anchorPrice) and not na(fibLine50)
    // Bull Trend (Active)
    if atD > atW
        // Update Extreme High
        extremePrice := math.max(extremePrice, high)
        range_val = extremePrice - anchorPrice
        lev50 = anchorPrice + range_val * 0.5
        lev618 = anchorPrice + range_val * 0.618
        
        // Extend line to current bar + 5
        line.set_xy1(fibLine50, crossIndex, lev50)
        line.set_xy2(fibLine50, bar_index + 5, lev50)
        line.set_xy1(fibLine618, crossIndex, lev618)
        line.set_xy2(fibLine618, bar_index + 5, lev618)
        
    // Bear Trend (Active)
    else if atD < atW
        // Update Extreme Low
        extremePrice := math.min(extremePrice, low)
        range_val = anchorPrice - extremePrice
        lev50 = anchorPrice - range_val * 0.5
        lev618 = anchorPrice - range_val * 0.618
        
        line.set_xy1(fibLine50, crossIndex, lev50)
        line.set_xy2(fibLine50, bar_index + 5, lev50)
        line.set_xy1(fibLine618, crossIndex, lev618)
        line.set_xy2(fibLine618, bar_index + 5, lev618)
