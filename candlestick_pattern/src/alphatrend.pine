//@version=5
indicator('AlphaTrend', shorttitle='AT', overlay=true, format=format.price, precision=2)
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)

// Inputs
showWeekly = input.bool(true, "Show Weekly AlphaTrend")
showDaily = input.bool(true, "Show Daily AlphaTrend")
show2D = input.bool(false, "Show 2D AlphaTrend")
show4H = input.bool(false, "Show 4H AlphaTrend")

// --- Helper Functions ---
// Generic AlphaTrend calculation function to be used in security
// Only returns AlphaTrend and Signals, not pattern details (except for 2D special case)
f_calc_at_only() =>
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    [myAT, myAT[2]]

// --- Helper Functions ---
// Determine AlphaTrend Color
// Blue (#0000FF) if Flat (at == at[1])
// Green (#00E60F) if Bullish
// Red (#80000B) if Bearish
f_at_color(_at, _at_prev2, _at_1, _at_3) =>
    _at == _at_1 ? #0000FF : (_at > _at_prev2 ? #00E60F : _at < _at_prev2 ? #80000B : _at_1 > _at_3 ? #00E60F : #80000B)

// --- Calculate & Plot Weekly ---
[atW, atW_prev2] = request.security(syminfo.tickerid, "W", f_calc_at_only())
// Trend color for fill (Green/Red)
fillColorW = atW > atW_prev2 ? #00E60F : atW < atW_prev2 ? #80000B : atW[1] > atW[3] ? #00E60F : #80000B
// Line Color (Blue/Green/Red)
lineColorW = f_at_color(atW, atW_prev2, atW[1], atW[3])

pW1 = plot(showWeekly ? atW : na, color=color.new(lineColorW, 0), linewidth=2, title="AT Weekly")
pW2 = plot(showWeekly ? atW_prev2 : na, color=color.new(lineColorW, 50), linewidth=2, title="AT Weekly Lag")
fill(pW1, pW2, color=showWeekly ? color.new(fillColorW, 80) : na, title="Weekly Fill")

// --- Calculate & Plot Daily ---
[atD, atD_prev2] = request.security(syminfo.tickerid, "D", f_calc_at_only())

// Daily Color Override Logic (Requested: Green if Daily > Weekly, Red if Daily < Weekly, Blue if Flat)
lineColorD = atD == atD[1] ? #0000FF : (atD > atW ? #00E60F : #80000B)
// Fill Color (Green/Red based on trend only)
fillColorD = atD > atD_prev2 ? #00E60F : atD < atD_prev2 ? #80000B : atD[1] > atD[3] ? #00E60F : #80000B

pD1 = plot(showDaily ? atD : na, color=color.new(lineColorD, 0), linewidth=2, title="AT Daily")
pD2 = plot(showDaily ? atD_prev2 : na, color=color.new(lineColorD, 50), linewidth=2, title="AT Daily Lag")
fill(pD1, pD2, color=showDaily ? color.new(fillColorD, 80) : na, title="Daily Fill")

// --- Daily vs Weekly Fill (Cloud) ---
// Green when Daily > Weekly, Red when Daily < Weekly
fill(pD1, pW1, color=showDaily and showWeekly ? (atD > atW ? color.new(color.green, 85) : color.new(color.red, 85)) : na, title="Daily-Weekly Cloud")

// --- Calculate & Plot 4H ---
[at4H, at4H_prev2] = request.security(syminfo.tickerid, "240", f_calc_at_only())
fillColor4H = at4H > at4H_prev2 ? #00E60F : at4H < at4H_prev2 ? #80000B : at4H[1] > at4H[3] ? #00E60F : #80000B
lineColor4H = f_at_color(at4H, at4H_prev2, at4H[1], at4H[3])

p4H1 = plot(show4H ? at4H : na, color=color.new(lineColor4H, 0), linewidth=2, title="AT 4H")
p4H2 = plot(show4H ? at4H_prev2 : na, color=color.new(lineColor4H, 50), linewidth=2, title="AT 4H Lag")
fill(p4H1, p4H2, color=show4H ? color.new(fillColor4H, 80) : na, title="4H Fill")

// --- Weekly + Daily Confluence Signal ---
// Green = #00E60F, Red = #80000B
// We check the color variables derived from the logic
// Logic:
// BUY Signal: Both Weekly & Daily are Green AND Daily AlphaTrend > Weekly AlphaTrend
// SELL Signal: Both Weekly & Daily are Red AND Daily AlphaTrend < Weekly AlphaTrend

isBullW = fillColorW == #00E60F
isBullD = fillColorD == #00E60F
isBearW = fillColorW == #80000B
isBearD = fillColorD == #80000B

// Check relationship between Daily and Weekly values
dailyAboveWeekly = atD > atW
dailyBelowWeekly = atD < atW

confluenceBuy = isBullW and isBullD and dailyAboveWeekly
confluenceSell = isBearW and isBearD and dailyBelowWeekly

// Trigger only on new occurrence
triggerConfBuy = confluenceBuy and not confluenceBuy[1]
triggerConfSell = confluenceSell and not confluenceSell[1]

plotshape(triggerConfBuy, title="Weekly+Daily Buy", text="BUY", location=location.belowbar, color=color.green, style=shape.labelup, textcolor=color.white, size=size.small)
plotshape(triggerConfSell, title="Weekly+Daily Sell", text="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, textcolor=color.white, size=size.small)

alertcondition(triggerConfBuy, title='Weekly+Daily Buy Confluence', message='Weekly and Daily AlphaTrends are both Bullish and Daily > Weekly!')
alertcondition(triggerConfSell, title='Weekly+Daily Sell Confluence', message='Weekly and Daily AlphaTrends are both Bearish and Daily < Weekly!')

// --- Calculate Everything on 2D Timeframe (With Patterns) ---
// Note: We keep this function if we ever want to re-enable 2D patterns
f_calc_2d_full() =>
    // AlphaTrend Calculation
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    // Outside Bar Logic
    isOut = high > high[1] and low < low[1]
    isBull = isOut and close > open
    isBear = isOut and close < open
    
    [myAT, myAT[2], isBull, isBear, high, low, open, close]

// --- Calculate & Plot 2D (Optional) ---
[at2d, at2d_prev2] = request.security(syminfo.tickerid, "2D", f_calc_at_only())
fillColor2D = at2d > at2d_prev2 ? #00E60F : at2d < at2d_prev2 ? #80000B : at2d[1] > at2d[3] ? #00E60F : #80000B
lineColor2D = f_at_color(at2d, at2d_prev2, at2d[1], at2d[3])

p2D1 = plot(show2D ? at2d : na, color=color.new(lineColor2D, 0), linewidth=2, title="AT 2D")
p2D2 = plot(show2D ? at2d_prev2 : na, color=color.new(lineColor2D, 50), linewidth=2, title="AT 2D Lag")
fill(p2D1, p2D2, color=show2D ? color.new(fillColor2D, 80) : na, title="2D Fill")
