//@version=5
indicator('AlphaTrend', shorttitle='AT', overlay=true, format=format.price, precision=2)
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)

// Inputs
showWeekly = input.bool(false, "Show Weekly AlphaTrend")
showDaily = input.bool(false, "Show Daily AlphaTrend")
show2D = input.bool(true, "Show 2D AlphaTrend")
show4H = input.bool(false, "Show 4H AlphaTrend")

// --- Helper Functions ---
// Generic AlphaTrend calculation function to be used in security
// Only returns AlphaTrend and Signals, not pattern details (except for 2D special case)
f_calc_at_only() =>
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    [myAT, myAT[2]]

// --- Helper Functions ---
// Determine AlphaTrend Color
// Blue (#0000FF) if Flat (at == at[1])
// Green (#00E60F) if Bullish
// Red (#80000B) if Bearish
f_at_color(_at, _at_prev2, _at_1, _at_3) =>
    _at == _at_1 ? #0000FF : (_at > _at_prev2 ? #00E60F : _at < _at_prev2 ? #80000B : _at_1 > _at_3 ? #00E60F : #80000B)

// --- Calculate & Plot Weekly ---
[atW, atW_prev2] = request.security(syminfo.tickerid, "W", f_calc_at_only())
// Trend color for fill (Green/Red)
fillColorW = atW > atW_prev2 ? #00E60F : atW < atW_prev2 ? #80000B : atW[1] > atW[3] ? #00E60F : #80000B
// Line Color (Blue/Green/Red)
lineColorW = f_at_color(atW, atW_prev2, atW[1], atW[3])

pW1 = plot(showWeekly ? atW : na, color=color.new(lineColorW, 0), linewidth=2, title="AT Weekly")
pW2 = plot(showWeekly ? atW_prev2 : na, color=color.new(lineColorW, 50), linewidth=2, title="AT Weekly Lag")
fill(pW1, pW2, color=showWeekly ? color.new(fillColorW, 80) : na, title="Weekly Fill")

// --- Calculate & Plot Daily ---
[atD, atD_prev2] = request.security(syminfo.tickerid, "D", f_calc_at_only())

// Daily Color Override Logic (Requested: Green if Daily > Weekly, Red if Daily < Weekly, Blue if Flat)
lineColorD = atD == atD[1] ? #0000FF : (atD > atW ? #00E60F : #80000B)
// Fill Color (Green/Red based on trend only)
fillColorD = atD > atD_prev2 ? #00E60F : atD < atD_prev2 ? #80000B : atD[1] > atD[3] ? #00E60F : #80000B

pD1 = plot(showDaily ? atD : na, color=color.new(lineColorD, 0), linewidth=2, title="AT Daily")
pD2 = plot(showDaily ? atD_prev2 : na, color=color.new(lineColorD, 50), linewidth=2, title="AT Daily Lag")
fill(pD1, pD2, color=showDaily ? color.new(fillColorD, 80) : na, title="Daily Fill")

// --- Daily vs Weekly Fill (Cloud) ---
// Green when Daily > Weekly, Red when Daily < Weekly
fill(pD1, pW1, color=showDaily and showWeekly ? (atD > atW ? color.new(color.green, 85) : color.new(color.red, 85)) : na, title="Daily-Weekly Cloud")

// --- Calculate & Plot 4H ---
[at4H, at4H_prev2] = request.security(syminfo.tickerid, "240", f_calc_at_only())
fillColor4H = at4H > at4H_prev2 ? #00E60F : at4H < at4H_prev2 ? #80000B : at4H[1] > at4H[3] ? #00E60F : #80000B
lineColor4H = f_at_color(at4H, at4H_prev2, at4H[1], at4H[3])

p4H1 = plot(show4H ? at4H : na, color=color.new(lineColor4H, 0), linewidth=2, title="AT 4H")
p4H2 = plot(show4H ? at4H_prev2 : na, color=color.new(lineColor4H, 50), linewidth=2, title="AT 4H Lag")
fill(p4H1, p4H2, color=show4H ? color.new(fillColor4H, 80) : na, title="4H Fill")

// --- Weekly + Daily Confluence Signal ---
// Green = #00E60F, Red = #80000B
// We check the color variables derived from the logic
isBullW = fillColorW == #00E60F
isBullD = fillColorD == #00E60F
isBearW = fillColorW == #80000B
isBearD = fillColorD == #80000B

confluenceBuy = isBullW and isBullD
confluenceSell = isBearW and isBearD

// Trigger only on new occurrence
triggerConfBuy = confluenceBuy and not confluenceBuy[1]
triggerConfSell = confluenceSell and not confluenceSell[1]

plotshape(triggerConfBuy, title="Weekly+Daily Buy", text="BUY\n(W+D)", location=location.belowbar, color=color.green, style=shape.labelup, textcolor=color.white, size=size.small)
plotshape(triggerConfSell, title="Weekly+Daily Sell", text="SELL\n(W+D)", location=location.abovebar, color=color.red, style=shape.labeldown, textcolor=color.white, size=size.small)

alertcondition(triggerConfBuy, title='Weekly+Daily Buy Confluence', message='Weekly and Daily AlphaTrends are both Bullish!')
alertcondition(triggerConfSell, title='Weekly+Daily Sell Confluence', message='Weekly and Daily AlphaTrends are both Bearish!')

// --- Calculate Everything on 2D Timeframe (With Patterns) ---
// We define a wrapper function to call inside request.security for 2D
f_calc_2d_full() =>
    // AlphaTrend Calculation
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    // Outside Bar Logic
    isOut = high > high[1] and low < low[1]
    isBull = isOut and close > open
    isBear = isOut and close < open
    
    [myAT, myAT[2], isBull, isBear, high, low, open, close]

// Fetch data from 2D
[at2d, at2d_prev2, bull2d, bear2d, h2d, l2d, o2d, c2d] = request.security(syminfo.tickerid, "2D", f_calc_2d_full())

// --- Plotting AlphaTrend (2D) ---
lineColor2D = f_at_color(at2d, at2d_prev2, at2d[1], at2d[3])
fillColor2D = at2d > at2d_prev2 ? #00E60F : at2d < at2d_prev2 ? #80000B : at2d[1] > at2d[3] ? #00E60F : #80000B

k1 = plot(show2D ? at2d : na, color=color.new(lineColor2D, 0), linewidth=3, title="AT 2D")
k2 = plot(show2D ? at2d_prev2 : na, color=color.new(lineColor2D, 50), linewidth=3, title="AT 2D Lag")
fill(k1, k2, color=show2D ? color.new(fillColor2D, 80) : na, title="2D Fill")

// Signals based on 2D data
buySignalk = ta.crossover(at2d, at2d_prev2)
sellSignalk = ta.crossunder(at2d, at2d_prev2)

plotshape(show2D and buySignalk and showsignalsk, title='BUY 2D', text='BUY 2D', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0), offset=0)
plotshape(show2D and sellSignalk and showsignalsk, title='SELL 2D', text='SELL 2D', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0), offset=0)

// --- Outside Bar Detection on 2-Day Timeframe ---
// Logic is already fetched in bull2d / bear2d

// Plot Shapes for 2D Pattern
// We use `ta.change(time("2D"))` to ensure we only plot the shape once at the beginning of the 2D bar logic
// Since bull2d is true for the whole duration of the 2D bar, we qualify it with `ta.change(time("2D"))`
plotshape(show2D and bull2d and ta.change(time("2D")), title="Bullish Outside Bar (2D)", location=location.belowbar, color=#00FFFF, style=shape.circle, size=size.small, text="Out\nBull\n(2D)", textcolor=#00FFFF, offset=1)
plotshape(show2D and bear2d and ta.change(time("2D")), title="Bearish Outside Bar (2D)", location=location.abovebar, color=#FF00FF, style=shape.circle, size=size.small, text="Out\nBear\n(2D)", textcolor=#FF00FF, offset=1)

// --- Fibonacci on Outside Bar (2D) ---
if show2D and (bull2d or bear2d)
    barRange = h2d - l2d
    isNew2DBar = ta.change(time("2D"))
    
    if isNew2DBar
        // Draw lines
        line.new(bar_index, l2d, bar_index + 1, l2d, color=color.new(#808080, 50))
        line.new(bar_index, h2d, bar_index + 1, h2d, color=color.new(#808080, 50))
        line.new(bar_index, l2d + barRange * 0.5, bar_index + 1, l2d + barRange * 0.5, color=color.new(#FFFF00, 0))
        line.new(bar_index, l2d + barRange * 0.618, bar_index + 1, l2d + barRange * 0.618, color=color.new(#0000FF, 50))
        line.new(bar_index, l2d + barRange * 0.382, bar_index + 1, l2d + barRange * 0.382, color=color.new(#0000FF, 50))

alertcondition(buySignalk, title='Potential BUY Alarm', message='BUY SIGNAL (2D)!')
alertcondition(sellSignalk, title='Potential SELL Alarm', message='SELL SIGNAL (2D)!')
alertcondition(bull2d, title='Bullish Outside Bar (2D)', message='Bullish Outside Bar Detected on 2D Timeframe!')
alertcondition(bear2d, title='Bearish Outside Bar (2D)', message='Bearish Outside Bar Detected on 2D Timeframe!')
