//@version=5
strategy('AlphaTrend 2D Strategy', overlay=true, format=format.price, precision=2)

// Inputs
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
sl_mult = input.float(0.8, 'Stop Loss Multiplier (x Candle Range)', step=0.1)
tp_mult = input.float(3.0, 'Take Profit Multiplier (x Stop Distance)', step=0.1)

src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)

// Function to calculate AlphaTrend logic
calcAlphaTrend(_src, _close, _low, _high, _hlc3, _coeff, _AP, _novolumedata) =>
    _atr = ta.sma(ta.tr, _AP)
    _upT = _low - _atr * _coeff
    _downT = _high + _atr * _coeff
    
    _rsi = ta.rsi(_src, _AP)
    _mfi = ta.mfi(_hlc3, _AP)
    
    _alphaTrend = 0.0
    _alphaTrend := (_novolumedata ? _rsi >= 50 : _mfi >= 50) ? (_upT < nz(_alphaTrend[1]) ? nz(_alphaTrend[1]) : _upT) : (_downT > nz(_alphaTrend[1]) ? nz(_alphaTrend[1]) : _downT)
    
    [_alphaTrend, _alphaTrend[2]]

// --- Calculate Everything on 2D Timeframe ---
f_calc() =>
    // AlphaTrend Calculation
    myATR = ta.sma(ta.tr, AP)
    myUpT = low - myATR * coeff
    myDownT = high + myATR * coeff
    
    myRsi = ta.rsi(src, AP)
    myMfi = ta.mfi(hlc3, AP)
    
    myAT = 0.0
    myAT := (novolumedata ? myRsi >= 50 : myMfi >= 50) ? (myUpT < nz(myAT[1]) ? nz(myAT[1]) : myUpT) : (myDownT > nz(myAT[1]) ? nz(myAT[1]) : myDownT)
    
    // Outside Bar Logic
    isOut = high > high[1] and low < low[1]
    isBull = isOut and close > open
    isBear = isOut and close < open
    
    [myAT, myAT[2], isBull, isBear, high, low, open, close]

// Fetch data from 2D
[at2d, at2d_prev2, bull2d, bear2d, h2d, l2d, o2d, c2d] = request.security(syminfo.tickerid, "2D", f_calc())

// --- Plotting AlphaTrend (2D) ---
color1 = at2d > at2d_prev2 ? #00E60F : at2d < at2d_prev2 ? #80000B : at2d[1] > at2d[3] ? #00E60F : #80000B
k1 = plot(at2d, color=color.new(#0022FC, 0), linewidth=3)
k2 = plot(at2d_prev2, color=color.new(#FC0400, 0), linewidth=3)
fill(k1, k2, color=color1)

// Signals based on 2D data
buySignalk = ta.crossover(at2d, at2d_prev2)
sellSignalk = ta.crossunder(at2d, at2d_prev2)

plotshape(buySignalk and showsignalsk, title='BUY', text='BUY', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0), offset=0)
plotshape(sellSignalk and showsignalsk, title='SELL', text='SELL', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0), offset=0)

// --- Strategy Execution ---
// Condition: Buy Signal
if buySignalk
    // Trigger Candle is the 2D candle
    // Range of Trigger Candle
    triggerRange = h2d - l2d
    
    // Stop Loss Distance: 80% of Trigger Candle Range
    slDist = triggerRange * sl_mult
    
    // Take Profit Distance: 3 times the Stop Distance
    tpDist = slDist * tp_mult
    
    // Entry price will be the Open of the next bar (handled by strategy.entry)
    // We base SL/TP from the Close of the trigger bar (or estimated Entry)
    // Using Close of 2D bar as reference point for SL/TP placement
    longStop = c2d - slDist
    longTP = c2d + tpDist
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=longStop, limit=longTP)

// Condition: Sell Signal
if sellSignalk
    triggerRange = h2d - l2d
    slDist = triggerRange * sl_mult
    tpDist = slDist * tp_mult
    
    shortStop = c2d + slDist
    shortTP = c2d - tpDist
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=shortStop, limit=shortTP)

// --- Outside Bar Detection on 2-Day Timeframe (Visuals) ---
plotshape(bull2d and ta.change(time("2D")), title="Bullish Outside Bar (2D)", location=location.belowbar, color=#00FFFF, style=shape.circle, size=size.small, text="Out\nBull\n(2D)", textcolor=#00FFFF, offset=1)
plotshape(bear2d and ta.change(time("2D")), title="Bearish Outside Bar (2D)", location=location.abovebar, color=#FF00FF, style=shape.circle, size=size.small, text="Out\nBear\n(2D)", textcolor=#FF00FF, offset=1)

// --- Fibonacci on Outside Bar (2D) ---
if bull2d or bear2d
    barRange = h2d - l2d
    isNew2DBar = ta.change(time("2D"))
    
    if isNew2DBar
        // Draw lines
        line.new(bar_index, l2d, bar_index + 1, l2d, color=color.new(#808080, 50))
        line.new(bar_index, h2d, bar_index + 1, h2d, color=color.new(#808080, 50))
        line.new(bar_index, l2d + barRange * 0.5, bar_index + 1, l2d + barRange * 0.5, color=color.new(#FFFF00, 0))
        line.new(bar_index, l2d + barRange * 0.618, bar_index + 1, l2d + barRange * 0.618, color=color.new(#0000FF, 50))
        line.new(bar_index, l2d + barRange * 0.382, bar_index + 1, l2d + barRange * 0.382, color=color.new(#0000FF, 50))
