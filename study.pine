//@version=5
indicator("Triple SMA with Dashboard", overlay=true)

// Input parameters
len1 = input.int(5, "Length SMA 1", minval=1)
len2 = input.int(9, "Length SMA 2", minval=1)
len3 = input.int(21, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Calculation
sma1 = ta.sma(src, len1)
sma2 = ta.sma(src, len2)
sma3 = ta.sma(src, len3)

// Plotting
p1 = plot(sma1, "SMA 5", color=color.green, linewidth=2)
p2 = plot(sma2, "SMA 9", color=color.blue, linewidth=2)
p3 = plot(sma3, "SMA 21", color=color.fuchsia, linewidth=4) // Changed to Fuchsia and thicker

// Debugging / Dashboard
var table dashboard = table.new(position.top_right, 2, 4, border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "Indicator", bgcolor=color.gray, text_color=color.white)
    table.cell(dashboard, 1, 0, "Value", bgcolor=color.gray, text_color=color.white)
    
    table.cell(dashboard, 0, 1, "SMA 5", bgcolor=color.green, text_color=color.white)
    table.cell(dashboard, 1, 1, str.tostring(sma1, "#.##"), bgcolor=color.new(color.green, 90))
    
    table.cell(dashboard, 0, 2, "SMA 9", bgcolor=color.blue, text_color=color.white)
    table.cell(dashboard, 1, 2, str.tostring(sma2, "#.##"), bgcolor=color.new(color.blue, 90))
    
    // Explicit check for SMA 21
    table.cell(dashboard, 0, 3, "SMA 21", bgcolor=color.fuchsia, text_color=color.white)
    val3 = na(sma3) ? "NaN" : str.tostring(sma3, "#.##")
    table.cell(dashboard, 1, 3, val3, bgcolor=color.new(color.fuchsia, 90))
