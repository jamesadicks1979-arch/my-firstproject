//@version=5
indicator("Triple SMA with Session", overlay=true)

// Input parameters
len1 = input.int(50, "Length SMA 1", minval=1)
len2 = input.int(21, "Length SMA 2", minval=1)
len3 = input.int(9, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Session Inputs
sessionTime = input.session("1330-1630", "Session Time")
sessionZone = input.string("Europe/London", "Timezone")

// Calculation
sma1 = ta.sma(src, len1)
sma2 = ta.sma(src, len2)
sma3 = ta.sma(src, len3)

// Check if current bar is in session
inSession = time(timeframe.period, sessionTime, sessionZone)

// Plotting SMAs
plot(sma1, "SMA 50", color=color.green, linewidth=2)
plot(sma2, "SMA 21", color=color.blue, linewidth=2)
plot(sma3, "SMA 9", color=color.red, linewidth=3)

// Highlight Session Background
bgcolor(inSession ? color.new(color.yellow, 90) : na, title="Session Background")

// Labels on the right
var label l1 = na
var label l2 = na
var label l3 = na

if barstate.islast
    label.delete(l1)
    label.delete(l2)
    label.delete(l3)
    
    // Position labels slightly to the right of the last bar
    l1 := label.new(bar_index + 3, sma1, "SMA 50: " + str.tostring(sma1, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    l2 := label.new(bar_index + 3, sma2, "SMA 21: " + str.tostring(sma2, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    l3 := label.new(bar_index + 3, sma3, "SMA 9: " + str.tostring(sma3, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
