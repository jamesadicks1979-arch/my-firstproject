//@version=5
indicator("Triple SMA with Session & Fibs", overlay=true)

// Input parameters
len1 = input.int(50, "Length SMA 1", minval=1)
len2 = input.int(21, "Length SMA 2", minval=1)
len3 = input.int(9, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Session Inputs
// We need to monitor 13:30 to 14:30 specifically for the High/Low calculation.
monitoringTime = input.session("1330-1430", "High/Low Monitoring Period")
triggerTimeStr = input.session("1430-1431", "Trigger Time") 
sessionZone = input.string("Europe/London", "Timezone")

// Calculation
sma50 = ta.sma(src, len1) // SMA 50 (Green)
sma21 = ta.sma(src, len2) // SMA 21 (Blue)
sma9 = ta.sma(src, len3)  // SMA 9 (Red)

// Plotting SMAs
plot(sma50, "SMA 50", color=color.green, linewidth=2)
plot(sma21, "SMA 21", color=color.blue, linewidth=2)
plot(sma9, "SMA 9", color=color.red, linewidth=3)

// Logic for High/Low tracking between 13:30 and 14:30
// "time" returns the open time of the bar. 
// We use "not na" to check if the current bar falls within the session.
inMonitoringWindow = not na(time(timeframe.period, monitoringTime, sessionZone))

// Variables to store the High and Low since 13:30
var float periodHigh = na
var float periodLow = na

// If we are starting the window (or inside it), we track.
// Reset at the start of the window
if inMonitoringWindow and not inMonitoringWindow[1]
    periodHigh := high
    periodLow := low
else if inMonitoringWindow
    periodHigh := math.max(periodHigh, high)
    periodLow := math.min(periodLow, low)

// Trigger Condition Logic at 14:30
// We check if the current bar *starts* at 14:30.
isTriggerBar = not na(time(timeframe.period, "1430-1430", sessionZone))

// We only draw if the condition is met once per day at that specific time.
if isTriggerBar
    // Condition: 9 is below 21 AND 9 is below 50
    if (sma9 < sma21 and sma9 < sma50)
        // Calculate Range
        rangeVal = periodHigh - periodLow
        
        // Calculate Levels
        fib50 = periodLow + (rangeVal * 0.50)
        fib61 = periodLow + (rangeVal * 0.618)
        fib80 = periodLow + (rangeVal * 0.80)
        
        // Draw Lines extending to the right
        // We set extend=extend.right so they go into the future
        line.new(bar_index, fib50, bar_index + 1, fib50, color=color.gray, width=1, style=line.style_dashed, extend=extend.right)
        line.new(bar_index, fib61, bar_index + 1, fib61, color=color.gray, width=1, style=line.style_dashed, extend=extend.right)
        line.new(bar_index, fib80, bar_index + 1, fib80, color=color.red, width=2, extend=extend.right) // Red line for 80%

        // Optional: Add labels to identify the lines
        label.new(bar_index, fib50, "50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
        label.new(bar_index, fib80, "80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)


// Highlight the monitoring period background (13:30 - 14:30)
bgcolor(inMonitoringWindow ? color.new(color.yellow, 90) : na, title="Monitoring Period")

// Labels on the right (Persistent SMA labels)
var label l1 = na
var label l2 = na
var label l3 = na

if barstate.islast
    label.delete(l1)
    label.delete(l2)
    label.delete(l3)
    
    l1 := label.new(bar_index + 3, sma50, "SMA 50: " + str.tostring(sma50, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    l2 := label.new(bar_index + 3, sma21, "SMA 21: " + str.tostring(sma21, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    l3 := label.new(bar_index + 3, sma9, "SMA 9: " + str.tostring(sma9, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
