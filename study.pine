//@version=5
indicator("Triple SMA with Session & Fibs (Simple Dynamic)", overlay=true)

// Input parameters
len1 = input.int(50, "Length SMA 1", minval=1)
len2 = input.int(21, "Length SMA 2", minval=1)
len3 = input.int(9, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Session Inputs
monitoringTime = input.session("1230-1430", "High/Low Monitoring Period") 
fibLookPeriod = input.session("1430-1630", "Fib Trigger Period")
sessionZone = input.string("Europe/London", "Timezone")

// Calculation
sma50 = ta.sma(src, len1)
sma21 = ta.sma(src, len2)
sma9 = ta.sma(src, len3)

// Plotting SMAs
plot(sma50, "SMA 50", color=color.green, linewidth=2)
plot(sma21, "SMA 21", color=color.blue, linewidth=2)
plot(sma9, "SMA 9", color=color.red, linewidth=3)

// ==========================================
// LOGIC
// ==========================================

// 1. Monitor High/Low (12:30 - 14:30)
inMonitoringWindow = not na(time(timeframe.period, monitoringTime, sessionZone))

var float monitorHigh = na
var float monitorLow = na

if inMonitoringWindow
    if not inMonitoringWindow[1]
        monitorHigh := high
        monitorLow := low
    else
        monitorHigh := math.max(monitorHigh, high)
        monitorLow := math.min(monitorLow, low)

// 2. Trigger & Dynamic Updates (14:30 - 16:30)
inFibWindow = not na(time(timeframe.period, fibLookPeriod, sessionZone))

// State Variables
var int tradeMode = 0 
var bool isLocked = false 

// Active Anchors
var float activeHigh = na
var float activeLow = na

// Drawing References
var line l50 = na
var line l61 = na
var line l80 = na
var box bZone = na
var label lb50 = na
var label lb80 = na

// RESET at start of new day/monitoring cycle
if inMonitoringWindow and not inMonitoringWindow[1]
    tradeMode := 0
    isLocked := false
    activeHigh := na
    activeLow := na
    l50 := na
    l61 := na
    l80 := na
    bZone := na
    lb50 := na
    lb80 := na

// PROCESSING inside Trigger Window
if inFibWindow
    // 1. Initial Trigger (Enter Mode)
    if tradeMode == 0
        // Sell Trigger: MAs bearish
        if (sma9 < sma21 and sma9 < sma50)
            tradeMode := 1 // Sell Mode
            activeHigh := monitorHigh // Fixed High
            activeLow := monitorLow   // Dynamic Low
            
            // Draw Sell Fibs
            rangeVal = activeHigh - activeLow
            lev50 = activeLow + (rangeVal * 0.50)
            lev61 = activeLow + (rangeVal * 0.618)
            lev80 = activeLow + (rangeVal * 0.80)
            
            bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.red, 85))
            l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
            l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
            l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
            lb50 := label.new(bar_index, lev50, "Sell 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
            lb80 := label.new(bar_index, lev80, "Sell 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)

        // Buy Trigger: Market closes above SMA 50
        else if (close > sma50)
            tradeMode := 2 // Buy Mode
            activeLow := monitorLow   // Fixed Low
            activeHigh := monitorHigh // Dynamic High
            
            // Draw Buy Fibs
            rangeVal = activeHigh - activeLow
            lev50 = activeHigh - (rangeVal * 0.50)
            lev61 = activeHigh - (rangeVal * 0.618)
            lev80 = activeHigh - (rangeVal * 0.80)
            
            bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.green, 85))
            l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
            l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
            l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
            lb50 := label.new(bar_index, lev50, "Buy 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
            lb80 := label.new(bar_index, lev80, "Buy 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
    // 2. Update Logic (if not locked)
    else if not isLocked
        // Normal Sell Mode (Mode 1)
        if tradeMode == 1
            if low < activeLow
                activeLow := low
                line.delete(l50)
                line.delete(l61)
                line.delete(l80)
                box.delete(bZone)
                label.delete(lb50)
                label.delete(lb80)
                
                rangeVal = activeHigh - activeLow
                lev50 = activeLow + (rangeVal * 0.50)
                lev61 = activeLow + (rangeVal * 0.618)
                lev80 = activeLow + (rangeVal * 0.80)
                
                bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.red, 85))
                l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
                l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
                l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
                lb50 := label.new(bar_index, lev50, "Sell 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
                lb80 := label.new(bar_index, lev80, "Sell 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
            rangeVal = activeHigh - activeLow
            fib50Limit = activeLow + (rangeVal * 0.50)
            if high >= fib50Limit
                isLocked := true
        
        // Normal Buy Mode (Mode 2)
        else if tradeMode == 2
            if high > activeHigh
                activeHigh := high
                line.delete(l50)
                line.delete(l61)
                line.delete(l80)
                box.delete(bZone)
                label.delete(lb50)
                label.delete(lb80)
                
                rangeVal = activeHigh - activeLow
                lev50 = activeHigh - (rangeVal * 0.50)
                lev61 = activeHigh - (rangeVal * 0.618)
                lev80 = activeHigh - (rangeVal * 0.80)
                
                bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.green, 85))
                l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
                l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
                l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
                lb50 := label.new(bar_index, lev50, "Buy 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
                lb80 := label.new(bar_index, lev80, "Buy 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
            rangeVal = activeHigh - activeLow
            fib50Limit = activeHigh - (rangeVal * 0.50)
            if low <= fib50Limit
                isLocked := true

// Backgrounds
bgcolor(inMonitoringWindow ? color.new(color.yellow, 90) : na, title="Monitoring")

// Labels on right (SMA)
var label l_sma50 = na
var label l_sma21 = na
var label l_sma9 = na

if barstate.islast
    label.delete(l_sma50)
    label.delete(l_sma21)
    label.delete(l_sma9)
    // Shifted labels further to the right using "bar_index + 5"
    l_sma50 := label.new(bar_index + 5, sma50, "SMA 50: " + str.tostring(sma50, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    l_sma21 := label.new(bar_index + 5, sma21, "SMA 21: " + str.tostring(sma21, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    l_sma9 := label.new(bar_index + 5, sma9, "SMA 9: " + str.tostring(sma9, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
