//@version=5
indicator("Triple SMA with Session & Fibs (Simple Dynamic) + MTPC DKO", overlay=true, max_lines_count=500, max_boxes_count=500)

// ==========================================
// 1. TRIPLE SMA & SESSION FIBS
// ==========================================

// Input parameters
len1 = input.int(50, "Length SMA 1", minval=1, group="Triple SMA")
len2 = input.int(21, "Length SMA 2", minval=1, group="Triple SMA")
len3 = input.int(9, "Length SMA 3", minval=1, group="Triple SMA")
src = input.source(close, "Source", group="Triple SMA")

// Session Inputs
monitoringTime = input.session("1230-1430", "High/Low Monitoring Period", group="Intraday Session") 
fibLookPeriod = input.session("1430-1630", "Fib Trigger Period", group="Intraday Session")
sessionZone = input.string("Europe/London", "Timezone", group="Intraday Session")

// Calculation
sma50 = ta.sma(src, len1)
sma21 = ta.sma(src, len2)
sma9 = ta.sma(src, len3)

// Plotting SMAs
plot(sma50, "SMA 50", color=color.green, linewidth=2)
plot(sma21, "SMA 21", color=color.blue, linewidth=2)
plot(sma9, "SMA 9", color=color.red, linewidth=3)

// ------------------------------------------
// INTRADAY FIB LOGIC
// ------------------------------------------

// 1. Monitor High/Low (12:30 - 14:30)
inMonitoringWindow = not na(time(timeframe.period, monitoringTime, sessionZone))

var float monitorHigh = na
var float monitorLow = na

if inMonitoringWindow
    if not inMonitoringWindow[1]
        monitorHigh := high
        monitorLow := low
    else
        monitorHigh := math.max(monitorHigh, high)
        monitorLow := math.min(monitorLow, low)

// 2. Trigger & Dynamic Updates (14:30 - 16:30)
inFibWindow = not na(time(timeframe.period, fibLookPeriod, sessionZone))

// State Variables
var int tradeMode = 0 
var bool isLocked = false 

// Active Anchors
var float activeHigh = na
var float activeLow = na

// Drawing References
var line l50 = na
var line l61 = na
var line l80 = na
var box bZone = na
var label lb50 = na
var label lb80 = na

// RESET at start of new day/monitoring cycle
if inMonitoringWindow and not inMonitoringWindow[1]
    tradeMode := 0
    isLocked := false
    activeHigh := na
    activeLow := na
    l50 := na
    l61 := na
    l80 := na
    bZone := na
    lb50 := na
    lb80 := na

// PROCESSING inside Trigger Window
if inFibWindow
    // 1. Initial Trigger (Enter Mode)
    if tradeMode == 0
        // Sell Trigger: MAs bearish
        if (sma9 < sma21 and sma9 < sma50)
            tradeMode := 1 // Sell Mode
            activeHigh := monitorHigh // Fixed High
            activeLow := monitorLow   // Dynamic Low
            
            // Draw Sell Fibs
            rangeVal = activeHigh - activeLow
            lev50 = activeLow + (rangeVal * 0.50)
            lev61 = activeLow + (rangeVal * 0.618)
            lev80 = activeLow + (rangeVal * 0.80)
            
            bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.red, 85))
            l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
            l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
            l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
            lb50 := label.new(bar_index, lev50, "Sell 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
            lb80 := label.new(bar_index, lev80, "Sell 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)

        // Buy Trigger: Market closes above SMA 50
        else if (close > sma50)
            tradeMode := 2 // Buy Mode
            activeLow := monitorLow   // Fixed Low
            activeHigh := monitorHigh // Dynamic High
            
            // Draw Buy Fibs
            rangeVal = activeHigh - activeLow
            lev50 = activeHigh - (rangeVal * 0.50)
            lev61 = activeHigh - (rangeVal * 0.618)
            lev80 = activeHigh - (rangeVal * 0.80)
            
            bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.green, 85))
            l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
            l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
            l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
            lb50 := label.new(bar_index, lev50, "Buy 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
            lb80 := label.new(bar_index, lev80, "Buy 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
    // 2. Update Logic (if not locked)
    else if not isLocked
        // Normal Sell Mode (Mode 1)
        if tradeMode == 1
            if low < activeLow
                activeLow := low
                line.delete(l50)
                line.delete(l61)
                line.delete(l80)
                box.delete(bZone)
                label.delete(lb50)
                label.delete(lb80)
                
                rangeVal = activeHigh - activeLow
                lev50 = activeLow + (rangeVal * 0.50)
                lev61 = activeLow + (rangeVal * 0.618)
                lev80 = activeLow + (rangeVal * 0.80)
                
                bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.red, 85))
                l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
                l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
                l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
                lb50 := label.new(bar_index, lev50, "Sell 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
                lb80 := label.new(bar_index, lev80, "Sell 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
            rangeVal = activeHigh - activeLow
            fib50Limit = activeLow + (rangeVal * 0.50)
            if high >= fib50Limit
                isLocked := true
        
        // Normal Buy Mode (Mode 2)
        else if tradeMode == 2
            if high > activeHigh
                activeHigh := high
                line.delete(l50)
                line.delete(l61)
                line.delete(l80)
                box.delete(bZone)
                label.delete(lb50)
                label.delete(lb80)
                
                rangeVal = activeHigh - activeLow
                lev50 = activeHigh - (rangeVal * 0.50)
                lev61 = activeHigh - (rangeVal * 0.618)
                lev80 = activeHigh - (rangeVal * 0.80)
                
                bZone := box.new(bar_index, lev50, bar_index + 20, lev61, border_width=0, bgcolor=color.new(color.green, 85))
                l50 := line.new(bar_index, lev50, bar_index + 20, lev50, color=color.gray, width=1, style=line.style_dashed)
                l61 := line.new(bar_index, lev61, bar_index + 20, lev61, color=color.gray, width=1, style=line.style_dashed)
                l80 := line.new(bar_index, lev80, bar_index + 20, lev80, color=color.red, width=2)
                lb50 := label.new(bar_index, lev50, "Buy 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
                lb80 := label.new(bar_index, lev80, "Buy 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
            
            rangeVal = activeHigh - activeLow
            fib50Limit = activeHigh - (rangeVal * 0.50)
            if low <= fib50Limit
                isLocked := true

// Backgrounds
bgcolor(inMonitoringWindow ? color.new(color.yellow, 90) : na, title="Monitoring")

// Labels on right (SMA)
var label l_sma50 = na
var label l_sma21 = na
var label l_sma9 = na

if barstate.islast
    label.delete(l_sma50)
    label.delete(l_sma21)
    label.delete(l_sma9)
    // Shifted labels further to the right using "bar_index + 18"
    l_sma50 := label.new(bar_index + 18, sma50, "SMA 50: " + str.tostring(sma50, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    l_sma21 := label.new(bar_index + 18, sma21, "SMA 21: " + str.tostring(sma21, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    l_sma9 := label.new(bar_index + 18, sma9, "SMA 9: " + str.tostring(sma9, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)

// ==========================================
// 2. MTPC DKO LOGIC (Updated with Backgrounds & ATR)
// ==========================================

//──────────────── INPUTS ────────────────
autoTF  = input.bool(true, "Auto Timeframe", group="MTPC DKO")
tfInput = input.timeframe("1D", "Manual Timeframe", group="MTPC DKO")

fibColor50  = input.color(color.blue, "50% Fib", group="MTPC DKO")
fibColor618 = input.color(color.orange, "61.8% Fib", group="MTPC DKO")
pocketColor = input.color(color.new(color.purple, 80), "Fib Pocket", group="MTPC DKO")

// New Inputs for Backgrounds & ATR
atrLen = input.int(14, "ATR Length", group="MTPC DKO")
atrMult = input.float(1.0, "ATR Multiplier for Target", group="MTPC DKO")
atrColor = input.color(color.black, "ATR Target Line Color", group="MTPC DKO")

bgBullColor = input.color(color.new(color.green, 90), "Bullish Prev BG", group="MTPC DKO")
bgBearColor = input.color(color.new(color.red, 90), "Bearish Prev BG", group="MTPC DKO")

//──────────────── TIMEFRAME SELECTION ────────────────
string tf = autoTF ? "1D" : tfInput

//──────────────── NEW MP DETECTION ────────────────
bool newMP = timeframe.change(tf)

//──────────────── MP RANGE TRACKING ────────────────
var float mpHigh = na
var float mpLow  = na
var float mpOpen = na // Need Open to determine color
var float mpClose = na

var float prevHigh = na
var float prevLow  = na
var float prevOpen = na
var float prevClose = na

var int mpStart = na

// ATR Calculation (on Higher Timeframe)
// We need to fetch ATR from the higher timeframe
htfATR = request.security(syminfo.tickerid, tf, ta.atr(atrLen))

// Update Logic
if newMP
    prevHigh := mpHigh
    prevLow  := mpLow
    prevOpen := mpOpen
    prevClose := mpClose // The last known close of the prev session

    mpHigh := high
    mpLow  := low
    mpOpen := open
    mpClose := close
    mpStart := bar_index
else
    mpHigh := na(mpHigh) ? high : math.max(mpHigh, high)
    mpLow  := na(mpLow)  ? low  : math.min(mpLow, low)
    if na(mpOpen)
        mpOpen := open
    mpClose := close // Continuously update close to be the 'current' close of the TF

//──────────────── BACKGROUND COLOR ────────────────
// "add a background colour if last period was green and red if it was bearish"
// Determine trend of previous MP
bool prevBullish = not na(prevClose) and (prevClose > prevOpen)
bool prevBearish = not na(prevClose) and (prevClose < prevOpen)

// Draw background for the CURRENT period based on PREVIOUS period status
bgcolor(prevBullish ? bgBullColor : prevBearish ? bgBearColor : na, title="MTPC Background")

//──────────────── FIB OBJECTS ────────────────
var line fib50  = na
var line fib618 = na
var box  fibBox = na
var line atrLine = na // ATR Target Object

//──────────────── DRAW FIBS ACROSS CURRENT MP ────────────────
bool canDraw = not na(prevHigh) and not na(prevLow)

if newMP
    fib50  := na
    fib618 := na
    fibBox := na
    atrLine := na

if canDraw
    float f50  = prevLow + (prevHigh - prevLow) * 0.50
    float f618 = prevLow + (prevHigh - prevLow) * 0.618

    // ATR Target Logic
    // "black line for an atr target line which is added on to the low of that time period"
    // Assuming adding to the Previous Low? Or Current Low?
    // Usually target is projected from the range.
    // "added on to the low of that time period" -> If bearish period, maybe subtract?
    // If user says "added on to the low", literally Low + ATR.
    // But if it was a bullish period (Green), maybe we target High + ATR?
    // Let's stick to "added on to the low" as requested literally first.
    // Wait, if it's a target, maybe it's Low - ATR (for shorts)? Or Low + ATR (reversion)?
    // Re-reading: "atr target line which is added on to the low of that time period"
    // I will do: Target = prevLow + htfATR.
    // If you meant "subtracted from high" or directional, let me know.
    
    // Actually, usually:
    // If Prev Period was Green (Bullish), we might expect continuation? Or reversion?
    // Let's implement literally: Line at (Prev Low + ATR).
    
    float targetLevel = prevLow + (htfATR * atrMult) 
    
    int left  = mpStart
    int right = bar_index

    if na(fib50)
        fib50 := line.new(left, f50, right, f50, color=fibColor50, width=2)
        fib618 := line.new(left, f618, right, f618, color=fibColor618, width=2)
        // Fixed: Box.new on one line
        fibBox := box.new(left, math.max(f50, f618), right, math.min(f50, f618), border_color = na, bgcolor = pocketColor)
        
        // Draw ATR Line
        atrLine := line.new(left, targetLevel, right, targetLevel, color=atrColor, width=2, style=line.style_solid)
    else
        line.set_x2(fib50, right)
        line.set_x2(fib618, right)
        box.set_right(fibBox, right)
        line.set_x2(atrLine, right)

//──────────────── OPTIONAL MP BOX ────────────────
var box mpBox = na

if newMP
    // Fixed: Box.new on one line
    mpBox := box.new(mpStart, mpHigh, bar_index, mpLow, border_color = color.gray, bgcolor = na) // removed bg fill to not clash with main bg
else if not na(mpBox)
    box.set_right(mpBox, bar_index)
    box.set_top(mpBox, mpHigh)
    box.set_bottom(mpBox, mpLow)
