//@version=5
indicator("Triple SMA with Session & Fibs", overlay=true)

// Input parameters
len1 = input.int(50, "Length SMA 1", minval=1)
len2 = input.int(21, "Length SMA 2", minval=1)
len3 = input.int(9, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Session Inputs
monitoringTime = input.session("1330-1430", "High/Low Monitoring Period")
fibLookPeriod = input.session("1430-1630", "Fib Trigger Period")
sessionZone = input.string("Europe/London", "Timezone")

// Calculation
sma50 = ta.sma(src, len1) // SMA 50 (Green)
sma21 = ta.sma(src, len2) // SMA 21 (Blue)
sma9 = ta.sma(src, len3)  // SMA 9 (Red)

// Plotting SMAs
plot(sma50, "SMA 50", color=color.green, linewidth=2)
plot(sma21, "SMA 21", color=color.blue, linewidth=2)
plot(sma9, "SMA 9", color=color.red, linewidth=3)

// Logic for High/Low tracking between 13:30 and 14:30
inMonitoringWindow = not na(time(timeframe.period, monitoringTime, sessionZone))

// Variables to store the High and Low since 13:30
var float periodHigh = na
var float periodLow = na

// Reset or Track High/Low
if inMonitoringWindow
    if not inMonitoringWindow[1] // Start of period
        periodHigh := high
        periodLow := low
    else
        periodHigh := math.max(periodHigh, high)
        periodLow := math.min(periodLow, low)

// Fib Look Logic between 14:30 and 16:30
inFibWindow = not na(time(timeframe.period, fibLookPeriod, sessionZone))

// We only want to draw the fibs ONCE per session.
var bool fibsDrawn = false

// Reset flag at start of new monitoring period (next day)
if inMonitoringWindow and not inMonitoringWindow[1]
    fibsDrawn := false

// Check Logic inside the 14:30 - 16:30 window
if inFibWindow and not fibsDrawn
    // Condition 1: MAs above market (Sell Scenario)
    if (sma9 < sma21 and sma9 < sma50)
        rangeVal = periodHigh - periodLow
        
        // Sell Fibs (Retracement goes UP from Low)
        // 50% = Low + 0.50 * Range
        // 61.8% = Low + 0.618 * Range (Higher than 50%)
        // 80% = Low + 0.80 * Range (Highest)
        
        sellFib50 = periodLow + (rangeVal * 0.50)
        sellFib61 = periodLow + (rangeVal * 0.618)
        sellFib80 = periodLow + (rangeVal * 0.80) 
        
        // Fill box between 50% and 61.8%
        box.new(bar_index, sellFib50, bar_index + 20, sellFib61, border_width=0, bgcolor=color.new(color.red, 85))
        
        line.new(bar_index, sellFib50, bar_index + 20, sellFib50, color=color.gray, width=1, style=line.style_dashed)
        line.new(bar_index, sellFib61, bar_index + 20, sellFib61, color=color.gray, width=1, style=line.style_dashed)
        line.new(bar_index, sellFib80, bar_index + 20, sellFib80, color=color.red, width=2)
        
        label.new(bar_index, sellFib50, "Sell 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
        label.new(bar_index, sellFib80, "Sell 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
        
        fibsDrawn := true

    // Condition 2: Market closes above 50 SMA (Buy Scenario)
    else if (close > sma50)
        rangeVal = periodHigh - periodLow
        
        // Buy Fibs (Retracement goes DOWN from High)
        // 50% = High - 0.50 * Range
        // 61.8% = High - 0.618 * Range
        // 80% = High - 0.80 * Range (Lowest)
        
        buyFib50 = periodHigh - (rangeVal * 0.50)
        buyFib61 = periodHigh - (rangeVal * 0.618)
        buyFib80 = periodHigh - (rangeVal * 0.80)

        // Fill box between 50% and 61.8%
        box.new(bar_index, buyFib50, bar_index + 20, buyFib61, border_width=0, bgcolor=color.new(color.green, 85))
        
        line.new(bar_index, buyFib50, bar_index + 20, buyFib50, color=color.gray, width=1, style=line.style_dashed)
        line.new(bar_index, buyFib61, bar_index + 20, buyFib61, color=color.gray, width=1, style=line.style_dashed)
        line.new(bar_index, buyFib80, bar_index + 20, buyFib80, color=color.red, width=2)
        
        label.new(bar_index, buyFib50, "Buy 50%", style=label.style_label_left, color=color.gray, size=size.tiny, textcolor=color.white)
        label.new(bar_index, buyFib80, "Buy 80%", style=label.style_label_left, color=color.red, size=size.tiny, textcolor=color.white)
        
        fibsDrawn := true

// Highlight the monitoring period background (13:30 - 14:30)
bgcolor(inMonitoringWindow ? color.new(color.yellow, 90) : na, title="Monitoring Period")

// Labels on the right
var label l1 = na
var label l2 = na
var label l3 = na

if barstate.islast
    label.delete(l1)
    label.delete(l2)
    label.delete(l3)
    
    l1 := label.new(bar_index + 3, sma50, "SMA 50: " + str.tostring(sma50, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    l2 := label.new(bar_index + 3, sma21, "SMA 21: " + str.tostring(sma21, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    l3 := label.new(bar_index + 3, sma9, "SMA 9: " + str.tostring(sma9, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
