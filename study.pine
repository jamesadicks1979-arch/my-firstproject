//@version=5
indicator("Triple SMA", overlay=true)

// Input parameters
len1 = input.int(5, "Length SMA 1", minval=1)
len2 = input.int(9, "Length SMA 2", minval=1)
len3 = input.int(21, "Length SMA 3", minval=1)
src = input.source(close, "Source")

// Calculation
sma1 = ta.sma(src, len1)
sma2 = ta.sma(src, len2)
sma3 = ta.sma(src, len3)

// Plotting - Using distinct colors and ensuring visibility
// Note: If you don't see the line, ensure your chart has enough historical bars (at least 21).
plot(sma1, "SMA 5", color=color.green, linewidth=2)
plot(sma2, "SMA 9", color=color.blue, linewidth=2)
plot(sma3, "SMA 21", color=color.red, linewidth=3) // Made slightly thicker

// Labels on the right side for better visibility
if barstate.islast
    label.new(bar_index, sma1, "SMA 5: " + str.tostring(sma1, "#.##"), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    label.new(bar_index, sma2, "SMA 9: " + str.tostring(sma2, "#.##"), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    label.new(bar_index, sma3, "SMA 21: " + str.tostring(sma3, "#.##"), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)

