//@version=5
indicator("AlphaTrend + 4H Prev Candle Fib (50/61.8) + Post-Buy Fib Touch", shorttitle="AT+4HFib", overlay=true, format=format.price, precision=2, timeframe="")

//-------------------- AlphaTrend (original logic) --------------------
coeff = input.float(1, "Multiplier", step=0.1)
AP = input.int(14, "Common Period")
ATR = ta.sma(ta.tr, AP)
src = input.source(close, "Source")
showsignalsk = input.bool(true, title="Show Signals?")
novolumedata = input.bool(false, title="Change calculation (no volume data)?")

upT = low - ATR * coeff
downT = high + ATR * coeff

AlphaTrend = 0.0
AlphaTrend := (novolumedata ? ta.rsi(src, AP) >= 50 : ta.mfi(hlc3, AP) >= 50) ?
     (upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : upT) :
     (downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : downT)

color1 = AlphaTrend > AlphaTrend[2] ? #00E60F :
     AlphaTrend < AlphaTrend[2] ? #80000B :
     AlphaTrend[1] > AlphaTrend[3] ? #00E60F : #80000B

k1 = plot(AlphaTrend, color=color.new(#0022FC, 0), linewidth=3)
k2 = plot(AlphaTrend[2], color=color.new(#FC0400, 0), linewidth=3)
fill(k1, k2, color=color1)

buySignalk = ta.crossover(AlphaTrend, AlphaTrend[2])
sellSignalk = ta.crossunder(AlphaTrend, AlphaTrend[2])

K1 = ta.barssince(buySignalk)
K2 = ta.barssince(sellSignalk)
O1 = ta.barssince(buySignalk[1])
O2 = ta.barssince(sellSignalk[1])

alphaBuy = buySignalk and O1 > K2
alphaSell = sellSignalk and O2 > K1

plotshape(buySignalk and showsignalsk and O1 > K2 ? AlphaTrend[2] * 0.9999 : na,
     title="BUY",
     text="BUY",
     location=location.absolute,
     style=shape.labelup,
     size=size.tiny,
     color=color.new(#0022FC, 0),
     textcolor=color.new(color.white, 0))

plotshape(sellSignalk and showsignalsk and O2 > K1 ? AlphaTrend[2] * 1.0001 : na,
     title="SELL",
     text="SELL",
     location=location.absolute,
     style=shape.labeldown,
     size=size.tiny,
     color=color.new(color.maroon, 0),
     textcolor=color.new(color.white, 0))

alertcondition(alphaBuy, title="Potential BUY Alarm", message="BUY SIGNAL!")
alertcondition(alphaSell, title="Potential SELL Alarm", message="SELL SIGNAL!")

alertcondition(buySignalk[1] and O1[1] > K2, title="Confirmed BUY Alarm", message="BUY SIGNAL APPROVED!")
alertcondition(sellSignalk[1] and O2[1] > K1, title="Confirmed SELL Alarm", message="SELL SIGNAL APPROVED!")

alertcondition(ta.cross(close, AlphaTrend), title="Price Cross Alert", message="Price - AlphaTrend Crossing!")
alertcondition(ta.crossover(low, AlphaTrend), title="Candle CrossOver Alarm", message="LAST BAR is ABOVE ALPHATREND")
alertcondition(ta.crossunder(high, AlphaTrend), title="Candle CrossUnder Alarm", message="LAST BAR is BELOW ALPHATREND!")

alertcondition(ta.cross(close[1], AlphaTrend[1]), title="Price Cross Alert After Bar Close", message="Price - AlphaTrend Crossing!")
alertcondition(ta.crossover(low[1], AlphaTrend[1]), title="Candle CrossOver Alarm After Bar Close", message="LAST BAR is ABOVE ALPHATREND!")
alertcondition(ta.crossunder(high[1], AlphaTrend[1]), title="Candle CrossUnder Alarm After Bar Close", message="LAST BAR is BELOW ALPHATREND!")

//-------------------- 4H previous candle fib dots (fixed timeframe = 4H) --------------------
showFibDots = input.bool(true, "Show 4H Fib Dots (Prev Candle 50%/61.8%)")
htf = "240" // 4H

htfHighPrev = request.security(syminfo.tickerid, htf, high[1], barmerge.gaps_off, barmerge.lookahead_off)
htfLowPrev = request.security(syminfo.tickerid, htf, low[1], barmerge.gaps_off, barmerge.lookahead_off)

fib50 = htfLowPrev + (htfHighPrev - htfLowPrev) * 0.50
fib618 = htfLowPrev + (htfHighPrev - htfLowPrev) * 0.618

var float lastFib50 = na
var float lastFib618 = na

htfTime = request.security(syminfo.tickerid, htf, time, barmerge.gaps_off, barmerge.lookahead_off)
newHTF = ta.change(htfTime)

if newHTF
    lastFib50 := fib50
    lastFib618 := fib618

plot(showFibDots and not na(lastFib50) ? lastFib50 : na,
     title="4H Prev Candle 50% (Dot)",
     style=plot.style_circles,
     color=color.blue,
     linewidth=3)

plot(showFibDots and not na(lastFib618) ? lastFib618 : na,
     title="4H Prev Candle 61.8% (Dot)",
     style=plot.style_circles,
     color=color.red,
     linewidth=3)

hit50 = not na(lastFib50) and (low <= lastFib50 and high >= lastFib50)
hit618 = not na(lastFib618) and (low <= lastFib618 and high >= lastFib618)

alertcondition(hit50, title="Hit 4H 50% Fib", message="Price touched 4H previous candle 50% retracement")
alertcondition(hit618, title="Hit 4H 61.8% Fib", message="Price touched 4H previous candle 61.8% retracement")

//-------------------- After AlphaTrend BUY: watch next 6 candles for 50% touch --------------------
postBuyBars = input.int(6, "Bars to watch after AlphaTrend BUY", minval=1)
showPostBuyFibLabel = input.bool(true, "Show Post-Buy Fib50 Touch Label")

var bool postBuyActive = false
var int postBuyCount = 0
var bool postBuyHitFired = false
var float fib50AtBuy = na

if alphaBuy
    postBuyActive := true
    postBuyCount := 0
    postBuyHitFired := false
    fib50AtBuy := lastFib50

postBuyHit50 = false
if postBuyActive
    // Only start checking from the candle AFTER the AlphaTrend buy candle.
    inWindow = postBuyCount >= 1 and postBuyCount <= postBuyBars
    postBuyHit50 := inWindow and not postBuyHitFired and not na(fib50AtBuy) and (low <= fib50AtBuy and high >= fib50AtBuy)
    if postBuyHit50
        postBuyHitFired := true
    postBuyCount += 1
    if postBuyCount > postBuyBars
        postBuyActive := false

plotshape(showPostBuyFibLabel and postBuyHit50,
     title="Post-Buy Fib50 Touch BUY",
     text="FIB BUY",
     style=shape.labelup,
     location=location.belowbar,
     size=size.tiny,
     color=color.new(color.lime, 0),
     textcolor=color.new(color.black, 0))

alertcondition(postBuyHit50, title="Post-Buy Fib50 Touch", message="After AlphaTrend BUY: price touched 4H prev candle 50% within next 6 bars")

