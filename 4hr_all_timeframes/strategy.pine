//@version=5
strategy("4hr All Timeframes Strategy", overlay=true)

// Input parameters
sma_length = input.int(200, "SMA Length", minval=1)

// Timeframe Inputs
tf_weekly = input.timeframe("1W", "Weekly Timeframe")
tf_daily  = input.timeframe("1D", "Daily Timeframe")
tf_8hr    = input.timeframe("480", "8 Hour Timeframe")
tf_4hr    = input.timeframe("240", "4 Hour Timeframe")
tf_2hr    = input.timeframe("120", "2 Hour Timeframe")
tf_1hr    = input.timeframe("60", "1 Hour Timeframe")

// Calculations
get_sma(tf, len) =>
    request.security(syminfo.tickerid, tf, ta.sma(close, len))

sma_weekly = get_sma(tf_weekly, sma_length)
sma_daily  = get_sma(tf_daily, sma_length)
sma_8hr    = get_sma(tf_8hr, sma_length)
sma_4hr    = get_sma(tf_4hr, sma_length)
sma_2hr    = get_sma(tf_2hr, sma_length)
sma_1hr    = get_sma(tf_1hr, sma_length)

// Plotting SMAs
plot(sma_weekly, title="Weekly 200 SMA", color=color.purple, linewidth=2)
plot(sma_daily,  title="Daily 200 SMA",  color=color.red,    linewidth=2)
plot(sma_8hr,    title="8hr 200 SMA",    color=color.orange, linewidth=2)
plot(sma_4hr,    title="4hr 200 SMA",    color=color.green,  linewidth=2)
plot(sma_2hr,    title="2hr 200 SMA",    color=color.blue,   linewidth=2)
plot(sma_1hr,    title="1hr 200 SMA",    color=color.yellow, linewidth=2)

// --- Fib Logic ---

// State Variables
var float fib_low = na
var float fib_high = na
var bool is_active = false

// Track Lowest Low continuously when NOT active (or rather, since the last reset)
var float potential_low = 10e10
if not is_active
    potential_low := math.min(potential_low, low)
    // If the trend is clearly bearish (1hr < 4hr), ensuring we track deep lows.
    // If 1hr > 4hr but just misaligned (1hr < 2hr), we might still be tracking?
    // User image: Low is from the deep dip before alignment.

// Condition: 1hr > 2hr AND 2hr > 4hr
bull_alignment = sma_1hr > sma_2hr and sma_2hr > sma_4hr

// Trigger: New Bull Alignment
// We check if we are not active, to latch onto the start.
if bull_alignment and not is_active
    is_active := true
    fib_low := potential_low
    fib_high := high
    
    // Mark the trigger point
    label.new(bar_index, high, "X", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

// Maintenance Condition: 1hr > 4hr
maintain_condition = sma_1hr > sma_4hr

// Lines
var line l_50 = na
var line l_618 = na
var line l_82 = na
three_months_ms = 1000 * 60 * 60 * 24 * 90

if is_active
    // Update High
    fib_high := math.max(fib_high, high)
    
    // Calculate Levels
    fib_range = fib_high - fib_low
    // Retracements from High
    level_50 = fib_high - (fib_range * 0.50)
    level_618 = fib_high - (fib_range * 0.618)
    level_82 = fib_high - (fib_range * 0.82)
    
    // Draw/Update Lines
    // We recreate lines or update them? 
    // If we update, we need to ensure they persist.
    // Creating new lines every bar is expensive and clutters history if not deleted.
    // Better to have one set of lines per active session.
    
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    
    // x1 at current time (horizontal line extending forward)
    // Or x1 at start of trend? User said "draw lines across". usually means horizontal across the chart.
    // I will set x1 back a bit or at current time.
    // Let's set x1 at current time and x2 forward.
    l_50 := line.new(time, level_50, time + three_months_ms, level_50, xloc=xloc.bar_time, color=color.red, width=2)
    l_618 := line.new(time, level_618, time + three_months_ms, level_618, xloc=xloc.bar_time, color=color.red, width=2)
    l_82 := line.new(time, level_82, time + three_months_ms, level_82, xloc=xloc.bar_time, color=color.red, width=2)
    
    // Check if broken
    if not maintain_condition
        is_active := false
        potential_low := low // Reset tracking for next cycle
        // Lines remain on chart at their last position

plot(close, title="Close Price", color=color.gray)
