//@version=5
indicator("4hr All Timeframes Analysis", overlay=true)

// Input parameters
sma_length = input.int(200, "SMA Length", minval=1)

// Timeframe Inputs
tf_weekly = input.timeframe("1W", "Weekly Timeframe")
tf_daily  = input.timeframe("1D", "Daily Timeframe")
tf_8hr    = input.timeframe("480", "8 Hour Timeframe")
tf_4hr    = input.timeframe("240", "4 Hour Timeframe")
tf_2hr    = input.timeframe("120", "2 Hour Timeframe")
tf_1hr    = input.timeframe("60", "1 Hour Timeframe")

// Calculations
get_sma(tf, len) =>
    request.security(syminfo.tickerid, tf, ta.sma(close, len))

sma_weekly = get_sma(tf_weekly, sma_length)
sma_daily  = get_sma(tf_daily, sma_length)
sma_8hr    = get_sma(tf_8hr, sma_length)
sma_4hr    = get_sma(tf_4hr, sma_length)
sma_2hr    = get_sma(tf_2hr, sma_length)
sma_1hr    = get_sma(tf_1hr, sma_length)

// Plotting SMAs
plot(sma_weekly, title="Weekly 200 SMA", color=color.purple, linewidth=2)
plot(sma_daily,  title="Daily 200 SMA",  color=color.red,    linewidth=2)
plot(sma_8hr,    title="8hr 200 SMA",    color=color.orange, linewidth=2)
plot(sma_4hr,    title="4hr 200 SMA",    color=color.green,  linewidth=2)
plot(sma_2hr,    title="2hr 200 SMA",    color=color.blue,   linewidth=2)
plot(sma_1hr,    title="1hr 200 SMA",    color=color.yellow, linewidth=2)

// --- Trend Filter ---
// Filter out signals if Price is below Daily SMA (Bearish)
// We use close > sma_daily as a simple filter for Bullish Trend.
trend_filter = close > sma_daily

// --- Crossover Markings ---
// We want the X to be exactly ON the cross point.
// Only show if in Bullish Daily Trend.

// 1. Cross when 1hr SMA crosses above 2hr SMA
if trend_filter and ta.crossover(sma_1hr, sma_2hr)
    label.new(bar_index, sma_1hr, text="X", color=color.white, textcolor=color.black, style=label.style_label_center, size=size.tiny, tooltip="1h > 2h (First)", yloc=yloc.price)

// 2. Cross when 2hr SMA crosses above 4hr SMA
if trend_filter and ta.crossover(sma_2hr, sma_4hr)
    label.new(bar_index, sma_2hr, text="X", color=color.white, textcolor=color.black, style=label.style_label_center, size=size.tiny, tooltip="2h > 4h (Second)", yloc=yloc.price)

// 3. Cross when 4hr SMA crosses above 8hr SMA
if trend_filter and ta.crossover(sma_4hr, sma_8hr)
    label.new(bar_index, sma_4hr, text="X", color=color.white, textcolor=color.black, style=label.style_label_center, size=size.tiny, tooltip="4h > 8h (Third)", yloc=yloc.price)


// --- Fib Logic ---
// "then after three look for low to high and work fibs"
// Implication: Fibs are triggered when ALL 3 crossovers have occurred.

// State Variables
var float fib_low = na
var float fib_high = na
var bool is_active = false
var float potential_low = 10e10

// Track Lowest Low continuously
// We reset this only if the entire structure breaks or on successful trigger usage.
// If the trend is bearish (1hr < 4hr or 1hr < 8hr), we definitely want to track new lows.
if close < sma_1hr
    potential_low := math.min(potential_low, low)

// Trigger Condition:
// 1. 1hr > 2hr
// 2. 2hr > 4hr
// 3. 4hr > 8hr
// ALL MUST BE TRUE. 
full_bull_alignment = sma_1hr > sma_2hr and sma_2hr > sma_4hr and sma_4hr > sma_8hr

// We activate if we hit full alignment AND we weren't active before.
// ADDED: trend_filter (Must be above Daily SMA to start looking for Long Fibs)
if trend_filter and full_bull_alignment and not is_active
    // Ensure we have a valid potential_low (not 10e10 initial value)
    if potential_low < 10e9
        is_active := true
        fib_low := potential_low
        fib_high := high
        potential_low := 10e10 // Reset for next cycle

// Maintenance:
// "keep this in as long as the 1hr sma is above the 4hr sma"
maintain_condition = sma_1hr > sma_4hr

// Lines
var line l_50 = na
var line l_618 = na
var line l_82 = na
three_weeks_ms = 1000 * 60 * 60 * 24 * 21

if is_active
    // Update High if alignment holds
    if maintain_condition
        fib_high := math.max(fib_high, high)
    else
        // Alignment broken. Setup is finished.
        is_active := false
    
    // Draw/Update Lines
    // While active, we update the lines. 
    // Once inactive, they stop updating (frozen at last calculation) but remain on chart.
    
    // Delete previous iteration of lines FOR THIS ACTIVE SETUP to simulate updating.
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    
    fib_range = fib_high - fib_low
    level_50 = fib_high - (fib_range * 0.50)
    level_618 = fib_high - (fib_range * 0.618)
    level_82 = fib_high - (fib_range * 0.82)
    
    // Create new lines extending 3 weeks from current time
    l_50 := line.new(bar_index, level_50, time + three_weeks_ms, level_50, xloc=xloc.bar_time, color=color.red, width=2)
    l_618 := line.new(bar_index, level_618, time + three_weeks_ms, level_618, xloc=xloc.bar_time, color=color.red, width=2)
    l_82 := line.new(bar_index, level_82, time + three_weeks_ms, level_82, xloc=xloc.bar_time, color=color.red, width=2)
    
    // Golden Pocket Fill (Between 50% and 61.8%)
    // Since lines are recreated, we fill between them.
    line.fill(l_50, l_618, color=color.new(color.red, 80))
