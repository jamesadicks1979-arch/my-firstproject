//@version=5
indicator("4hr All Timeframes Analysis", overlay=true)

// Input parameters
sma_length = input.int(200, "SMA Length", minval=1)

// Timeframe Inputs
tf_weekly = input.timeframe("1W", "Weekly Timeframe")
tf_daily  = input.timeframe("1D", "Daily Timeframe")
tf_8hr    = input.timeframe("480", "8 Hour Timeframe")
tf_4hr    = input.timeframe("240", "4 Hour Timeframe")
tf_2hr    = input.timeframe("120", "2 Hour Timeframe")
tf_1hr    = input.timeframe("60", "1 Hour Timeframe")

// Calculations
get_sma(tf, len) =>
    request.security(syminfo.tickerid, tf, ta.sma(close, len))

sma_weekly = get_sma(tf_weekly, sma_length)
sma_daily  = get_sma(tf_daily, sma_length)
sma_8hr    = get_sma(tf_8hr, sma_length)
sma_4hr    = get_sma(tf_4hr, sma_length)
sma_2hr    = get_sma(tf_2hr, sma_length)
sma_1hr    = get_sma(tf_1hr, sma_length)

// Plotting SMAs
plot(sma_weekly, title="Weekly 200 SMA", color=color.purple, linewidth=2)
plot(sma_daily,  title="Daily 200 SMA",  color=color.red,    linewidth=2)
plot(sma_8hr,    title="8hr 200 SMA",    color=color.orange, linewidth=2)
plot(sma_4hr,    title="4hr 200 SMA",    color=color.green,  linewidth=2)
plot(sma_2hr,    title="2hr 200 SMA",    color=color.blue,   linewidth=2)
plot(sma_1hr,    title="1hr 200 SMA",    color=color.yellow, linewidth=2)


// --- Crossover Markings ---
// 1. Cross when 1hr SMA crosses above 2hr SMA
if ta.crossover(sma_1hr, sma_2hr)
    label.new(bar_index, high, "X", color=color.white, textcolor=color.black, style=label.style_label_down, size=size.tiny, tooltip="1h > 2h")

// 2. Cross when 2hr SMA crosses above 4hr SMA
if ta.crossover(sma_2hr, sma_4hr)
    label.new(bar_index, high, "X", color=color.white, textcolor=color.black, style=label.style_label_down, size=size.tiny, tooltip="2h > 4h")

// 3. Cross when 4hr SMA crosses above 8hr SMA
if ta.crossover(sma_4hr, sma_8hr)
    label.new(bar_index, high, "X", color=color.white, textcolor=color.black, style=label.style_label_down, size=size.tiny, tooltip="4h > 8h")


// --- Fib Logic ---
// "set for long fibs is made find the low below the the 1 hr fib and look for the high and draw on the chart 50% and 61.8% and a 82% red line and keep these lines on the chart for 3 weeks"

// State Variables
var float fib_low = na
var float fib_high = na
var bool is_active = false
var float potential_low = 10e10

// Track Lowest Low continuously when not active or whenever price is below 1hr SMA
// If price is below 1hr SMA, that is a potential dip for a long setup
if close < sma_1hr
    potential_low := math.min(potential_low, low)
else
    // If we are above 1hr SMA, we keep the potential_low as the swing low
    // until we potentially trigger a new structure or reset.
    // If price crosses back down, we might want to continue tracking deeper lows.
    if ta.crossunder(close, sma_1hr)
        // Reset tracking logic? 
        // User says "find the low below the 1 hr fib". 
        // So potential_low is the minimum low recorded while close was < sma_1hr.
        potential_low := potential_low

// Trigger Condition:
// Not explicitly defined in the latest prompt other than "set for long fibs is made".
// Assuming the previous condition (1hr > 2hr > 4hr) or similar stacking implies "set is made".
// Or perhaps when all crosses have happened?
// Let's stick to the strongest confirmation: 1hr > 2hr AND 2hr > 4hr AND 4hr > 8hr ?
// Or revert to the previous "1hr > 2hr > 4hr".
// User mentioned: "find the low below the 1 hr fib".
// I will use the condition: 1hr > 2hr AND 2hr > 4hr to start tracking Highs and drawing Fibs.
bull_alignment = sma_1hr > sma_2hr and sma_2hr > sma_4hr

if bull_alignment and not is_active
    is_active := true
    fib_low := potential_low
    fib_high := high
    potential_low := 10e10 // Reset for next time

// Maintenance:
// "keep these lines on the chart for 3 weeks"
// If alignment breaks, we stop updating Highs but lines might stay?
// Or we just keep updating as long as alignment holds.
if is_active
    // Update High if alignment holds
    if sma_1hr > sma_4hr 
        fib_high := math.max(fib_high, high)
    else
        // Alignment broken.
        // Should we stop making new lines?
        is_active := false
    
    // Draw Lines
    // "keep these lines on the chart for 3 weeks"
    // I will use line.new every bar or update existing lines.
    // To leave trails of past setups, we should create NEW lines when the setup finishes (or updates).
    // But Pine Script deletes old lines after ~50-100 lines.
    // Best approach: Maintain one set of lines for the CURRENT active setup.
    // If the setup finishes (active becomes false), those lines persist at their last location.
    
    // Variables for lines need to be 'var' to persist across bars
    
var line l_50 = na
var line l_618 = na
var line l_82 = na
three_weeks_ms = 1000 * 60 * 60 * 24 * 21

if is_active
    // Delete old lines of CURRENT setup to update them
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    
    fib_range = fib_high - fib_low
    level_50 = fib_high - (fib_range * 0.50)
    level_618 = fib_high - (fib_range * 0.618)
    level_82 = fib_high - (fib_range * 0.82)
    
    l_50 := line.new(bar_index, level_50, time + three_weeks_ms, level_50, xloc=xloc.bar_time, color=color.red, width=2)
    l_618 := line.new(bar_index, level_618, time + three_weeks_ms, level_618, xloc=xloc.bar_time, color=color.red, width=2)
    l_82 := line.new(bar_index, level_82, time + three_weeks_ms, level_82, xloc=xloc.bar_time, color=color.red, width=2)

