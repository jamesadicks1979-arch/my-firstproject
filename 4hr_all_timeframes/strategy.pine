//@version=5
indicator('AlphaTrend', shorttitle='AT', overlay=true, format=format.price, precision=2, timeframe='')
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
ATR = ta.sma(ta.tr, AP)
src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)
upT = low - ATR * coeff
downT = high + ATR * coeff
AlphaTrend = 0.0
AlphaTrend := (novolumedata ? ta.rsi(src, AP) >= 50 : ta.mfi(hlc3, AP) >= 50) ? upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : upT : downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : downT

color1 = AlphaTrend > AlphaTrend[2] ? #00E60F : AlphaTrend < AlphaTrend[2] ? #80000B : AlphaTrend[1] > AlphaTrend[3] ? #00E60F : #80000B
k1 = plot(AlphaTrend, color=color.new(#0022FC, 0), linewidth=3)
k2 = plot(AlphaTrend[2], color=color.new(#FC0400, 0), linewidth=3)

fill(k1, k2, color=color1)

buySignalk = ta.crossover(AlphaTrend, AlphaTrend[2])
sellSignalk = ta.crossunder(AlphaTrend, AlphaTrend[2])


K1 = ta.barssince(buySignalk)
K2 = ta.barssince(sellSignalk)
O1 = ta.barssince(buySignalk[1])
O2 = ta.barssince(sellSignalk[1])

// Valid Buy/Sell Conditions based on Kivanc's Logic
validBuy = buySignalk and showsignalsk and O1 > K2
validSell = sellSignalk and showsignalsk and O2 > K1

plotshape(validBuy ? AlphaTrend[2] * 0.9999 : na, title='BUY', text='BUY', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0))

plotshape(validSell ? AlphaTrend[2] * 1.0001 : na, title='SELL', text='SELL', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0))


alertcondition(buySignalk and O1 > K2, title='Potential BUY Alarm', message='BUY SIGNAL!')
alertcondition(sellSignalk and O2 > K1, title='Potential SELL Alarm', message='SELL SIGNAL!')

alertcondition(buySignalk[1] and O1[1] > K2, title='Confirmed BUY Alarm', message='BUY SIGNAL APPROVED!')
alertcondition(sellSignalk[1] and O2[1] > K1, title='Confirmed SELL Alarm', message='SELL SIGNAL APPROVED!')



alertcondition(ta.cross(close, AlphaTrend), title='Price Cross Alert', message='Price - AlphaTrend Crossing!')
alertcondition(ta.crossover(low, AlphaTrend), title='Candle CrossOver Alarm', message='LAST BAR is ABOVE ALPHATREND')
alertcondition(ta.crossunder(high, AlphaTrend), title='Candle CrossUnder Alarm', message='LAST BAR is BELOW ALPHATREND!')

alertcondition(ta.cross(close[1], AlphaTrend[1]), title='Price Cross Alert After Bar Close', message='Price - AlphaTrend Crossing!')
alertcondition(ta.crossover(low[1], AlphaTrend[1]), title='Candle CrossOver Alarm After Bar Close', message='LAST BAR is ABOVE ALPHATREND!')
alertcondition(ta.crossunder(high[1], AlphaTrend[1]), title='Candle CrossUnder Alarm After Bar Close', message='LAST BAR is BELOW ALPHATREND!')

// --- CUSTOM FIBONACCI LOGIC ---

// State Variables
var bool isLong = false
var bool isShort = false
var float anchor_price = na // Low for Longs, High for Shorts
var float extreme_price = na // Highest High for Longs, Lowest Low for Shorts

// Lines & Labels
var line l_50 = na
var line l_618 = na
var line l_82 = na
var linefill lf_fill = na
var label trade_label = na
var label stop_label = na

// Reset Function
reset_fibs() =>
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    // label.delete(trade_label) // We might want to keep history? 
    // Usually markers should stay, but lines might clutter. 
    // User asked to "put lines on chart". 
    // I will delete OLD lines when a NEW signal comes to keep chart clean.
    na

// --- LONG LOGIC ---
if validBuy
    // New Buy Signal -> Start Fresh
    reset_fibs()
    isLong := true
    isShort := false
    anchor_price := low // Start from the Low of the Buy Signal candle (or slightly before? usually local low)
    // To find the "Trend Low", we often look back. 
    // But keeping it simple: Anchor at Signal Candle Low or recent Lowest Low.
    // Let's use the lowest low since the last Sell Signal?
    // K2 is bars since last Sell. 
    lowest_since_sell = ta.lowest(low, K2 > 0 ? K2 : 1)
    anchor_price := lowest_since_sell
    
    extreme_price := high // Reset high tracking

// Maintenance for Long
if isLong
    // Update Highest High
    extreme_price := math.max(extreme_price, high)
    
    // Calculate Levels (Retracement from High down to Low)
    // Fib 0% = High, Fib 100% = Low (Anchor)
    // 50% = High - 0.5 * Range
    range_val = extreme_price - anchor_price
    lev_50 = extreme_price - (range_val * 0.50)
    lev_618 = extreme_price - (range_val * 0.618)
    lev_82 = extreme_price - (range_val * 0.82)
    
    // Update Lines
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    
    l_50 := line.new(bar_index, lev_50, bar_index + 1, lev_50, extend=extend.right, color=color.green, width=1)
    l_618 := line.new(bar_index, lev_618, bar_index + 1, lev_618, extend=extend.right, color=color.green, width=1)
    l_82 := line.new(bar_index, lev_82, bar_index + 1, lev_82, extend=extend.right, color=color.red, width=2) // 82% is Stop zone
    
    lf_fill := linefill.new(l_50, l_618, color=color.new(color.green, 85))
    
    // "put long if it comes down to fib" (Touch 50-61.8 zone)
    // Check if Low touches the zone
    if low <= lev_50 and low >= lev_82 // Wide zone, or specifically 50-61.8?
        // Let's mark it once per bar if touching
        // To avoid spam, maybe only if it wasn't touching before?
        // Or just a label "LONG" when it enters.
        if high > lev_50 and low < lev_50 // Crossed into it
            label.new(bar_index, low, "LONG", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

    // "put stopped if goes through 82%"
    if low < lev_82
        label.new(bar_index, lev_82, "STOPPED", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)
        isLong := false // Stop logic -> End setup?
        reset_fibs()

// --- SHORT LOGIC ---
if validSell
    // New Sell Signal
    reset_fibs()
    isLong := false
    isShort := true
    // Anchor High = Highest High since last Buy
    highest_since_buy = ta.highest(high, K1 > 0 ? K1 : 1)
    anchor_price := highest_since_buy
    
    extreme_price := low // Reset Low tracking

// Maintenance for Short
if isShort
    // Update Lowest Low
    extreme_price := math.min(extreme_price, low)
    
    // Calculate Levels (Retracement from Low up to High)
    // Fib 0% = Low, Fib 100% = High (Anchor)
    // 50% = Low + 0.5 * Range
    range_val = anchor_price - extreme_price
    lev_50 = extreme_price + (range_val * 0.50)
    lev_618 = extreme_price + (range_val * 0.618)
    lev_82 = extreme_price + (range_val * 0.82)
    
    // Update Lines
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    
    l_50 := line.new(bar_index, lev_50, bar_index + 1, lev_50, extend=extend.right, color=color.red, width=1)
    l_618 := line.new(bar_index, lev_618, bar_index + 1, lev_618, extend=extend.right, color=color.red, width=1)
    l_82 := line.new(bar_index, lev_82, bar_index + 1, lev_82, extend=extend.right, color=color.red, width=2) // Stop zone
    
    lf_fill := linefill.new(l_50, l_618, color=color.new(color.red, 85))
    
    // "put short if it comes up to fib"
    if high >= lev_50 and high <= lev_82
        if low < lev_50 and high > lev_50 // Crossed up into it
            label.new(bar_index, high, "SHORT", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
            
    // "put stopped if goes through 82%"
    if high > lev_82
        label.new(bar_index, lev_82, "STOPPED", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
        isShort := false
        reset_fibs()
