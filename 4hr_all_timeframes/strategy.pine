//@version=5
indicator('AlphaTrend Fibs', shorttitle='AT Fibs', overlay=true, format=format.price, precision=2)

// --- Inputs ---
coeff = input.float(1, 'Multiplier', step=0.1)
AP = input(14, 'Common Period')
src = input(close)
showsignalsk = input(title='Show Signals?', defval=true)
novolumedata = input(title='Change calculation (no volume data)?', defval=false)

// --- AlphaTrend Calculation (Hidden Logic) ---
ATR = ta.sma(ta.tr, AP)
upT = low - ATR * coeff
downT = high + ATR * coeff
AlphaTrend = 0.0
AlphaTrend := (novolumedata ? ta.rsi(src, AP) >= 50 : ta.mfi(hlc3, AP) >= 50) ? upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : upT : downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : downT

// We do NOT plot AlphaTrend lines or fills as requested.
// Just using the signals.

buySignalk = ta.crossover(AlphaTrend, AlphaTrend[2])
sellSignalk = ta.crossunder(AlphaTrend, AlphaTrend[2])

K1 = ta.barssince(buySignalk)
K2 = ta.barssince(sellSignalk)
O1 = ta.barssince(buySignalk[1])
O2 = ta.barssince(sellSignalk[1])

// Valid Buy/Sell Conditions
validBuy = buySignalk and showsignalsk and O1 > K2
validSell = sellSignalk and showsignalsk and O2 > K1

// --- CUSTOM FIBONACCI LOGIC ---

// State Variables
var bool isLong = false
var bool isShort = false
var float anchor_price = na // Low for Longs, High for Shorts
var float extreme_price = na // Highest High for Longs, Lowest Low for Shorts

// Lines & Labels
var line l_50 = na
var line l_618 = na
var line l_82 = na
var linefill lf_fill = na

// Reset Function
reset_fibs() =>
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    true

// --- LONG LOGIC ---
if validBuy
    // New Buy Signal -> Start Fresh
    reset_fibs()
    isLong := true
    isShort := false
    
    // Anchor at Lowest Low since the last Sell Signal (Trend Low)
    lowest_since_sell = ta.lowest(low, K2 > 0 ? K2 : 1)
    anchor_price := lowest_since_sell
    
    // Mark the Anchor
    label.new(bar_index, anchor_price, "X", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny, tooltip="Anchor Low")
    
    extreme_price := high // Reset high tracking

// Maintenance for Long
if isLong
    // Update Highest High
    extreme_price := math.max(extreme_price, high)
    
    // Calculate Levels (Retracement from High down to Low)
    // Fib 0% = High, Fib 100% = Low (Anchor)
    range_val = extreme_price - anchor_price
    lev_50 = extreme_price - (range_val * 0.50)
    lev_618 = extreme_price - (range_val * 0.618)
    lev_82 = extreme_price - (range_val * 0.82)
    
    // Update Lines
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    
    l_50 := line.new(bar_index, lev_50, bar_index + 1, lev_50, extend=extend.right, color=color.green, width=1)
    l_618 := line.new(bar_index, lev_618, bar_index + 1, lev_618, extend=extend.right, color=color.green, width=1)
    l_82 := line.new(bar_index, lev_82, bar_index + 1, lev_82, extend=extend.right, color=color.red, width=2) // 82% is Stop zone
    
    lf_fill := linefill.new(l_50, l_618, color=color.new(color.green, 85))
    
    // "put long if it comes down to fib"
    if high > lev_50 and low < lev_50 // Crossed into it
        label.new(bar_index, low, "LONG", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

    // "put stopped if goes through 82%"
    if low < lev_82
        label.new(bar_index, lev_82, "STOPPED", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)
        isLong := false 
        reset_fibs()

// --- SHORT LOGIC ---
if validSell
    // New Sell Signal
    reset_fibs()
    isLong := false
    isShort := true
    
    // Anchor at Highest High since last Buy Signal (Trend High)
    highest_since_buy = ta.highest(high, K1 > 0 ? K1 : 1)
    anchor_price := highest_since_buy
    
    // Mark the Anchor
    label.new(bar_index, anchor_price, "X", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny, tooltip="Anchor High")
    
    extreme_price := low // Reset Low tracking

// Maintenance for Short
if isShort
    // Update Lowest Low
    extreme_price := math.min(extreme_price, low)
    
    // Calculate Levels (Retracement from Low up to High)
    // Fib 0% = Low, Fib 100% = High (Anchor)
    range_val = anchor_price - extreme_price
    lev_50 = extreme_price + (range_val * 0.50)
    lev_618 = extreme_price + (range_val * 0.618)
    lev_82 = extreme_price + (range_val * 0.82)
    
    // Update Lines
    line.delete(l_50)
    line.delete(l_618)
    line.delete(l_82)
    linefill.delete(lf_fill)
    
    l_50 := line.new(bar_index, lev_50, bar_index + 1, lev_50, extend=extend.right, color=color.red, width=1)
    l_618 := line.new(bar_index, lev_618, bar_index + 1, lev_618, extend=extend.right, color=color.red, width=1)
    l_82 := line.new(bar_index, lev_82, bar_index + 1, lev_82, extend=extend.right, color=color.red, width=2) // Stop zone
    
    lf_fill := linefill.new(l_50, l_618, color=color.new(color.red, 85))
    
    // "put short if it comes up to fib"
    if low < lev_50 and high > lev_50 // Crossed up into it
        label.new(bar_index, high, "SHORT", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
            
    // "put stopped if goes through 82%"
    if high > lev_82
        label.new(bar_index, lev_82, "STOPPED", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
        isShort := false
        reset_fibs()
