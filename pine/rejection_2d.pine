//@version=6
strategy("2D Rejection Candle System", "REJ 2D", overlay = true,
     initial_capital = 10000, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5,
     slippage = 2,
     max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────
// RULES
// Signal candle:
//   • opens inside the previous candle's range
//   • trades above prev high (bear) / below prev low (bull)
//   • closes back inside the previous range
//   • opposite body: swept high → red candle, swept low → green candle
// Filters (v2, from the gold/Brent backtest — see backtest/RESULTS.md):
//   • trend: longs only above the EMA, shorts only below (default EMA 50)
//   • direction: default Long only (shorts lost money on both markets)
// Entry : next candle open
// Stop  : signal candle wick (or previous range high/low — toggle)
// Target: none by default — a trailing stop does the exiting (toggle a fixed 4R target)
// Trail : once price tags 2R, stop trails 1R behind the best price since entry
// Scratch to breakeven: OFF by default (it cost R)
// Costs : commission + slippage set in strategy() — adjust to your broker
// Built for the 2D chart — table warns if you're on another timeframe
// ─────────────────────────────────────────────────────────────

// ── Inputs
grpS = "Signal"
reqOpenInside = input.bool(true, "Open must be inside previous range", group = grpS)
reqOppBody    = input.bool(true, "Require opposite candle body", group = grpS)

grpF = "Filters"
sideMode = input.string("Long only", "Direction", options = ["Both", "Long only", "Short only"], group = grpF)
trendLen = input.int(50, "Trend EMA length (0 = off)", minval = 0, group = grpF)
showEma  = input.bool(true, "Plot trend EMA", group = grpF)

grpT = "Trade"
stopMode   = input.string("Signal candle wick", "Stop placement", options = ["Signal candle wick", "Previous range high/low"], group = grpT)
useTarget  = input.bool(false, "Use fixed target", group = grpT)
targetR    = input.float(4.0, "Target (R)", minval = 0.5, step = 0.5, group = grpT)
useTrail   = input.bool(true, "Trailing stop", group = grpT)
trailStartR = input.float(2.0, "Trail starts at (R)", minval = 0.5, step = 0.5, group = grpT)
trailDistR = input.float(1.0, "Trail distance (R)", minval = 0.25, step = 0.25, group = grpT)
useScratch = input.bool(false, "Scratch stop to breakeven", group = grpT)
scratchR   = input.float(2.0, "Scratch trigger (R)", minval = 0.5, step = 0.5, group = grpT)
riskPct    = input.float(1.0, "Risk per trade (% equity)", minval = 0.1, step = 0.1, group = grpT)

grpV = "Visuals"
showLevels = input.bool(true, "Draw trade levels", group = grpV)
showTable  = input.bool(true, "Show stats table", group = grpV)
colLong    = input.color(color.teal, "Bull colour", group = grpV)
colShort   = input.color(color.red, "Bear colour", group = grpV)
colTarget  = input.color(color.lime, "Target colour", group = grpV)
colScratch = input.color(color.orange, "Scratch / trail colour", group = grpV)

// ── Trend filter
useTrend = trendLen > 0
ema      = ta.ema(close, math.max(trendLen, 1))
trendUp  = not useTrend or close > ema
trendDn  = not useTrend or close < ema
plot(useTrend and showEma ? ema : na, "Trend EMA", color = color.new(color.gray, 30), linewidth = 2)

// ── Signal logic
prevH = high[1]
prevL = low[1]
openIn  = open >= prevL and open <= prevH
closeIn = close >= prevL and close <= prevH

bearRaw = (not reqOpenInside or openIn) and high > prevH and closeIn and (not reqOppBody or close < open)
bullRaw = (not reqOpenInside or openIn) and low < prevL and closeIn and (not reqOppBody or close > open)
bearSig = bearRaw and not bullRaw and trendDn and sideMode != "Long only"
bullSig = bullRaw and not bearRaw and trendUp and sideMode != "Short only"

bearStop = stopMode == "Signal candle wick" ? high : prevH
bullStop = stopMode == "Signal candle wick" ? low  : prevL

plotshape(bearSig, "Bear rejection", shape.triangledown, location.abovebar, colShort, size = size.small, text = "REJ")
plotshape(bullSig, "Bull rejection", shape.triangleup,   location.belowbar, colLong,  size = size.small, text = "REJ")

// Swept level marker
if bearSig
    line.new(bar_index - 1, prevH, bar_index, prevH, color = colShort, style = line.style_dotted)
if bullSig
    line.new(bar_index - 1, prevL, bar_index, prevL, color = colLong, style = line.style_dotted)

// ── State
var int   pDir = 0          // order sent, waiting for fill
var float pStop = na
var int   tDir = 0          // live trade direction
var float tEntry = na
var float tStop = na
var float tRisk = na
var bool  tScratched = false
var float tBest = na        // best price since entry (high for longs, low for shorts)
var float tCurStop = na     // live stop (original → breakeven → trailing)
var bool  tTrailing = false
var line  lnE = na
var line  lnS = na
var line  ln2 = na
var line  ln4 = na
var array<float> results = array.new<float>()

// ── 1) Trade closed this bar → record result in R
if strategy.closedtrades > nz(strategy.closedtrades[1])
    i    = strategy.closedtrades - 1
    ep   = strategy.closedtrades.entry_price(i)
    xp   = strategy.closedtrades.exit_price(i)
    dir  = strategy.closedtrades.size(i) > 0 ? 1 : -1
    stp  = tDir != 0 ? tStop : pStop
    risk = math.abs(ep - stp)
    rr   = risk > 0 ? (xp - ep) * dir / risk : 0.0
    array.push(results, rr)
    resCol = rr > 0.1 ? colTarget : rr < -0.1 ? colShort : color.gray
    label.new(bar_index, dir == 1 ? high : low, str.tostring(rr, "#.##") + "R",
         style = dir == 1 ? label.style_label_down : label.style_label_up,
         color = color.new(resCol, 20), textcolor = color.white, size = size.small)
    if showLevels and tDir != 0
        line.set_x2(lnE, bar_index)
        line.set_x2(ln2, bar_index)
        line.set_x2(ln4, bar_index)
        if not (tScratched or tTrailing)
            line.set_x2(lnS, bar_index)
    tDir := 0
    pDir := 0
    tScratched := false
    tTrailing := false

// ── 2) Order filled at this bar's open → lock in real entry & draw levels
if pDir != 0 and strategy.position_size != 0 and tDir == 0
    tDir   := pDir
    tEntry := strategy.position_avg_price
    tStop  := pStop
    tRisk  := math.abs(tEntry - tStop)
    tScratched := false
    tTrailing := false
    tBest := tEntry
    tCurStop := tStop
    pDir := 0
    if showLevels
        lnE := line.new(bar_index, tEntry, bar_index + 1, tEntry, color = color.gray, width = 2)
        lnS := line.new(bar_index, tStop,  bar_index + 1, tStop,  color = colShort, width = 2)
        if useTarget
            ln4 := line.new(bar_index, tEntry + tDir * targetR  * tRisk, bar_index + 1, tEntry + tDir * targetR  * tRisk, color = colTarget, width = 2)
        if useScratch or useTrail
            lvl = tEntry + tDir * (useTrail ? trailStartR : scratchR) * tRisk
            ln2 := line.new(bar_index, lvl, bar_index + 1, lvl, color = colScratch, style = line.style_dashed)

// ── 3) Manage open trade at bar close: breakeven / trailing stop, optional target
//       (new stop level applies from the next bar)
if tDir != 0 and strategy.position_size != 0
    tgt = tEntry + tDir * targetR * tRisk
    scr = tEntry + tDir * scratchR * tRisk
    if useScratch and not tScratched and (tDir == 1 ? high >= scr : low <= scr)
        tScratched := true
        tCurStop := tDir == 1 ? math.max(tCurStop, tEntry) : math.min(tCurStop, tEntry)
        if showLevels
            line.set_style(lnS, line.style_dotted)
            label.new(bar_index, scr, "BE", style = label.style_label_left, color = color.new(colScratch, 30), textcolor = color.white, size = size.tiny)
    tBest := tDir == 1 ? math.max(tBest, high) : math.min(tBest, low)
    if useTrail and (tBest - tEntry) * tDir >= trailStartR * tRisk
        if not tTrailing and showLevels
            line.set_style(lnS, line.style_dotted)
            label.new(bar_index, tEntry + tDir * trailStartR * tRisk, "TRAIL", style = label.style_label_left, color = color.new(colScratch, 30), textcolor = color.white, size = size.tiny)
        tTrailing := true
        ts = tBest - tDir * trailDistR * tRisk
        tCurStop := tDir == 1 ? math.max(tCurStop, ts) : math.min(tCurStop, ts)
    strategy.exit("X", tDir == 1 ? "Long" : "Short", stop = tCurStop, limit = useTarget ? tgt : na)
    if showLevels
        line.set_x2(lnE, bar_index + 1)
        line.set_x2(ln2, bar_index + 1)
        line.set_x2(ln4, bar_index + 1)
        if not (tScratched or tTrailing)
            line.set_x2(lnS, bar_index + 1)

// Live stop once it has moved (breakeven or trailing) — stepped line
plot(tDir != 0 and (tScratched or tTrailing) ? tCurStop : na, "Trailing stop", color = colScratch, linewidth = 2, style = plot.style_linebr)

// ── 4) New signal → buy/sell next open
if strategy.position_size == 0 and pDir == 0 and tDir == 0 and (bullSig or bearSig)
    d   = bullSig ? 1 : -1
    stp = d == 1 ? bullStop : bearStop
    riskOk = d == 1 ? close > stp : close < stp
    if riskOk
        estRisk = math.abs(close - stp)
        qty = strategy.equity * riskPct / 100 / (estRisk * syminfo.pointvalue)
        id  = d == 1 ? "Long" : "Short"
        pDir  := d
        pStop := stp
        strategy.entry(id, d == 1 ? strategy.long : strategy.short, qty)
        // Protective orders live from the fill bar. Target is set in ticks from
        // the ACTUAL fill price (not the signal close); refined to exact R next bar.
        strategy.exit("X", id, stop = stp, profit = useTarget ? math.round(targetR * estRisk / syminfo.mintick) : na)

// ── Alerts (filtered signals only)
if bullSig
    alert("BULL rejection " + syminfo.ticker + " | buy next open | stop " + str.tostring(bullStop, format.mintick), alert.freq_once_per_bar_close)
if bearSig
    alert("BEAR rejection " + syminfo.ticker + " | sell next open | stop " + str.tostring(bearStop, format.mintick), alert.freq_once_per_bar_close)

// ── Stats table
var table tb = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 15), border_width = 1)
f_row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTable and barstate.islast
    int   w = 0
    int   s = 0
    int   l = 0
    float tot = 0.0
    for r in results
        tot += r
        if r > 0.1
            w += 1
        else if r < -0.1
            l += 1
        else
            s += 1
    n = array.size(results)
    tfOk = timeframe.period == "2D"
    f_row(0, "Timeframe", tfOk ? "2D ✓" : timeframe.period + " — switch to 2D", tfOk ? color.lime : color.orange)
    f_row(1, "Trades", str.tostring(n), color.white)
    f_row(2, "Win / Scratch / Loss", str.tostring(w) + " / " + str.tostring(s) + " / " + str.tostring(l), color.white)
    f_row(3, "Win rate", n > 0 ? str.tostring(100.0 * w / n, "#.#") + "%" : "-", color.white)
    f_row(4, "Total R", str.tostring(tot, "#.##"), tot >= 0 ? color.lime : color.red)
    f_row(5, "Expectancy (R/trade)", n > 0 ? str.tostring(tot / n, "#.##") : "-", tot >= 0 ? color.lime : color.red)
    curTxt = tDir == 0 ? (pDir != 0 ? "Pending next open" : "Flat") : (tDir == 1 ? "Long" : "Short") + (tTrailing ? " (trailing)" : tScratched ? " (BE)" : "")
    f_row(6, "Current", curTxt, tDir == 1 ? colLong : tDir == -1 ? colShort : color.gray)
    f_row(7, "Risk (ticks)", tDir != 0 ? str.tostring(math.round(tRisk / syminfo.mintick)) : "-", color.white)
    f_row(8, "Target / Trail", (useTarget ? str.tostring(targetR) + "R" : "none") + " / " + (useTrail ? str.tostring(trailDistR) + "R after " + str.tostring(trailStartR) + "R" : "off"), color.white)
    trendTxt = useTrend ? "EMA" + str.tostring(trendLen) + (close > ema ? " ↑" : " ↓") : "off"
    f_row(9, "Filter", sideMode + " · trend " + trendTxt, useTrend ? (close > ema ? colLong : colShort) : color.gray)
