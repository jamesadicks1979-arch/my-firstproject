//@version=6
indicator("2D Rejection Scanner", "REJ SCAN", overlay = true)

// ─────────────────────────────────────────────────────────────
// Scans up to 40 markets for the 2D rejection candle and fires ONE alert
// per new signal, once the 2D candle has CLOSED (no repainting).
//
// Setup:
//   1. Add to any chart. Best: a 24/7 market on a 1h chart (e.g. BINANCE:BTCUSDT 1h)
//      so the script runs all the time and alerts arrive soon after each close.
//   2. Create Alert → Condition: "REJ SCAN" → "Any alert() function call"
//      → Expiration: open-ended → turn on app / email notifications.
//   3. Swap any market in the settings ("Markets" group). Add the scanner a second
//      time with a different list to watch 80 markets.
//
// Signal candle (same rules as the strategy):
//   opens inside the previous range, sweeps the previous high (bear) / low (bull),
//   closes back inside the previous range, opposite body colour.
// Bias filter (choose in settings):
//   • 22 SMA / 50 EMA + structure: SMA above EMA → longs, below → shorts; when the
//     two are within 0.5 ATR, lower highs → shorts, higher lows → longs
//   • Price vs 50 EMA: longs above, shorts below
//   • None: every rejection candle
// A-grade: 100-bar high/low or an outside bar (flagged in the alert; can be allowed
// against the bias).
// Outside reversal: outside bar at a strong high (highest of the last 100 bars) that
// closes red → short, or at a strong low that closes green → long. It may close
// anywhere (it does not need to close back inside the previous range).
// ─────────────────────────────────────────────────────────────

grpF = "Filters"
tf         = input.timeframe("2D", "Scan timeframe", group = grpF)
sideMode   = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpF)
biasMode   = input.string("22 SMA / 50 EMA + structure", "Bias filter", options = ["22 SMA / 50 EMA + structure", "Price vs 50 EMA", "None (all candles)"], group = grpF)
onlyA      = input.bool(false, "Alert A-grade setups only", group = grpF)
aIgnore    = input.bool(true, "A-grade can go against the bias", group = grpF)
fastLen    = input.int(22, "Fast SMA", minval = 1, group = grpF)
slowLen    = input.int(50, "Slow EMA", minval = 1, group = grpF)
closeATR   = input.float(0.5, "MAs 'close' within (x ATR)", minval = 0, step = 0.1, group = grpF)
pivLen     = input.int(3, "Swing strength (bars each side)", minval = 1, group = grpF)
extLen     = input.int(100, "A-grade extreme lookback (bars)", minval = 5, group = grpF)
useOutRev  = input.bool(true, "Include outside reversals at strong highs / lows", group = grpF)
outLen     = input.int(100, "Strong high / low lookback for outside reversals", minval = 5, group = grpF)
onlyOut    = input.bool(false, "Alert outside reversals only", group = grpF)

grpT = "Table"
showTable  = input.bool(true, "Show table", group = grpT)
recentN    = input.int(3, "List signals from the last N bars", minval = 0, group = grpT)
showAll    = input.bool(false, "List every market (with its bias)", group = grpT)
tPos       = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpT)

grpM = "Markets"
s00 = input.symbol("OANDA:XAUUSD", "1", group = grpM)
s01 = input.symbol("OANDA:XAGUSD", "2", group = grpM)
s02 = input.symbol("OANDA:XPTUSD", "3", group = grpM)
s03 = input.symbol("COMEX:HG1!", "4", group = grpM)
s04 = input.symbol("TVC:UKOIL", "5", group = grpM)
s05 = input.symbol("TVC:USOIL", "6", group = grpM)
s06 = input.symbol("NYMEX:NG1!", "7", group = grpM)
s07 = input.symbol("NYMEX:RB1!", "8", group = grpM)
s08 = input.symbol("NYMEX:HO1!", "9", group = grpM)
s09 = input.symbol("OANDA:SPX500USD", "10", group = grpM)
s10 = input.symbol("OANDA:NAS100USD", "11", group = grpM)
s11 = input.symbol("OANDA:US30USD", "12", group = grpM)
s12 = input.symbol("OANDA:US2000USD", "13", group = grpM)
s13 = input.symbol("OANDA:DE30EUR", "14", group = grpM)
s14 = input.symbol("OANDA:UK100GBP", "15", group = grpM)
s15 = input.symbol("OANDA:EU50EUR", "16", group = grpM)
s16 = input.symbol("OANDA:JP225USD", "17", group = grpM)
s17 = input.symbol("OANDA:AU200AUD", "18", group = grpM)
