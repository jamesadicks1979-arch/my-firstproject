// ── Table
pos = switch tPos
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right
var table tb = table.new(pos, 6, 42, bgcolor = color.new(color.black, 15), border_width = 1)

cell(int c, int r, string txt, color col) =>
    table.cell(tb, c, r, txt, text_color = col, text_size = size.small, text_halign = c == 0 ? text.align_left : text.align_right)

if showTable and barstate.islast
    table.clear(tb, 0, 0, 5, 41)
    cell(0, 0, "Market", color.silver)
    cell(1, 0, "Signal", color.silver)
    cell(2, 0, "Candle", color.silver)
    cell(3, 0, "Stop", color.silver)
    cell(4, 0, "Bars ago", color.silver)
    cell(5, 0, "Bias now", color.silver)
    r = 1
    for i = 0 to N - 1
        recent = array.get(sTime, i) > 0 and array.get(since, i) <= recentN
        if (showAll or recent) and array.get(names, i) != "" and r < 42
            d = array.get(sDir, i)
            b = array.get(curB, i)
            cell(0, r, array.get(names, i), color.white)
            cell(1, r, recent ? (array.get(sO, i) ? "OUT " : array.get(sA, i) ? "A " : "") + (d == 1 ? "LONG" : "SHORT") : "—", recent ? (array.get(sA, i) ? color.yellow : d == 1 ? color.teal : color.red) : color.gray)
            cell(2, r, recent ? str.format_time(array.get(sTime, i), "dd MMM", "UTC") : "", color.white)
            cell(3, r, recent ? str.tostring(array.get(sStop, i), "#.#####") : "", color.white)
            cell(4, r, recent ? str.tostring(array.get(since, i)) : "", color.white)
            cell(5, r, biasText(b, array.get(curMC, i)), b == 1 ? color.teal : b == -1 ? color.red : color.gray)
            r += 1
    if r == 1
        cell(0, 1, "No signals in the last " + str.tostring(recentN) + " bars", color.gray)
