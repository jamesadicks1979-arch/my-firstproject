[g11c, g11st, g11t] = request.security(s11, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g12c, g12st, g12t] = request.security(s12, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g13c, g13st, g13t] = request.security(s13, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g14c, g14st, g14t] = request.security(s14, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g15c, g15st, g15t] = request.security(s15, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g16c, g16st, g16t] = request.security(s16, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g17c, g17st, g17t] = request.security(s17, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g18c, g18st, g18t] = request.security(s18, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g19c, g19st, g19t] = request.security(s19, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g20c, g20st, g20t] = request.security(s20, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g21c, g21st, g21t] = request.security(s21, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g22c, g22st, g22t] = request.security(s22, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g23c, g23st, g23t] = request.security(s23, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g24c, g24st, g24t] = request.security(s24, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g25c, g25st, g25t] = request.security(s25, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g26c, g26st, g26t] = request.security(s26, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g27c, g27st, g27t] = request.security(s27, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g28c, g28st, g28t] = request.security(s28, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g29c, g29st, g29t] = request.security(s29, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g30c, g30st, g30t] = request.security(s30, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g31c, g31st, g31t] = request.security(s31, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g32c, g32st, g32t] = request.security(s32, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g33c, g33st, g33t] = request.security(s33, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g34c, g34st, g34t] = request.security(s34, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g35c, g35st, g35t] = request.security(s35, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g36c, g36st, g36t] = request.security(s36, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g37c, g37st, g37t] = request.security(s37, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g38c, g38st, g38t] = request.security(s38, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g39c, g39st, g39t] = request.security(s39, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

