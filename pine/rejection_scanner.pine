s20 = input.symbol("OANDA:GBPUSD", "21", group = grpM)
s21 = input.symbol("OANDA:USDJPY", "22", group = grpM)
s22 = input.symbol("OANDA:AUDUSD", "23", group = grpM)
s23 = input.symbol("OANDA:USDCAD", "24", group = grpM)
s24 = input.symbol("OANDA:USDCHF", "25", group = grpM)
s25 = input.symbol("OANDA:NZDUSD", "26", group = grpM)
s26 = input.symbol("OANDA:EURJPY", "27", group = grpM)
s27 = input.symbol("OANDA:GBPJPY", "28", group = grpM)
s28 = input.symbol("OANDA:EURGBP", "29", group = grpM)
s29 = input.symbol("CBOT:ZN1!", "30", group = grpM)
s30 = input.symbol("CBOT:ZB1!", "31", group = grpM)
s31 = input.symbol("CBOT:ZC1!", "32", group = grpM)
s32 = input.symbol("CBOT:ZS1!", "33", group = grpM)
s33 = input.symbol("CBOT:ZW1!", "34", group = grpM)
s34 = input.symbol("ICEUS:KC1!", "35", group = grpM)
s35 = input.symbol("ICEUS:SB1!", "36", group = grpM)
s36 = input.symbol("ICEUS:CC1!", "37", group = grpM)
s37 = input.symbol("BINANCE:BTCUSDT", "38", group = grpM)
s38 = input.symbol("BINANCE:ETHUSDT", "39", group = grpM)
s39 = input.symbol("BINANCE:SOLUSDT", "40", group = grpM)

// ── Runs inside each market on the scan timeframe. Values are taken from the
//    last CLOSED bar ([1] with lookahead on) so nothing repaints.
scan() =>
    fast = ta.sma(close, fastLen)
    slow = ta.ema(close, slowLen)
    atr  = ta.atr(14)
    ph   = ta.pivothigh(high, pivLen, pivLen)
    pl   = ta.pivotlow(low, pivLen, pivLen)
    hhX  = ta.highest(high, extLen)
    llX  = ta.lowest(low, extLen)
    hhO  = ta.highest(high, outLen)
    llO  = ta.lowest(low, outLen)
    var float lastH = na
    var float lastL = na
    var bool  bearS = false
    var bool  bullS = false
    if not na(ph)
        if not na(lastH) and ph < lastH
            bearS := true
            bullS := false
        lastH := ph
    if not na(pl)
        if not na(lastL) and pl > lastL
            bullS := true
            bearS := false
        lastL := pl
    if bearS and not na(lastH) and high > lastH
        bearS := false
    if bullS and not na(lastL) and low < lastL
        bullS := false
    maClose = math.abs(fast - slow) < closeATR * atr
    int bias = switch biasMode
        "22 SMA / 50 EMA + structure" => not maClose ? (fast > slow ? 1 : -1) : bearS ? -1 : bullS ? 1 : 0
        "Price vs 50 EMA"             => close > slow ? 1 : -1
        => 2   // no filter
    pH = high[1]
    pL = low[1]
    openIn  = open >= pL and open <= pH
    closeIn = close >= pL and close <= pH
    outside = high > pH and low < pL
    bearO = useOutRev and outside and close < open and high >= hhO
    bullO = useOutRev and outside and close > open and low <= llO
    bearB = (openIn and high > pH and closeIn and close < open) or bearO
    bullB = (openIn and low < pL and closeIn and close > open) or bullO
    bearA = bearB and (high >= hhX or outside)
    bullA = bullB and (low <= llX or outside)
    bearOk = bearB and sideMode != "Long only" and (bias == -1 or bias == 2 or (bearA and aIgnore))
    bullOk = bullB and sideMode != "Short only" and (bias == 1 or bias == 2 or (bullA and aIgnore))
    int   sig = bullOk ? 1 : bearOk ? -1 : 0
    bool  isA = sig == 1 ? bullA : sig == -1 ? bearA : false
    bool  isO = sig == 1 ? bullO : sig == -1 ? bearO : false
    float stp = sig == 1 ? low : sig == -1 ? high : na
    // packed into one number to stay under TradingView's 127 returned-values limit
    int code = (sig + 1) + 3 * (isA ? 1 : 0) + 6 * (bias + 1) + 30 * (maClose ? 1 : 0) + 60 * (isO ? 1 : 0)
    [code[1], stp[1], time[1]]

// ── Per-market memory
var int   N = 40
var array<string> names  = array.new_string(40, "")
var array<int>    lastT  = array.new_int(40, 0)
var array<int>    sDir   = array.new_int(40, 0)
var array<bool>   sA     = array.new_bool(40, false)
var array<bool>   sO     = array.new_bool(40, false)
var array<float>  sStop  = array.new_float(40, na)
var array<int>    sTime  = array.new_int(40, 0)
var array<int>    since  = array.new_int(40, 9999)
var array<int>    curB   = array.new_int(40, 0)
var array<bool>   curMC  = array.new_bool(40, false)

shortName(string s) =>
    parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s

biasText(int b, bool mc) =>
    b == 2 ? "—" : b == 1 ? "Long" + (mc ? " (struct)" : "") : b == -1 ? "Short" + (mc ? " (struct)" : "") : "None"

proc(int i, string sym, int code, float st, int t) =>
    array.set(names, i, shortName(sym))
    if not na(t) and not na(code)
        o  = code >= 60
        mc = (code % 60) >= 30
        r  = code % 30
        b  = int(r / 6) - 1
        sg = (r % 6) % 3 - 1
        a  = (r % 6) >= 3
        array.set(curB, i, b)
        array.set(curMC, i, mc)
        if t != array.get(lastT, i)
            array.set(lastT, i, t)
            array.set(since, i, array.get(since, i) + 1)
            if sg != 0 and (not onlyA or a) and (not onlyOut or o)
                array.set(sDir, i, sg)
                array.set(sA, i, a)
                array.set(sO, i, o)
                array.set(sStop, i, st)
                array.set(sTime, i, t)
                array.set(since, i, 0)
                msg = (o ? "OUTSIDE REVERSAL " : a ? "A-GRADE " : "") + (sg == 1 ? "LONG" : "SHORT") + (o ? " at strong " + (sg == 1 ? "low" : "high") : " rejection") + " | " + sym + " | " + tf + " candle of " +
                     str.format_time(t, "yyyy-MM-dd", "UTC") + " closed" +
                     " | stop " + str.tostring(st, "#.#####") + " | bias " + biasText(b, mc) + " | entry: next open"
                alert(msg, alert.freq_all)

[g00c, g00st, g00t] = request.security(s00, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g01c, g01st, g01t] = request.security(s01, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[g02c, g02st, g02t] = request.security(s02, tf, scan(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
