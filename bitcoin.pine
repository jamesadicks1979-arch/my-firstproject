//@version=5
indicator("Outside 2D (levels) + NWE [LuxAlgo]", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=500, format=format.price, precision=2)

// ───────── Inputs ─────────
count = input.int(1, "Number of consecutive outside bars (2D)", minval=1, maxval=10)

highlight2DOutsideClose = input.bool(true, "Highlight 2D outside CLOSE bar")
highlightColor = input.color(color.new(color.orange, 85), "Highlight color")

// Levels
entryPct1 = input.float(0.40, "Entry 40%", minval=0.0, maxval=1.0, step=0.01, group="Levels")
entryPct2 = input.float(0.61, "Entry 61%", minval=0.0, maxval=1.0, step=0.01, group="Levels")
stopPct   = input.float(0.80, "Stop 80%",  minval=0.0, maxval=1.0, step=0.01, group="Levels")

showCrosses = input.bool(true, "Show 4 large crosses on NEXT candle", group="Levels")
showBuySellLabel = input.bool(true, "Show BUY/SELL label on NEXT candle", group="Levels")

enableSell = input.bool(true, "Enable SELL (bearish 2D outside)", group="Direction")
enableBuy  = input.bool(true, "Enable BUY (bullish 2D outside)", group="Direction")

enableWickProjection = input.bool(true, "Include wick projection cross", group="Wick projection")

// ───────── Helpers ─────────
f_isOutsideN(_n) =>
    oc = 0
    for i = 0 to _n - 1
        if high[i] > high[i + 1] and low[i] < low[i + 1]
            oc += 1
    oc >= _n

f_x(_y, _col) =>
    label.new(x=bar_index, y=_y, text="X", style=label.style_label_center, color=color.new(_col, 100), textcolor=_col, size=size.normal)

// ───────── 2D series ─────────
outside2D = request.security(syminfo.tickerid, "2D", f_isOutsideN(count), lookahead=barmerge.lookahead_off)
bull2D   = request.security(syminfo.tickerid, "2D", close >= open, lookahead=barmerge.lookahead_off)
bear2D   = request.security(syminfo.tickerid, "2D", open > close, lookahead=barmerge.lookahead_off)

// True only on chart bar that closes the 2D candle
close2Dbar = request.security(syminfo.tickerid, "2D", barstate.isconfirmed, lookahead=barmerge.lookahead_off)
outsideCloseBar = close2Dbar and outside2D

// Highlight the close bar of the 2D outside candle
bgcolor(highlight2DOutsideClose and outsideCloseBar ? highlightColor : na)

// Previous (just-closed) 2D candle OHLC (available on NEXT chart bar via [1])
o2 = request.security(syminfo.tickerid, "2D", open, lookahead=barmerge.lookahead_off)
h2 = request.security(syminfo.tickerid, "2D", high, lookahead=barmerge.lookahead_off)
l2 = request.security(syminfo.tickerid, "2D", low,  lookahead=barmerge.lookahead_off)

// NEXT chart candle after the 2D outside bar close
nextAfterOutside2D = outsideCloseBar[1]

// Use the direction of the just-closed 2D outside candle
sellSetup = enableSell and nextAfterOutside2D and bear2D[1]
buySetup  = enableBuy  and nextAfterOutside2D and bull2D[1]

oPrev = o2[1]
hPrev = h2[1]
lPrev = l2[1]
rngPrev = hPrev - lPrev

if showCrosses and sellSetup and not na(rngPrev)
    e40 = lPrev + entryPct1 * rngPrev
    e61 = lPrev + entryPct2 * rngPrev
    e80 = lPrev + stopPct * rngPrev
    if enableWickProjection
        wick = hPrev - oPrev
        wProj = open + wick
        f_x(wProj, color.purple)
    f_x(e40, color.red)
    f_x(e61, color.red)
    f_x(e80, color.orange)
    if showBuySellLabel
        label.new(x=bar_index, y=high, text="SELL", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.red, size=size.tiny)

if showCrosses and buySetup and not na(rngPrev)
    e40 = hPrev - entryPct1 * rngPrev
    e61 = hPrev - entryPct2 * rngPrev
    e80 = hPrev - stopPct * rngPrev
    if enableWickProjection
        wick = oPrev - lPrev
        wProj = open - wick
        f_x(wProj, color.purple)
    f_x(e40, color.green)
    f_x(e61, color.green)
    f_x(e80, color.orange)
    if showBuySellLabel
        label.new(x=bar_index, y=low, text="BUY", style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.green, size=size.tiny)

// ============================================================================
// Nadaraya-Watson Envelope [LuxAlgo] (added)
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
// ============================================================================

// ───────── NWE Inputs ─────────
nwe_coeff = input.float(1, "Multiplier", step=0.1, group="NWE")
nwe_AP = input.int(14, "Common Period", group="NWE")
nwe_ATR = ta.sma(ta.tr, nwe_AP)
nwe_src = input.source(close, "Source", group="NWE")
nwe_showSignals = input.bool(true, "Show Signals?", group="NWE")
nwe_noVolumeData = input.bool(false, "Change calculation (no volume data)?", group="NWE")
_nwe_upT = low - nwe_ATR * nwe_coeff
_nwe_downT = high + nwe_ATR * nwe_coeff

// Settings
nwe_h = input.float(8.0, "Bandwidth", minval=0, group="NWE")
nwe_mult = input.float(3.0, "Error Mult", minval=0, group="NWE")
nwe_repaint = input.bool(true, "Repainting Smoothing", group="NWE", tooltip="Repainting changes historical output. Disable for endpoint method.")

// Style
nwe_upCss = input.color(color.teal, "Colors", inline="c1", group="NWE Style")
nwe_dnCss = input.color(color.red,  "", inline="c1", group="NWE Style")

// Gaussian window
nwe_gauss(x, h) => math.exp(-(math.pow(x, 2) / (h * h * 2)))

// Append lines
nwe_n = bar_index
var nwe_ln = array.new_line(0)
if barstate.isfirst and nwe_repaint
    for _ = 0 to 499
        array.push(nwe_ln, line.new(na, na, na, na))

// End point method (non-repainting)
var nwe_coefs = array.new_float(0)
var float nwe_den = na
if barstate.isfirst and not nwe_repaint
    for i = 0 to 499
        w = nwe_gauss(i, nwe_h)
        array.push(nwe_coefs, w)
    nwe_den := array.sum(nwe_coefs)

float nwe_out = na
if not nwe_repaint and not na(nwe_den)
    float acc = 0.0
    for i = 0 to 499
        acc += nwe_src[i] * array.get(nwe_coefs, i)
    nwe_out := acc / nwe_den

nwe_mae = ta.sma(math.abs(nwe_src - nwe_out), 499) * nwe_mult
nwe_upper = nwe_out + nwe_mae
nwe_lower = nwe_out - nwe_mae

// Crossing arrows (endpoint method)
plotshape(nwe_showSignals and ta.crossunder(close, nwe_out - nwe_mae) ? low : na, "NWE Crossunder", shape.labelup, location.absolute, color(na), 0, text="▲", textcolor=nwe_upCss, size=size.tiny)
plotshape(nwe_showSignals and ta.crossover(close, nwe_out + nwe_mae) ? high : na, "NWE Crossover", shape.labeldown, location.absolute, color(na), 0, text="▼", textcolor=nwe_dnCss, size=size.tiny)

// Hull MA (as in pasted code)
nwe_hmaLen = input.int(9, "Hull MA Length", minval=1, group="NWE")
nwe_hmaSrc = input.source(close, "Hull MA Source", group="NWE")
nwe_hullma = ta.wma(2 * ta.wma(nwe_hmaSrc, nwe_hmaLen / 2) - ta.wma(nwe_hmaSrc, nwe_hmaLen), math.floor(math.sqrt(nwe_hmaLen)))
plot(nwe_hullma, "Hull MA", color=color.new(color.blue, 0))

// Compute and display NWE (repainting)
float nwe_y2 = na
float nwe_y1 = na

var nwe_pts = array.new_float(0)
if barstate.islast and nwe_repaint
    array.clear(nwe_pts)
    sae = 0.0
    maxN = math.min(499, nwe_n - 1)
    for i = 0 to maxN
        sum = 0.0
        sumw = 0.0
        for j = 0 to maxN
            w = nwe_gauss(i - j, nwe_h)
            sum += nwe_src[j] * w
            sumw += w
        nwe_y2 := sum / sumw
        sae += math.abs(nwe_src[i] - nwe_y2)
        array.push(nwe_pts, nwe_y2)

    sae := (sae / math.max(1, maxN)) * nwe_mult
    for i = 0 to maxN
        if i % 2
            line.new(nwe_n - i + 1, nwe_y1 + sae, nwe_n - i, array.get(nwe_pts, i) + sae, color=nwe_upCss)
            line.new(nwe_n - i + 1, nwe_y1 - sae, nwe_n - i, array.get(nwe_pts, i) - sae, color=nwe_dnCss)

        if i < maxN and nwe_src[i] > array.get(nwe_pts, i) + sae and nwe_src[i + 1] < array.get(nwe_pts, i) + sae
            label.new(nwe_n - i, nwe_src[i], "▼", color=color(na), style=label.style_label_down, textcolor=nwe_dnCss, textalign=text.align_center)
        if i < maxN and nwe_src[i] < array.get(nwe_pts, i) - sae and nwe_src[i + 1] > array.get(nwe_pts, i) - sae
            label.new(nwe_n - i, nwe_src[i], "▲", color=color(na), style=label.style_label_up, textcolor=nwe_upCss, textalign=text.align_center)
        nwe_y1 := array.get(nwe_pts, i)

// Dashboard
var nwe_tb = table.new(position.top_right, 1, 1, bgcolor=#1e222d, border_color=#373a46, border_width=1, frame_color=#373a46, frame_width=1)
if nwe_repaint
    nwe_tb.cell(0, 0, "Repainting Mode Enabled", text_color=color.white, text_size=size.small)

// Plot endpoint bands when not repainting (matches LuxAlgo)
plot(nwe_repaint ? na : nwe_upper, "NWE Upper", nwe_upCss)
plot(nwe_repaint ? na : nwe_lower, "NWE Lower", nwe_dnCss)

// Example sell signal from pasted code
_nwe_sellSignal = close < nwe_hullma
