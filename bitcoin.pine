//@version=5
indicator("Outside 2D (levels on next candle)", overlay=true, max_labels_count=500)

// ───────── Inputs ─────────
count = input.int(1, "Number of consecutive outside bars (2D)", minval=1, maxval=10)

highlight2DOutsideClose = input.bool(true, "Highlight 2D outside CLOSE bar")
highlightColor = input.color(color.new(color.orange, 85), "Highlight color")

// Levels
entryPct1 = input.float(0.40, "Entry 40%", minval=0.0, maxval=1.0, step=0.01, group="Levels")
entryPct2 = input.float(0.61, "Entry 61%", minval=0.0, maxval=1.0, step=0.01, group="Levels")
stopPct   = input.float(0.80, "Stop 80%",  minval=0.0, maxval=1.0, step=0.01, group="Levels")

showCrosses = input.bool(true, "Show 4 large crosses on NEXT candle", group="Levels")
showBuySellLabel = input.bool(true, "Show BUY/SELL label on NEXT candle", group="Levels")

enableSell = input.bool(true, "Enable SELL (bearish 2D outside)", group="Direction")
enableBuy  = input.bool(true, "Enable BUY (bullish 2D outside)", group="Direction")

enableWickProjection = input.bool(true, "Include wick projection cross", group="Wick projection")

// ───────── Helpers ─────────
f_isOutsideN(_n) =>
    oc = 0
    for i = 0 to _n - 1
        if high[i] > high[i + 1] and low[i] < low[i + 1]
            oc += 1
    oc >= _n

f_x(_y, _col) =>
    label.new(x=bar_index, y=_y, text="X", style=label.style_label_center, color=color.new(_col, 100), textcolor=_col, size=size.normal)

// ───────── 2D series ─────────
outside2D = request.security(syminfo.tickerid, "2D", f_isOutsideN(count), lookahead=barmerge.lookahead_off)
bull2D   = request.security(syminfo.tickerid, "2D", close >= open, lookahead=barmerge.lookahead_off)
bear2D   = request.security(syminfo.tickerid, "2D", open > close, lookahead=barmerge.lookahead_off)

// True only on chart bar that closes the 2D candle
close2Dbar = request.security(syminfo.tickerid, "2D", barstate.isconfirmed, lookahead=barmerge.lookahead_off)
outsideCloseBar = close2Dbar and outside2D

// Highlight the close bar of the 2D outside candle
bgcolor(highlight2DOutsideClose and outsideCloseBar ? highlightColor : na)

// Previous (just-closed) 2D candle OHLC (available on NEXT chart bar via [1])
o2 = request.security(syminfo.tickerid, "2D", open, lookahead=barmerge.lookahead_off)
h2 = request.security(syminfo.tickerid, "2D", high, lookahead=barmerge.lookahead_off)
l2 = request.security(syminfo.tickerid, "2D", low,  lookahead=barmerge.lookahead_off)

// NEXT chart candle after the 2D outside bar close
nextAfterOutside2D = outsideCloseBar[1]

// Use the direction of the just-closed 2D outside candle
sellSetup = enableSell and nextAfterOutside2D and bear2D[1]
buySetup  = enableBuy  and nextAfterOutside2D and bull2D[1]

oPrev = o2[1]
hPrev = h2[1]
lPrev = l2[1]
rngPrev = hPrev - lPrev

if showCrosses and sellSetup and not na(rngPrev)
    e40 = lPrev + entryPct1 * rngPrev
    e61 = lPrev + entryPct2 * rngPrev
    e80 = lPrev + stopPct * rngPrev
    if enableWickProjection
        wick = hPrev - oPrev
        wProj = open + wick
        f_x(wProj, color.purple)
    f_x(e40, color.red)
    f_x(e61, color.red)
    f_x(e80, color.orange)
    if showBuySellLabel
        label.new(x=bar_index, y=high, text="SELL", style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.red, size=size.tiny)

if showCrosses and buySetup and not na(rngPrev)
    e40 = hPrev - entryPct1 * rngPrev
    e61 = hPrev - entryPct2 * rngPrev
    e80 = hPrev - stopPct * rngPrev
    if enableWickProjection
        wick = oPrev - lPrev
        wProj = open - wick
        f_x(wProj, color.purple)
    f_x(e40, color.green)
    f_x(e61, color.green)
    f_x(e80, color.orange)
    if showBuySellLabel
        label.new(x=bar_index, y=low, text="BUY", style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.green, size=size.tiny)
