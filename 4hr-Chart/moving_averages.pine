//@version=5
indicator("Moving Averages", overlay=true)

// Input parameters
len21 = input.int(21, "21 SMA Length")
len50 = input.int(50, "50 SMA Length")
len100 = input.int(100, "100 SMA Length")
len200 = input.int(200, "200 SMA Length")

// Calculate SMAs
sma21 = ta.sma(close, len21)
sma50 = ta.sma(close, len50)
sma100 = ta.sma(close, len100)
sma200 = ta.sma(close, len200)

// Plot SMAs
plot(sma21, color=color.green, title="21 SMA", linewidth=2)
plot(sma50, color=color.blue, title="50 SMA", linewidth=2)
p100 = plot(sma100, color=color.orange, title="100 SMA", linewidth=2)
p200 = plot(sma200, color=color.red, title="200 SMA", linewidth=2)

// Pip Calculation (Standard 10 * mintick)
pip_val = syminfo.mintick * 10

// 30 Pips Bands relative to 200 SMA
band_top = sma200 + (30 * pip_val)
band_bot = sma200 - (30 * pip_val)

plot(band_top, color=color.gray, title="Upper 30 Pips", linewidth=1, style=plot.style_circles)
plot(band_bot, color=color.gray, title="Lower 30 Pips", linewidth=1, style=plot.style_circles)

// Fill Logic
// Fill between 100 SMA and 200 SMA with green color
// ONLY when 100 SMA is more than 10 pips above the 200 SMA
threshold_fill = sma200 + (10 * pip_val)
fill_condition = sma100 >= threshold_fill

fill(p100, p200, color = fill_condition ? color.new(color.green, 70) : na, title="100 SMA > 200 SMA + 10 Pips Fill")
