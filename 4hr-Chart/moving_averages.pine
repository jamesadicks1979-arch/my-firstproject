//@version=5
indicator("Moving Averages (Combined)", overlay=true)

// --- INPUTS ---
grp_chart = "Chart Timeframe SMAs"
show_chart = input.bool(true, "Show Chart Timeframe SMAs?", group=grp_chart)
len21 = input.int(21, "21 Length", group=grp_chart)
len50 = input.int(50, "50 Length", group=grp_chart)
len100 = input.int(100, "100 Length", group=grp_chart)
len200 = input.int(200, "200 Length", group=grp_chart)

grp_daily = "Daily Timeframe SMAs (Locked)"
show_daily = input.bool(true, "Show Daily SMAs?", group=grp_daily)

// --- CONSTANTS ---
pip_val = syminfo.mintick * 10

// ==========================================
// 1. CHART TIMEFRAME LOGIC
// ==========================================
c_s21 = ta.sma(close, len21)
c_s50 = ta.sma(close, len50)
c_s100 = ta.sma(close, len100)
c_s200 = ta.sma(close, len200)

// Plot Chart SMAs (Thinner Lines: 1)
cp21 = plot(show_chart ? c_s21 : na, color=color.green, title="Chart 21 SMA", linewidth=1)
cp50 = plot(show_chart ? c_s50 : na, color=color.blue, title="Chart 50 SMA", linewidth=1)
cp100 = plot(show_chart ? c_s100 : na, color=color.orange, title="Chart 100 SMA", linewidth=1)
cp200 = plot(show_chart ? c_s200 : na, color=color.red, title="Chart 200 SMA", linewidth=1)

// Chart Fills
// 100/200: Green if 100 > 200+8pips & 21>=100 | Red if 100 < 200-8pips & 21<=100
c_thresh_100_long = c_s200 + (8 * pip_val)
c_thresh_100_short = c_s200 - (8 * pip_val)

c_col_100 = if show_chart and c_s100 >= c_thresh_100_long and c_s21 >= c_s100
    color.new(color.green, 70)
else if show_chart and c_s100 <= c_thresh_100_short and c_s21 <= c_s100
    color.new(color.red, 70)
else
    na
fill(cp100, cp200, color=c_col_100, title="Chart 100/200 Fill")

// 21/50: Green if 21 > 50+3pips | Red if 21 < 50-3pips
c_thresh_21_long = c_s50 + (3 * pip_val)
c_thresh_21_short = c_s50 - (3 * pip_val)

c_col_21 = if show_chart and c_s21 >= c_thresh_21_long
    color.new(color.green, 70)
else if show_chart and c_s21 <= c_thresh_21_short
    color.new(color.red, 70)
else
    na
fill(cp21, cp50, color=c_col_21, title="Chart 21/50 Fill")


// ==========================================
// 2. DAILY TIMEFRAME LOGIC (LOCKED)
// ==========================================
calc_daily() =>
    d21 = ta.sma(close, len21)
    d50 = ta.sma(close, len50)
    d100 = ta.sma(close, len100)
    d200 = ta.sma(close, len200)
    
    // Fill Logic inside security to get correct colors per day
    pv = syminfo.mintick * 10
    
    // 100/200
    dt_100_long = d200 + (8 * pv)
    dt_100_short = d200 - (8 * pv)
    dc_100 = if d100 >= dt_100_long and d21 >= d100
        color.new(color.green, 85) // Slightly more transparent for Daily
    else if d100 <= dt_100_short and d21 <= d100
        color.new(color.red, 85)
    else
        na
        
    // 21/50
    dt_21_long = d50 + (3 * pv)
    dt_21_short = d50 - (3 * pv)
    dc_21 = if d21 >= dt_21_long
        color.new(color.green, 85)
    else if d21 <= dt_21_short
        color.new(color.red, 85)
    else
        na
    
    [d21, d50, d100, d200, dc_100, dc_21]

[d_s21, d_s50, d_s100, d_s200, d_col100, d_col21] = request.security(syminfo.tickerid, "D", calc_daily())

// Plot Daily SMAs (Thicker Lines: 3)
dp21 = plot(show_daily ? d_s21 : na, color=color.green, title="Daily 21 SMA", linewidth=3)
dp50 = plot(show_daily ? d_s50 : na, color=color.blue, title="Daily 50 SMA", linewidth=3)
dp100 = plot(show_daily ? d_s100 : na, color=color.orange, title="Daily 100 SMA", linewidth=3)
dp200 = plot(show_daily ? d_s200 : na, color=color.red, title="Daily 200 SMA", linewidth=3)

// Daily Fills
fill(dp100, dp200, color=show_daily ? d_col100 : na, title="Daily 100/200 Fill")
fill(dp21, dp50, color=show_daily ? d_col21 : na, title="Daily 21/50 Fill")


// ==========================================
// 4. BREAKOUT FIBONACCI LOGIC
// ==========================================
// Condition: Price trades below ALL SMAs (Chart & Daily)
// Trigger: Price trades up and CLOSES above ALL SMAs
// Action: Draw Fibs from Breakout High to Lowest Low during the "Below All" period

// Combine all SMAs into checking variables
// Note: We use nz() to handle potential NaN values early in history
// We define "Below All" as close < EVERY SMA that is active
// If user turns off chart or daily in inputs, should we still use them for calculation?
// User query implies "all the sma's including the Daily", so we force check ALL 8 SMAs.

// 1. Determine "All Below" State
is_below_chart = close < c_s21 and close < c_s50 and close < c_s100 and close < c_s200
is_below_daily = close < d_s21 and close < d_s50 and close < d_s100 and close < d_s200
all_below = is_below_chart and is_below_daily

// 2. Determine "All Above" State (Breakout)
is_above_chart = close > c_s21 and close > c_s50 and close > c_s100 and close > c_s200
is_above_daily = close > d_s21 and close > d_s50 and close > d_s100 and close > d_s200
all_above = is_above_chart and is_above_daily

// 3. State Management
var float lowest_in_sequence = na
var bool tracking_below = false

// Pullback Monitoring Variables
var float active_breakout_high = na
var float active_breakout_50 = na
var bool active_breakout_active = false

// Logic Loop
if all_below
    if not tracking_below
        // Start of a new "Below Sequence"
        tracking_below := true
        lowest_in_sequence := low
    else
        // Continue tracking lowest low
        lowest_in_sequence := math.min(lowest_in_sequence, low)
else
    // We are NOT "All Below". Check for Breakout.
    if tracking_below and all_above
        // !!! BREAKOUT TRIGGERED !!!
        trigger_price = high // Use Breakout Candle High as the anchor 0%? Or Close? "work out a 38.2% fib"
        // Standard Retracement: High (0%) to Low (100%). Pullback target is 38.2% down from High.
        // Level = High - (Range * 0.382)
        
        range_val = trigger_price - lowest_in_sequence
        
        lev_38 = trigger_price - (range_val * 0.382)
        lev_50 = trigger_price - (range_val * 0.50)
        lev_61 = trigger_price - (range_val * 0.618)
        lev_80 = trigger_price - (range_val * 0.80)
        
        // Draw Lines (Duration: 2 Weeks)
        t1 = time
        t2 = time + (14 * 24 * 60 * 60 * 1000) // 2 Weeks in ms
        
        // Store IDs to manage or reference?
        // For now just draw them.
        line.new(t1, lev_38, t2, lev_38, xloc=xloc.bar_time, color=color.purple, width=1, style=line.style_solid)
        line.new(t1, lev_50, t2, lev_50, xloc=xloc.bar_time, color=color.blue, width=2, style=line.style_solid)
        line.new(t1, lev_61, t2, lev_61, xloc=xloc.bar_time, color=color.purple, width=1, style=line.style_solid)
        line.new(t1, lev_80, t2, lev_80, xloc=xloc.bar_time, color=color.red, width=2, style=line.style_solid)
        
        // --- Active Breakout State for Pullback Monitoring ---
        // We need to store these values to monitor for the 50% breach
        // Since Pine Script variables reset on each bar unless 'var', we need arrays or var variables.
        // But 'var' works for single instance. Arrays work for multiple.
        // Assuming we monitor the *latest* breakout.
        
        active_breakout_high := trigger_price
        active_breakout_50 := lev_50
        active_breakout_active := true
        
        // Reset State for "Below Sequence"
        tracking_below := false
        lowest_in_sequence := na
        
    else if tracking_below and not all_below
        // "Messy Middle" (Transition).
        na

// 4b. Pullback Monitoring (New Rule)
// "when the price comes down a goes below 50% can you flag that and then take that as a new low and work fibs from there"
// "looking for the next wave so the fibs and make then last a week on the charts"

if active_breakout_active
    // Check for breach
    if low < active_breakout_50
        // Flag it
        plotchar(true, char="P", location=location.belowbar, color=color.orange, size=size.tiny, title="50% Pullback")
        
        // Take that as a new low (Pullback Low)
        pullback_low = low
        
        // Work Fibs from there (Breakout High to Pullback Low)
        // Range = High - Pullback Low
        pb_range = active_breakout_high - pullback_low
        
        pb_38 = active_breakout_high - (pb_range * 0.382)
        pb_50 = active_breakout_high - (pb_range * 0.50)
        pb_61 = active_breakout_high - (pb_range * 0.618)
        pb_80 = active_breakout_high - (pb_range * 0.80)
        
        // Draw Lines (Duration: 1 Week)
        t_pb_1 = time
        t_pb_2 = time + (7 * 24 * 60 * 60 * 1000) // 1 Week
        
        // Use Dashed lines to distinguish secondary fibs
        line.new(t_pb_1, pb_38, t_pb_2, pb_38, xloc=xloc.bar_time, color=color.new(color.purple, 30), width=1, style=line.style_dashed)
        line.new(t_pb_1, pb_50, t_pb_2, pb_50, xloc=xloc.bar_time, color=color.new(color.blue, 30), width=2, style=line.style_dashed)
        line.new(t_pb_1, pb_61, t_pb_2, pb_61, xloc=xloc.bar_time, color=color.new(color.purple, 30), width=1, style=line.style_dashed)
        line.new(t_pb_1, pb_80, t_pb_2, pb_80, xloc=xloc.bar_time, color=color.new(color.red, 30), width=2, style=line.style_dashed)
        
        // Disable monitoring for this breakout to avoid re-triggering on every bar below 50%?
        // User says "looking for the next wave", implying we set this up once.
        active_breakout_active := false

// Plot Trigger Signal for Debugging
plotchar(tracking_below and all_above, char="F", location=location.abovebar, color=color.purple, size=size.tiny, title="Fib Breakout")

// ==========================================
// 3. LABELS (Update on Right)
// ==========================================
if barstate.islast
    // Chart Labels (Offset +3)
    if show_chart
        label.new(bar_index + 3, c_s21, "Chart 21\n" + str.tostring(c_s21, format.mintick), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s50, "Chart 50\n" + str.tostring(c_s50, format.mintick), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s100, "Chart 100\n" + str.tostring(c_s100, format.mintick), color=color.orange, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s200, "Chart 200\n" + str.tostring(c_s200, format.mintick), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)

    // Daily Labels (Offset +10 to avoid overlap)
    if show_daily
        label.new(bar_index + 10, d_s21, "Daily 21\n" + str.tostring(d_s21, format.mintick), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s50, "Daily 50\n" + str.tostring(d_s50, format.mintick), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s100, "Daily 100\n" + str.tostring(d_s100, format.mintick), color=color.orange, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s200, "Daily 200\n" + str.tostring(d_s200, format.mintick), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
