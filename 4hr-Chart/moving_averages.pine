//@version=5
indicator("Moving Averages (Unified)", overlay=true)

// Input parameters
len21 = input.int(21, "21 SMA Length")
len50 = input.int(50, "50 SMA Length")
len100 = input.int(100, "100 SMA Length")
len200 = input.int(200, "200 SMA Length")
use_daily = input.bool(false, "Lock to Daily Timeframe?", tooltip="If checked, shows Daily SMAs regardless of chart timeframe. If unchecked, shows Chart Timeframe SMAs.")

// Calculation Function (Reusable)
calc_smas() =>
    s21 = ta.sma(close, len21)
    s50 = ta.sma(close, len50)
    s100 = ta.sma(close, len100)
    s200 = ta.sma(close, len200)
    [s21, s50, s100, s200]

// 1. Chart Timeframe Values
[c_s21, c_s50, c_s100, c_s200] = calc_smas()

// 2. Daily Timeframe Values
[d_s21, d_s50, d_s100, d_s200] = request.security(syminfo.tickerid, "D", calc_smas())

// 3. Select Values based on User Input
s21 = use_daily ? d_s21 : c_s21
s50 = use_daily ? d_s50 : c_s50
s100 = use_daily ? d_s100 : c_s100
s200 = use_daily ? d_s200 : c_s200

// Pip Value
pip_val = syminfo.mintick * 10

// Plot SMAs
p21 = plot(s21, color=color.green, title="21 SMA", linewidth=2)
p50 = plot(s50, color=color.blue, title="50 SMA", linewidth=2)
p100 = plot(s100, color=color.orange, title="100 SMA", linewidth=2)
p200 = plot(s200, color=color.red, title="200 SMA", linewidth=2)

// --- Fill Logic 100/200 ---
// Green: 100 SMA > 200 SMA + 8 pips AND 21 >= 100
// Red:   100 SMA < 200 SMA - 8 pips AND 21 <= 100
thresh_100_long = s200 + (8 * pip_val)
thresh_100_short = s200 - (8 * pip_val)

c_100 = if s100 >= thresh_100_long and s21 >= s100
    color.new(color.green, 70)
else if s100 <= thresh_100_short and s21 <= s100
    color.new(color.red, 70)
else
    na

fill(p100, p200, color = c_100, title="100/200 SMA Fill")

// --- Fill Logic 21/50 ---
// Green: 21 SMA > 50 SMA + 3 pips
// Red:   21 SMA < 50 SMA - 3 pips
thresh_21_long = s50 + (3 * pip_val)
thresh_21_short = s50 - (3 * pip_val)

c_21 = if s21 >= thresh_21_long
    color.new(color.green, 70)
else if s21 <= thresh_21_short
    color.new(color.red, 70)
else
    na

fill(p21, p50, color = c_21, title="21/50 SMA Fill")

// Update on Right: Add labels
if barstate.islast
    label_prefix = use_daily ? "Daily " : ""
    label.new(bar_index + 3, s21, label_prefix + "21 SMA\n" + str.tostring(s21, format.mintick), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
    label.new(bar_index + 3, s50, label_prefix + "50 SMA\n" + str.tostring(s50, format.mintick), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
    label.new(bar_index + 3, s100, label_prefix + "100 SMA\n" + str.tostring(s100, format.mintick), color=color.orange, style=label.style_label_left, textcolor=color.white, size=size.small)
    label.new(bar_index + 3, s200, label_prefix + "200 SMA\n" + str.tostring(s200, format.mintick), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)