//@version=5
indicator("Moving Averages", overlay=true, max_lines_count=500, max_labels_count=500)

// Input parameters
len200 = input.int(200, "200 SMA Length")
len100 = input.int(100, "100 SMA Length")
len50 = input.int(50, "50 SMA Length")
len21 = input.int(21, "21 SMA Length")

// Calculate SMAs
sma200 = ta.sma(close, len200)
sma100 = ta.sma(close, len100)
sma50 = ta.sma(close, len50)
sma21 = ta.sma(close, len21)

// Plot SMAs
plot(sma200, color=color.red, title="200 SMA", linewidth=4)
plot(sma100, color=color.orange, title="100 SMA", linewidth=2)
plot(sma50, color=color.blue, title="50 SMA", linewidth=2)
plot(sma21, color=color.green, title="21 SMA", linewidth=2)

// --- Logic for LONG Setups ---
// 1. Current State: 21, 50, 100 ALL ABOVE 200
// 2. Previous State: 21, 50, 100 ALL BELOW 200 within last 2 days
// 3. Anchor: Lowest Low since the last time ALL were BELOW 200

all_above_long = sma21 > sma200 and sma50 > sma200 and sma100 > sma200
all_below_long = sma21 < sma200 and sma50 < sma200 and sma100 < sma200

// Detect crossover moment
cross_up_condition = all_above_long and not all_above_long[1]

// Check if we came from "all below" within 48h (approx 12 bars on 4h chart, but safe to check 20)
was_all_below_recently = false
for i = 1 to 20
    if all_below_long[i]
        was_all_below_recently := true
        break

valid_long = cross_up_condition and was_all_below_recently

// --- Logic for SHORT Setups ---
// 1. Current State: 21, 50, 100 ALL BELOW 200
// 2. Previous State: 21, 50, 100 ALL ABOVE 200 within last 2 days
// 3. Anchor: Highest High since the last time ALL were ABOVE 200

all_below_short = sma21 < sma200 and sma50 < sma200 and sma100 < sma200
all_above_short = sma21 > sma200 and sma50 > sma200 and sma100 > sma200

cross_down_condition = all_below_short and not all_below_short[1]

was_all_above_recently = false
for i = 1 to 20
    if all_above_short[i]
        was_all_above_recently := true
        break

valid_short = cross_down_condition and was_all_above_recently

// Calculate Dynamic Anchor Points
// We need to look back to when the condition was "All Below" (for Long) or "All Above" (for Short)
// and find the extreme value in that period.

var float lowest_since_death_cross = high
var float highest_since_golden_cross = low

// Track lowest low while in "Death State" (All < 200)
if all_below_long
    lowest_since_death_cross := math.min(lowest_since_death_cross, low)
else if all_above_long
    // Reset when we are solidly in Golden State (handled by event trigger, but reset for next cycle)
    // Actually we only reset when we re-enter the Death State
    na

if all_below_long[1] == false and all_below_long
    // Just entered Death State, reset tracker
    lowest_since_death_cross := low

// Track highest high while in "Golden State" (All > 200)
if all_above_short
    highest_since_golden_cross := math.max(highest_since_golden_cross, high)

if all_above_short[1] == false and all_above_short
    // Just entered Golden State, reset tracker
    highest_since_golden_cross := high

// Use these dynamic anchors for the setup
lowest_low_dynamic = lowest_since_death_cross
highest_high_dynamic = highest_since_golden_cross

// State Management
// We need to store DIRECTION: 1 for Long, -1 for Short
// Also START TIME for expiration
var float[] active_anchors = array.new_float() // Low for Long, High for Short
var float[] active_extremes = array.new_float() // Running High for Long, Running Low for Short
var int[] active_directions = array.new_int() // 1 or -1
var int[] active_start_times = array.new_int() // Time in ms

var line[] active_lines_38 = array.new_line()
var line[] active_lines_50 = array.new_line()
var line[] active_lines_61 = array.new_line()
var line[] active_lines_80 = array.new_line()

var label[] active_labels_38 = array.new_label()
var label[] active_labels_50 = array.new_label()
var label[] active_labels_61 = array.new_label()
var label[] active_labels_80 = array.new_label()
var label[] active_marker_labels = array.new_label() // To delete X markers if needed

// --- Add New Long Setup ---
if valid_long
    current_high = high
    range_val = current_high - lowest_low_dynamic
    
    // Initial Levels (Long)
    level_38 = current_high - (range_val * 0.382)
        level_50 = current_high - (range_val * 0.50)
        level_61 = current_high - (range_val * 0.618)
        level_80 = current_high - (range_val * 0.80)
        
        // Create Lines
        l_38 = line.new(bar_index, level_38, bar_index + 1, level_38, xloc=xloc.bar_index, color=color.green, width=1, extend=extend.right)
        l_50 = line.new(bar_index, level_50, bar_index + 1, level_50, xloc=xloc.bar_index, color=color.green, width=2, extend=extend.right)
        l_61 = line.new(bar_index, level_61, bar_index + 1, level_61, xloc=xloc.bar_index, color=color.green, width=1, extend=extend.right)
        l_80 = line.new(bar_index, level_80, bar_index + 1, level_80, xloc=xloc.bar_index, color=color.red, width=2, extend=extend.right)
        
        // Create Labels
        lbl_38 = label.new(bar_index + 5, level_38, "38.2%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_50 = label.new(bar_index + 5, level_50, "50%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_61 = label.new(bar_index + 5, level_61, "61.8%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_80 = label.new(bar_index + 5, level_80, "80%", xloc=xloc.bar_index, color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
        
        // Create Marker
        lbl_marker = label.new(bar_index, lowest_low_dynamic, text="X_L\n" + str.tostring(lowest_low_dynamic), style=label.style_none, textcolor=color.black, size=size.normal)
        // Create Anchor Line (Risk/Stop)
        line.new(bar_index, lowest_low_dynamic, bar_index + 5, lowest_low_dynamic, color=color.black, width=1)

        // Push to Arrays
        array.push(active_anchors, lowest_low_dynamic)
        array.push(active_extremes, current_high)
        array.push(active_directions, 1)
        array.push(active_start_times, time)
        
        array.push(active_lines_38, l_38)
        array.push(active_lines_50, l_50)
        array.push(active_lines_61, l_61)
        array.push(active_lines_80, l_80)
        
        array.push(active_labels_38, lbl_38)
        array.push(active_labels_50, lbl_50)
        array.push(active_labels_61, lbl_61)
        array.push(active_labels_80, lbl_80)
        array.push(active_marker_labels, lbl_marker)

// --- Add New Short Setup ---
if valid_short
    current_low = low
    // For Short: Range = Anchor (High) - Current Low
    range_val = highest_high_dynamic - current_low
    
    // Initial Levels (Short)
    // Retracement goes UP from Low
    level_38 = current_low + (range_val * 0.382)
        level_50 = current_low + (range_val * 0.50)
        level_61 = current_low + (range_val * 0.618)
        level_80 = current_low + (range_val * 0.80)
        
        // Create Lines
        l_38 = line.new(bar_index, level_38, bar_index + 1, level_38, xloc=xloc.bar_index, color=color.green, width=1, extend=extend.right)
        l_50 = line.new(bar_index, level_50, bar_index + 1, level_50, xloc=xloc.bar_index, color=color.green, width=2, extend=extend.right)
        l_61 = line.new(bar_index, level_61, bar_index + 1, level_61, xloc=xloc.bar_index, color=color.green, width=1, extend=extend.right)
        l_80 = line.new(bar_index, level_80, bar_index + 1, level_80, xloc=xloc.bar_index, color=color.red, width=2, extend=extend.right)
        
        // Create Labels
        lbl_38 = label.new(bar_index + 5, level_38, "38.2%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_50 = label.new(bar_index + 5, level_50, "50%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_61 = label.new(bar_index + 5, level_61, "61.8%", xloc=xloc.bar_index, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)
        lbl_80 = label.new(bar_index + 5, level_80, "80%", xloc=xloc.bar_index, color=color.red, textcolor=color.white, style=label.style_label_left, size=size.small)
        
        // Create Marker (High)
        lbl_marker = label.new(bar_index, highest_high_dynamic, text="X_S\n" + str.tostring(highest_high_dynamic), style=label.style_none, textcolor=color.black, size=size.normal)
        // Create Anchor Line (Risk/Stop)
        line.new(bar_index, highest_high_dynamic, bar_index + 5, highest_high_dynamic, color=color.black, width=1)

        // Push to Arrays
        array.push(active_anchors, highest_high_dynamic)
        array.push(active_extremes, current_low)
        array.push(active_directions, -1)
        array.push(active_start_times, time)
        
        array.push(active_lines_38, l_38)
        array.push(active_lines_50, l_50)
        array.push(active_lines_61, l_61)
        array.push(active_lines_80, l_80)
        
        array.push(active_labels_38, lbl_38)
        array.push(active_labels_50, lbl_50)
        array.push(active_labels_61, lbl_61)
        array.push(active_labels_80, lbl_80)
        array.push(active_marker_labels, lbl_marker)


// Logic to check for touches and clean up lines
// We iterate backwards to safely remove items
should_color_purple = false

// 5 days in milliseconds
FIVE_DAYS_MS = 5 * 24 * 60 * 60 * 1000

if array.size(active_anchors) > 0
    for i = array.size(active_anchors) - 1 to 0
        // Get current setup details
        setup_anchor = array.get(active_anchors, i)
        setup_extreme = array.get(active_extremes, i)
        direction = array.get(active_directions, i)
        start_t = array.get(active_start_times, i)
        
        // 1. Check for Expiration (5 days)
        if time - start_t > FIVE_DAYS_MS
            // Expired - Remove everything
            l_38_id = array.get(active_lines_38, i)
            line.delete(l_38_id)
            l_50_id = array.get(active_lines_50, i)
            line.delete(l_50_id)
            l_61_id = array.get(active_lines_61, i)
            line.delete(l_61_id)
            l_80_id = array.get(active_lines_80, i)
            line.delete(l_80_id)
            
            lbl_38_id = array.get(active_labels_38, i)
            label.delete(lbl_38_id)
            lbl_50_id = array.get(active_labels_50, i)
            label.delete(lbl_50_id)
            lbl_61_id = array.get(active_labels_61, i)
            label.delete(lbl_61_id)
            lbl_80_id = array.get(active_labels_80, i)
            label.delete(lbl_80_id)
            
            m_id = array.get(active_marker_labels, i)
            label.delete(m_id)
            
            array.remove(active_anchors, i)
            array.remove(active_extremes, i)
            array.remove(active_directions, i)
            array.remove(active_start_times, i)
            array.remove(active_lines_38, i)
            array.remove(active_lines_50, i)
            array.remove(active_lines_61, i)
            array.remove(active_lines_80, i)
            array.remove(active_labels_38, i)
            array.remove(active_labels_50, i)
            array.remove(active_labels_61, i)
            array.remove(active_labels_80, i)
            array.remove(active_marker_labels, i)
            continue // Skip to next iteration

        // 2. Logic for LONG Setup (direction == 1)
        if direction == 1
            // Running Retracement Logic: Update High if current bar is higher
            new_high = math.max(setup_extreme, high)
            if new_high > setup_extreme
                array.set(active_extremes, i, new_high)
                setup_extreme := new_high
            
            // Recalculate levels
            range_val = setup_extreme - setup_anchor
            lvl_38 = setup_extreme - (range_val * 0.382)
            lvl_50 = setup_extreme - (range_val * 0.50)
            lvl_61 = setup_extreme - (range_val * 0.618)
            lvl_80 = setup_extreme - (range_val * 0.80)
            
            // Get IDs
            l_38_id = array.get(active_lines_38, i)
            l_50_id = array.get(active_lines_50, i)
            l_61_id = array.get(active_lines_61, i)
            l_80_id = array.get(active_lines_80, i)
            lbl_38_id = array.get(active_labels_38, i)
            lbl_50_id = array.get(active_labels_50, i)
            lbl_61_id = array.get(active_labels_61, i)
            lbl_80_id = array.get(active_labels_80, i)
            
            // Update Lines/Labels
            line.set_y1(l_38_id, lvl_38)
            line.set_y2(l_38_id, lvl_38)
            line.set_y1(l_50_id, lvl_50)
            line.set_y2(l_50_id, lvl_50)
            line.set_y1(l_61_id, lvl_61)
            line.set_y2(l_61_id, lvl_61)
            line.set_y1(l_80_id, lvl_80)
            line.set_y2(l_80_id, lvl_80)
            
            label.set_y(lbl_38_id, lvl_38)
            label.set_text(lbl_38_id, "38.2% (" + str.tostring(lvl_38, format.mintick) + ")")
            label.set_y(lbl_50_id, lvl_50)
            label.set_text(lbl_50_id, "50% (" + str.tostring(lvl_50, format.mintick) + ")")
            label.set_y(lbl_61_id, lvl_61)
            label.set_text(lbl_61_id, "61.8% (" + str.tostring(lvl_61, format.mintick) + ")")
            label.set_y(lbl_80_id, lvl_80)
            label.set_text(lbl_80_id, "80% (" + str.tostring(lvl_80, format.mintick) + ")")
            
            // Check Touch (Long: Low <= 50%)
            if low <= lvl_50 and low >= setup_anchor
                // Touched!
                line.set_extend(l_38_id, extend.none)
                line.set_x2(l_38_id, bar_index)
                line.set_extend(l_50_id, extend.none)
                line.set_x2(l_50_id, bar_index)
                line.set_extend(l_61_id, extend.none)
                line.set_x2(l_61_id, bar_index)
                line.set_extend(l_80_id, extend.none)
                line.set_x2(l_80_id, bar_index)
                
                label.set_x(lbl_38_id, bar_index)
                label.set_style(lbl_38_id, label.style_label_right)
                label.set_x(lbl_50_id, bar_index)
                label.set_style(lbl_50_id, label.style_label_right)
                label.set_x(lbl_61_id, bar_index)
                label.set_style(lbl_61_id, label.style_label_right)
                label.set_x(lbl_80_id, bar_index)
                label.set_style(lbl_80_id, label.style_label_right)
                
                should_color_purple := true
                
                // Cleanup arrays
                array.remove(active_anchors, i)
                array.remove(active_extremes, i)
                array.remove(active_directions, i)
                array.remove(active_start_times, i)
                array.remove(active_lines_38, i)
                array.remove(active_lines_50, i)
                array.remove(active_lines_61, i)
                array.remove(active_lines_80, i)
                array.remove(active_labels_38, i)
                array.remove(active_labels_50, i)
                array.remove(active_labels_61, i)
                array.remove(active_labels_80, i)
                array.remove(active_marker_labels, i)
            
            // Check Invalidation (Long: Low < Anchor)
            else if low < setup_anchor
                 // Invalid
                line.delete(l_38_id)
                line.delete(l_50_id)
                line.delete(l_61_id)
                line.delete(l_80_id)
                label.delete(lbl_38_id)
                label.delete(lbl_50_id)
                label.delete(lbl_61_id)
                label.delete(lbl_80_id)
                m_id = array.get(active_marker_labels, i)
                label.delete(m_id)
                
                array.remove(active_anchors, i)
                array.remove(active_extremes, i)
                array.remove(active_directions, i)
                array.remove(active_start_times, i)
                array.remove(active_lines_38, i)
                array.remove(active_lines_50, i)
                array.remove(active_lines_61, i)
                array.remove(active_lines_80, i)
                array.remove(active_labels_38, i)
                array.remove(active_labels_50, i)
                array.remove(active_labels_61, i)
                array.remove(active_labels_80, i)
                array.remove(active_marker_labels, i)
            else
                label.set_x(lbl_38_id, bar_index + 5)
                label.set_x(lbl_50_id, bar_index + 5)
                label.set_x(lbl_61_id, bar_index + 5)
                label.set_x(lbl_80_id, bar_index + 5)
        
        // 3. Logic for SHORT Setup (direction == -1)
        else if direction == -1
            // Running Retracement Logic: Update Low if current bar is lower
            new_low = math.min(setup_extreme, low)
            if new_low < setup_extreme
                array.set(active_extremes, i, new_low)
                setup_extreme := new_low
            
            // Recalculate levels (Range = Anchor High - Low)
            range_val = setup_anchor - setup_extreme
            lvl_38 = setup_extreme + (range_val * 0.382)
            lvl_50 = setup_extreme + (range_val * 0.50)
            lvl_61 = setup_extreme + (range_val * 0.618)
            lvl_80 = setup_extreme + (range_val * 0.80)
            
            // Get IDs
            l_38_id = array.get(active_lines_38, i)
            l_50_id = array.get(active_lines_50, i)
            l_61_id = array.get(active_lines_61, i)
            l_80_id = array.get(active_lines_80, i)
            lbl_38_id = array.get(active_labels_38, i)
            lbl_50_id = array.get(active_labels_50, i)
            lbl_61_id = array.get(active_labels_61, i)
            lbl_80_id = array.get(active_labels_80, i)
            
            // Update Lines/Labels
            line.set_y1(l_38_id, lvl_38)
            line.set_y2(l_38_id, lvl_38)
            line.set_y1(l_50_id, lvl_50)
            line.set_y2(l_50_id, lvl_50)
            line.set_y1(l_61_id, lvl_61)
            line.set_y2(l_61_id, lvl_61)
            line.set_y1(l_80_id, lvl_80)
            line.set_y2(l_80_id, lvl_80)
            
            label.set_y(lbl_38_id, lvl_38)
            label.set_text(lbl_38_id, "38.2% (" + str.tostring(lvl_38, format.mintick) + ")")
            label.set_y(lbl_50_id, lvl_50)
            label.set_text(lbl_50_id, "50% (" + str.tostring(lvl_50, format.mintick) + ")")
            label.set_y(lbl_61_id, lvl_61)
            label.set_text(lbl_61_id, "61.8% (" + str.tostring(lvl_61, format.mintick) + ")")
            label.set_y(lbl_80_id, lvl_80)
            label.set_text(lbl_80_id, "80% (" + str.tostring(lvl_80, format.mintick) + ")")
            
            // Check Touch (Short: High >= 50%)
            if high >= lvl_50 and high <= setup_anchor
                // Touched!
                line.set_extend(l_38_id, extend.none)
                line.set_x2(l_38_id, bar_index)
                line.set_extend(l_50_id, extend.none)
                line.set_x2(l_50_id, bar_index)
                line.set_extend(l_61_id, extend.none)
                line.set_x2(l_61_id, bar_index)
                line.set_extend(l_80_id, extend.none)
                line.set_x2(l_80_id, bar_index)
                
                label.set_x(lbl_38_id, bar_index)
                label.set_style(lbl_38_id, label.style_label_right)
                label.set_x(lbl_50_id, bar_index)
                label.set_style(lbl_50_id, label.style_label_right)
                label.set_x(lbl_61_id, bar_index)
                label.set_style(lbl_61_id, label.style_label_right)
                label.set_x(lbl_80_id, bar_index)
                label.set_style(lbl_80_id, label.style_label_right)
                
                should_color_purple := true
                
                // Cleanup arrays
                array.remove(active_anchors, i)
                array.remove(active_extremes, i)
                array.remove(active_directions, i)
                array.remove(active_start_times, i)
                array.remove(active_lines_38, i)
                array.remove(active_lines_50, i)
                array.remove(active_lines_61, i)
                array.remove(active_lines_80, i)
                array.remove(active_labels_38, i)
                array.remove(active_labels_50, i)
                array.remove(active_labels_61, i)
                array.remove(active_labels_80, i)
                array.remove(active_marker_labels, i)
            
            // Check Invalidation (Short: High > Anchor)
            else if high > setup_anchor
                 // Invalid
                line.delete(l_38_id)
                line.delete(l_50_id)
                line.delete(l_61_id)
                line.delete(l_80_id)
                label.delete(lbl_38_id)
                label.delete(lbl_50_id)
                label.delete(lbl_61_id)
                label.delete(lbl_80_id)
                m_id = array.get(active_marker_labels, i)
                label.delete(m_id)
                
                array.remove(active_anchors, i)
                array.remove(active_extremes, i)
                array.remove(active_directions, i)
                array.remove(active_start_times, i)
                array.remove(active_lines_38, i)
                array.remove(active_lines_50, i)
                array.remove(active_lines_61, i)
                array.remove(active_lines_80, i)
                array.remove(active_labels_38, i)
                array.remove(active_labels_50, i)
                array.remove(active_labels_61, i)
                array.remove(active_labels_80, i)
                array.remove(active_marker_labels, i)
            else
                label.set_x(lbl_38_id, bar_index + 5)
                label.set_x(lbl_50_id, bar_index + 5)
                label.set_x(lbl_61_id, bar_index + 5)
                label.set_x(lbl_80_id, bar_index + 5)

// Apply bar color globally
barcolor(should_color_purple ? color.purple : na)

// Plot trigger shape (Combined)
plotshape(valid_long, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Setup")
plotshape(valid_short, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Setup")
