//@version=5
indicator("Moving Averages (Combined)", overlay=true, max_lines_count=500, max_labels_count=500)

// --- INPUTS ---
grp_chart = "Chart Timeframe SMAs"
show_chart = input.bool(true, "Show Chart Timeframe SMAs?", group=grp_chart)
len21 = input.int(21, "21 Length", group=grp_chart)
len50 = input.int(50, "50 Length", group=grp_chart)
len100 = input.int(100, "100 Length", group=grp_chart)
len200 = input.int(200, "200 Length", group=grp_chart)

grp_daily = "Daily Timeframe SMAs (Locked)"
show_daily = input.bool(true, "Show Daily SMAs?", group=grp_daily)

// --- CONSTANTS ---
pip_val = syminfo.mintick * 10

// ==========================================
// 1. CHART TIMEFRAME LOGIC
// ==========================================
c_s21 = ta.sma(close, len21)
c_s50 = ta.sma(close, len50)
c_s100 = ta.sma(close, len100)
c_s200 = ta.sma(close, len200)

// Plot Chart SMAs (Thinner Lines: 1)
cp21 = plot(show_chart ? c_s21 : na, color=color.green, title="Chart 21 SMA", linewidth=1)
cp50 = plot(show_chart ? c_s50 : na, color=color.blue, title="Chart 50 SMA", linewidth=1)
cp100 = plot(show_chart ? c_s100 : na, color=color.orange, title="Chart 100 SMA", linewidth=1)
cp200 = plot(show_chart ? c_s200 : na, color=color.red, title="Chart 200 SMA", linewidth=1)

// Chart Fills
// 100/200: Green if 100 > 200+8pips & 21>=100 | Red if 100 < 200-8pips & 21<=100
c_thresh_100_long = c_s200 + (8 * pip_val)
c_thresh_100_short = c_s200 - (8 * pip_val)

c_col_100 = if show_chart and c_s100 >= c_thresh_100_long and c_s21 >= c_s100
    color.new(color.green, 70)
else if show_chart and c_s100 <= c_thresh_100_short and c_s21 <= c_s100
    color.new(color.red, 70)
else
    na
fill(cp100, cp200, color=c_col_100, title="Chart 100/200 Fill")

// 21/50: Green if 21 > 50+3pips | Red if 21 < 50-3pips
c_thresh_21_long = c_s50 + (3 * pip_val)
c_thresh_21_short = c_s50 - (3 * pip_val)

c_col_21 = if show_chart and c_s21 >= c_thresh_21_long
    color.new(color.green, 70)
else if show_chart and c_s21 <= c_thresh_21_short
    color.new(color.red, 70)
else
    na
fill(cp21, cp50, color=c_col_21, title="Chart 21/50 Fill")

// Determine if 21/50 is in Bullish or Bearish alignment based on fill color
// We use the color logic: Green (Bullish), Red (Bearish), NA (Neutral/No Fill)
// c_col_21 returns a color.new(...) object. We can check the alignment condition directly.
// Bullish Alignment: 21 > 50 + 3 pips
bool align_bull_21_50 = c_s21 >= c_thresh_21_long
// Bearish Alignment: 21 < 50 - 3 pips
bool align_bear_21_50 = c_s21 <= c_thresh_21_short

// ==========================================
// 2. DAILY TIMEFRAME LOGIC (LOCKED)
// ==========================================
calc_daily() =>
    d21 = ta.sma(close, len21)
    d50 = ta.sma(close, len50)
    d100 = ta.sma(close, len100)
    d200 = ta.sma(close, len200)
    [d21, d50, d100, d200]

[d_s21, d_s50, d_s100, d_s200] = request.security(syminfo.tickerid, "1D", calc_daily())

// Plot Daily SMAs (Thicker Lines: 2)
plot(show_daily ? d_s21 : na, color=color.green, title="Daily 21 SMA", linewidth=2)
plot(show_daily ? d_s50 : na, color=color.blue, title="Daily 50 SMA", linewidth=2)
plot(show_daily ? d_s100 : na, color=color.orange, title="Daily 100 SMA", linewidth=2)
plot(show_daily ? d_s200 : na, color=color.red, title="Daily 200 SMA", linewidth=2)

// ==========================================
// 3. ALPHATREND LOGIC (INTEGRATED)
// ==========================================
grp_at = "AlphaTrend Settings"
at_coeff = input.float(1, 'Multiplier', step=0.1, group=grp_at)
at_ap = input(14, 'Common Period', group=grp_at)
at_src = input(close, "Source", group=grp_at)
at_showsignals = input(title='Show Signals?', defval=true, group=grp_at)
at_novolumedata = input(title='Change calculation (no volume data)?', defval=false, group=grp_at)

at_atr = ta.sma(ta.tr, at_ap)
at_upT = low - at_atr * at_coeff
at_downT = high + at_atr * at_coeff
AlphaTrend = 0.0
AlphaTrend := (at_novolumedata ? ta.rsi(at_src, at_ap) >= 50 : ta.mfi(hlc3, at_ap) >= 50) ? at_upT < nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : at_upT : at_downT > nz(AlphaTrend[1]) ? nz(AlphaTrend[1]) : at_downT

// AlphaTrend plotting enabled
color1 = AlphaTrend > AlphaTrend[2] ? #00E60F : AlphaTrend < AlphaTrend[2] ? #80000B : AlphaTrend[1] > AlphaTrend[3] ? #00E60F : #80000B
k1 = plot(AlphaTrend, color=color.new(#0022FC, 0), linewidth=3)
k2 = plot(AlphaTrend[2], color=color.new(#FC0400, 0), linewidth=3)
fill(k1, k2, color=color1)

// ==========================================
// 4. STRATEGY LOGIC: 200 SMA RETEST + ALPHATREND
// ==========================================

// --- State Variables ---
// 0: Neutral/Monitoring
// 1: Base Established (Price below 200SMA for Buy, above for Sell)
// 2: Breakout (Price crossed 200SMA)
// 3: Retest Occurred (Price touched 200SMA)

var int buy_state = 0
var int buy_dip_timer = 0
var int buy_base_counter = 0

var int sell_state = 0
var int sell_dip_timer = 0
var int sell_base_counter = 0

// --- BUY LOGIC (Long) ---
// Condition A: Price below 200 SMA for 5 periods
if close < c_s200
    buy_base_counter := buy_base_counter + 1
else
    buy_base_counter := 0

if buy_base_counter >= 5
    buy_state := 1 // Bear Base Established

// Condition B: Breakout (Price crosses above 200 SMA)
if buy_state == 1 and ta.crossover(close, c_s200)
    buy_state := 2 // Breakout
    buy_dip_timer := 0

// Condition C: Retest (Touch or Dip below 200 SMA)
if buy_state == 2
    if low <= c_s200
        buy_state := 3 // Retest Occurred

// Dip Monitoring
if buy_state >= 2
    if close < c_s200
        buy_dip_timer := buy_dip_timer + 1
    else
        buy_dip_timer := 0 
    
    if buy_dip_timer >= 5
        buy_state := 1 // Failed breakout

// Condition D: Trigger (Close above AlphaTrend)
// ADDED: Confirmation 21 > 50 SMA (align_bull_21_50)
// Must be Green Fill alignment
trigger_buy = buy_state == 3 and ta.crossover(close, AlphaTrend) and align_bull_21_50

if trigger_buy
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    buy_state := 0 // Reset after signal

// --- SELL LOGIC (Short) ---
// Condition A: Price above 200 SMA for 5 periods
if close > c_s200
    sell_base_counter := sell_base_counter + 1
else
    sell_base_counter := 0

if sell_base_counter >= 5
    sell_state := 1 // Bull Base Established

// Condition B: Breakout (Price crosses below 200 SMA)
if sell_state == 1 and ta.crossunder(close, c_s200)
    sell_state := 2 // Breakout
    sell_dip_timer := 0

// Condition C: Retest (Touch or rise above 200 SMA)
if sell_state == 2
    if high >= c_s200
        sell_state := 3 // Retest Occurred

// Dip Monitoring (Rise Monitoring)
if sell_state >= 2
    if close > c_s200
        sell_dip_timer := sell_dip_timer + 1
    else
        sell_dip_timer := 0
    
    if sell_dip_timer >= 5
        sell_state := 1 // Failed breakdown

// Condition D: Trigger (Close below AlphaTrend)
// ADDED: Confirmation 21 < 50 SMA (align_bear_21_50)
// Must be Red Fill alignment
trigger_sell = sell_state == 3 and ta.crossunder(close, AlphaTrend) and align_bear_21_50

if trigger_sell
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    sell_state := 0 // Reset

// ==========================================
// 5. RIGHT SIDE LABELS
// ==========================================
if barstate.islast
    // Chart SMAs
    if show_chart
        label.new(bar_index, c_s21, "Chart 21", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)
        label.new(bar_index, c_s50, "Chart 50", style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny)
        label.new(bar_index, c_s100, "Chart 100", style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.tiny)
        label.new(bar_index, c_s200, "Chart 200", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    
    // Daily SMAs
    if show_daily
        label.new(bar_index, d_s21, "Daily 21", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)
        label.new(bar_index, d_s50, "Daily 50", style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny)
        label.new(bar_index, d_s100, "Daily 100", style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.tiny)
        label.new(bar_index, d_s200, "Daily 200", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
