// Combined script: Moving Averages, Nadaraya-Watson Envelope, AlphaTrend
// Nadaraya-Watson Envelope licensed CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/
// (c) LuxAlgo
// AlphaTrend licensed MPL 2.0 https://mozilla.org/MPL/2.0/
// author (c) KivancOzbilgic
// developer (c) KivancOzbilgic
//@version=5
indicator("Moving Averages + NWE + AlphaTrend", overlay=true, format=format.price, precision=2, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// --- INPUTS ---
grp_chart = "Chart Timeframe SMAs"
show_chart = input.bool(true, "Show Chart Timeframe SMAs?", group=grp_chart)
len21 = input.int(21, "21 Length", group=grp_chart)
len50 = input.int(50, "50 Length", group=grp_chart)
len100 = input.int(100, "100 Length", group=grp_chart)
len200 = input.int(200, "200 Length", group=grp_chart)

grp_daily = "Daily Timeframe SMAs (Locked)"
show_daily = input.bool(true, "Show Daily SMAs?", group=grp_daily)

grp_sell = "Sell Signal Logic"
sell_cluster_pips = input.float(50.0, "Cluster Threshold (Pips)", group=grp_sell, tooltip="Max distance between 21, 50, and 100 SMAs to consider them clustered.")
sell_ext_pips = input.float(400.0, "Extension Threshold (Pips)", group=grp_sell, tooltip="Min distance between 100 and 200 SMAs to consider trend extended.")
show_sell_debug = input.bool(false, "Show Sell Signal Debug Labels?", group=grp_sell)

grp_nwe = "NWE Settings"
nwe_bandwidth = input.float(8.0, "Bandwidth", minval=0, group=grp_nwe)
nwe_mult = input.float(3.0, "Deviation Multiplier", minval=0, group=grp_nwe)
nwe_src = input(close, "Source", group=grp_nwe)
nwe_repaint = input.bool(true, "Repainting Smoothing", tooltip="Repainting means historical output can change over time.", group=grp_nwe)
nwe_show_signals = input.bool(true, "Show Signals?", group=grp_nwe)

grp_nwe_style = "NWE Style"
nwe_up_color = input.color(color.teal, "Up Color", inline="nwec", group=grp_nwe_style)
nwe_down_color = input.color(color.red, "Down Color", inline="nwec", group=grp_nwe_style)

grp_at = "AlphaTrend Settings"
at_mult = input.float(1.0, "Multiplier", step=0.1, group=grp_at)
at_period = input.int(14, "Common Period", group=grp_at)
at_src = input(close, "Source", group=grp_at)
at_show_signals = input.bool(true, "Show Signals?", group=grp_at)
at_no_volume = input.bool(false, "Change calculation (no volume data)?", group=grp_at)

// --- CONSTANTS ---
pip_val = syminfo.mintick * 10

// ==========================================
// 1. CHART TIMEFRAME LOGIC
// ==========================================
c_s21 = ta.sma(close, len21)
c_s50 = ta.sma(close, len50)
c_s100 = ta.sma(close, len100)
c_s200 = ta.sma(close, len200)

// Plot Chart SMAs (Thinner Lines: 1)
cp21 = plot(show_chart ? c_s21 : na, color=color.green, title="Chart 21 SMA", linewidth=1)
cp50 = plot(show_chart ? c_s50 : na, color=color.blue, title="Chart 50 SMA", linewidth=1)
cp100 = plot(show_chart ? c_s100 : na, color=color.orange, title="Chart 100 SMA", linewidth=1)
cp200 = plot(show_chart ? c_s200 : na, color=color.red, title="Chart 200 SMA", linewidth=1)

// Chart Fills
// 100/200: Green if 100 > 200+8pips and 21>=100 | Red if 100 < 200-8pips and 21<=100
c_thresh_100_long = c_s200 + (8 * pip_val)
c_thresh_100_short = c_s200 - (8 * pip_val)
c_col_100 = if show_chart and c_s100 >= c_thresh_100_long and c_s21 >= c_s100
    color.new(color.green, 70)
else if show_chart and c_s100 <= c_thresh_100_short and c_s21 <= c_s100
    color.new(color.red, 70)
else
    na
fill(cp100, cp200, color=c_col_100, title="Chart 100/200 Fill")

// 21/50: Green if 21 > 50+3pips | Red if 21 < 50-3pips
c_thresh_21_long = c_s50 + (3 * pip_val)
c_thresh_21_short = c_s50 - (3 * pip_val)
c_col_21 = if show_chart and c_s21 >= c_thresh_21_long
    color.new(color.green, 70)
else if show_chart and c_s21 <= c_thresh_21_short
    color.new(color.red, 70)
else
    na
fill(cp21, cp50, color=c_col_21, title="Chart 21/50 Fill")

// ==========================================
// 2. DAILY TIMEFRAME LOGIC (LOCKED)
// ==========================================
calc_daily() =>
    d21 = ta.sma(close, len21)
    d50 = ta.sma(close, len50)
    d100 = ta.sma(close, len100)
    d200 = ta.sma(close, len200)

    // Fill Logic inside security to get correct colors per day
    pv = syminfo.mintick * 10

    // 100/200
    dt_100_long = d200 + (8 * pv)
    dt_100_short = d200 - (8 * pv)
    dc_100 = if d100 >= dt_100_long and d21 >= d100
        color.new(color.green, 85)
    else if d100 <= dt_100_short and d21 <= d100
        color.new(color.red, 85)
    else
        na

    // 21/50
    dt_21_long = d50 + (3 * pv)
    dt_21_short = d50 - (3 * pv)
    dc_21 = if d21 >= dt_21_long
        color.new(color.green, 85)
    else if d21 <= dt_21_short
        color.new(color.red, 85)
    else
        na

    [d21, d50, d100, d200, dc_100, dc_21]

[d_s21, d_s50, d_s100, d_s200, d_col100, d_col21] = request.security(syminfo.tickerid, "D", calc_daily())

// Plot Daily SMAs (Thicker Lines: 3)
dp21 = plot(show_daily ? d_s21 : na, color=color.green, title="Daily 21 SMA", linewidth=3)
dp50 = plot(show_daily ? d_s50 : na, color=color.blue, title="Daily 50 SMA", linewidth=3)
dp100 = plot(show_daily ? d_s100 : na, color=color.orange, title="Daily 100 SMA", linewidth=3)
dp200 = plot(show_daily ? d_s200 : na, color=color.red, title="Daily 200 SMA", linewidth=3)

// Daily Fills
fill(dp100, dp200, color=show_daily ? d_col100 : na, title="Daily 100/200 Fill")
fill(dp21, dp50, color=show_daily ? d_col21 : na, title="Daily 21/50 Fill")

// ==========================================
// 3. SELL SIGNAL (Mean Reversion / Collapse)
// ==========================================
fast_cluster_max = math.max(c_s21, c_s50, c_s100)
fast_cluster_min = math.min(c_s21, c_s50, c_s100)
cluster_range = fast_cluster_max - fast_cluster_min
trend_extension = c_s100 - c_s200

// Cluster: The difference between the highest and lowest of the fast moving averages
cond_clustered = cluster_range <= (sell_cluster_pips * pip_val)
// Extension: 100 SMA is significantly above 200 SMA
cond_extended = trend_extension >= (sell_ext_pips * pip_val)
// Trigger: 21 Crosses Under 100
cond_cross = ta.crossunder(c_s21, c_s100)

// Final Signal
sell_signal = cond_cross and cond_clustered and cond_extended
plotshape(sell_signal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Debugging for Sell Signal
if barstate.isconfirmed and cond_cross
    if sell_signal
        na

if show_sell_debug and barstate.islast
    debug_txt = "SELL SIGNAL DEBUG\n" +
      "Cluster Range: " + str.tostring(cluster_range / pip_val, "#.0") + " pips (Max: " + str.tostring(sell_cluster_pips) + ")\n" +
      "Extension: " + str.tostring(trend_extension / pip_val, "#.0") + " pips (Min: " + str.tostring(sell_ext_pips) + ")\n" +
      "21 < 100: " + str.tostring(c_s21 < c_s100) + "\n" +
      "Last Signal: " + str.tostring(sell_signal)

    label.new(bar_index, high, debug_txt, color=color.black, textcolor=color.white, style=label.style_label_down)

// ==========================================
// 4. LABELS (Update on Right)
// ==========================================
if barstate.islast
    // Chart Labels (Offset +3)
    if show_chart
        label.new(bar_index + 3, c_s21, "Chart 21\n" + str.tostring(c_s21, format.mintick), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s50, "Chart 50\n" + str.tostring(c_s50, format.mintick), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s100, "Chart 100\n" + str.tostring(c_s100, format.mintick), color=color.orange, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 3, c_s200, "Chart 200\n" + str.tostring(c_s200, format.mintick), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)
    // Daily Labels (Offset +10 to avoid overlap)
    if show_daily
        label.new(bar_index + 10, d_s21, "Daily 21\n" + str.tostring(d_s21, format.mintick), color=color.green, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s50, "Daily 50\n" + str.tostring(d_s50, format.mintick), color=color.blue, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s100, "Daily 100\n" + str.tostring(d_s100, format.mintick), color=color.orange, style=label.style_label_left, textcolor=color.white, size=size.small)
        label.new(bar_index + 10, d_s200, "Daily 200\n" + str.tostring(d_s200, format.mintick), color=color.red, style=label.style_label_left, textcolor=color.white, size=size.small)

// ==========================================
// 5. NADARAYA-WATSON ENVELOPE
// ==========================================
// Gaussian window
nwe_gauss(x, h) => math.exp(-(math.pow(x, 2) / (h * h * 2)))

// Append lines
nwe_n = bar_index
var nwe_lines = array.new_line(0)

if barstate.isfirst and nwe_repaint
    for i = 0 to 499
        array.push(nwe_lines, line.new(na, na, na, na))

// End point method
var nwe_coefs = array.new_float(0)
var float nwe_den = 0.0

if barstate.isfirst and not nwe_repaint
    for i = 0 to 499
        w = nwe_gauss(i, nwe_bandwidth)
        nwe_coefs.push(w)
    nwe_den := nwe_coefs.sum()

nwe_out = 0.0
if not nwe_repaint
    for i = 0 to 499
        nwe_out += nwe_src[i] * nwe_coefs.get(i)
nwe_out := nwe_out / nwe_den

nwe_mae = ta.sma(math.abs(nwe_src - nwe_out), 499) * nwe_mult
nwe_upper = nwe_out + nwe_mae
nwe_lower = nwe_out - nwe_mae

// Crossing marks
plotshape(nwe_show_signals and ta.crossunder(low, nwe_out - nwe_mae) ? low : na, title="NWE Crossunder", style=shape.labelup, location=location.absolute, color=na, text="^", textcolor=nwe_up_color, size=size.tiny)
plotshape(nwe_show_signals and ta.crossover(high, nwe_out + nwe_mae) ? high : na, title="NWE Crossover", style=shape.labeldown, location=location.absolute, color=na, text="v", textcolor=nwe_down_color, size=size.tiny)

// Compute and display NWE
float nwe_y2 = na
float nwe_y1 = na

nwe_points = array.new<float>(0)
if barstate.islast and nwe_repaint
    sae = 0.0
    // Compute and set NWE point
    for i = 0 to math.min(499, nwe_n - 1)
        sum = 0.0
        sumw = 0.0
        // Compute weighted mean
        for j = 0 to math.min(499, nwe_n - 1)
            w = nwe_gauss(i - j, nwe_bandwidth)
            sum += nwe_src[j] * w
            sumw += w

        nwe_y2 := sum / sumw
        sae += math.abs(nwe_src[i] - nwe_y2)
        nwe_points.push(nwe_y2)

    sae := sae / math.min(499, nwe_n - 1) * nwe_mult
    for i = 0 to math.min(499, nwe_n - 1)
        if i % 2
            line.new(nwe_n - i + 1, nwe_y1 + sae, nwe_n - i, nwe_points.get(i) + sae, color=nwe_up_color)
            line.new(nwe_n - i + 1, nwe_y1 - sae, nwe_n - i, nwe_points.get(i) - sae, color=nwe_down_color)

        if nwe_show_signals and nwe_src[i] > nwe_points.get(i) + sae and nwe_src[i + 1] < nwe_points.get(i) + sae
            label.new(nwe_n - i, nwe_src[i], "v", color=na, style=label.style_label_down, textcolor=nwe_down_color, textalign=text.align_center)
        if nwe_show_signals and nwe_src[i] < nwe_points.get(i) - sae and nwe_src[i + 1] > nwe_points.get(i) - sae
            label.new(nwe_n - i, nwe_src[i], "^", color=na, style=label.style_label_up, textcolor=nwe_up_color, textalign=text.align_center)

        nwe_y1 := nwe_points.get(i)

// Dashboard
var tb = table.new(position.top_right, 1, 1, bgcolor=#1e222d, border_color=#373a46, border_width=1, frame_color=#373a46, frame_width=1)
if nwe_repaint
    tb.cell(0, 0, "Repainting Mode Enabled", text_color=color.white, text_size=size.small)

// Plot
plot(nwe_repaint ? na : nwe_upper, "NWE Upper", nwe_up_color)
plot(nwe_repaint ? na : nwe_lower, "NWE Lower", nwe_down_color)

// ==========================================
// 6. ALPHATREND
// ==========================================
at_atr = ta.sma(ta.tr, at_period)
at_up_t = low - at_atr * at_mult
at_down_t = high + at_atr * at_mult

alpha_trend = 0.0
alpha_trend := (at_no_volume ? ta.rsi(at_src, at_period) >= 50 : ta.mfi(hlc3, at_period) >= 50) ? at_up_t < nz(alpha_trend[1]) ? nz(alpha_trend[1]) : at_up_t : at_down_t > nz(alpha_trend[1]) ? nz(alpha_trend[1]) : at_down_t

alpha_color = alpha_trend > alpha_trend[2] ? #00E60F : alpha_trend < alpha_trend[2] ? #80000B : alpha_trend[1] > alpha_trend[3] ? #00E60F : #80000B
k1 = plot(alpha_trend, color=color.new(#0022FC, 0), linewidth=3)
k2 = plot(alpha_trend[2], color=color.new(#FC0400, 0), linewidth=3)
fill(k1, k2, color=alpha_color)

buy_signalk = ta.crossover(alpha_trend, alpha_trend[2])
sell_signalk = ta.crossunder(alpha_trend, alpha_trend[2])

K1 = ta.barssince(buy_signalk)
K2 = ta.barssince(sell_signalk)
O1 = ta.barssince(buy_signalk[1])
O2 = ta.barssince(sell_signalk[1])

daily_bull = d_s100 > d_s200
daily_bear = d_s100 < d_s200

buy_cond = buy_signalk and at_show_signals and O1 > K2
sell_cond = sell_signalk and at_show_signals and O2 > K1

plotshape(buy_cond and daily_bull ? alpha_trend[2] * 0.9999 : na, title="AlphaTrend BUY (Longterm)", text="Longterm buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0))
plotshape(buy_cond and daily_bear ? alpha_trend[2] * 0.9999 : na, title="AlphaTrend BUY (Short Bias)", text="Buy to sell", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0))
plotshape(buy_cond and not daily_bull and not daily_bear ? alpha_trend[2] * 0.9999 : na, title="AlphaTrend BUY", text="BUY", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#0022FC, 0), textcolor=color.new(color.white, 0))

plotshape(sell_cond and daily_bull ? alpha_trend[2] * 1.0001 : na, title="AlphaTrend SELL (Bullish)", text="Sell to buy", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0))
plotshape(sell_cond and daily_bear ? alpha_trend[2] * 1.0001 : na, title="AlphaTrend SELL (Longterm)", text="Longterm sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0))
plotshape(sell_cond and not daily_bull and not daily_bear ? alpha_trend[2] * 1.0001 : na, title="AlphaTrend SELL", text="SELL", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.new(color.white, 0))

alertcondition(buy_signalk and O1 > K2, title="Potential BUY Alarm", message="BUY SIGNAL!")
alertcondition(sell_signalk and O2 > K1, title="Potential SELL Alarm", message="SELL SIGNAL!")

alertcondition(buy_signalk[1] and O1[1] > K2, title="Confirmed BUY Alarm", message="BUY SIGNAL APPROVED!")
alertcondition(sell_signalk[1] and O2[1] > K1, title="Confirmed SELL Alarm", message="SELL SIGNAL APPROVED!")

alertcondition(ta.cross(close, alpha_trend), title="Price Cross Alert", message="Price - AlphaTrend Crossing!")
alertcondition(ta.crossover(low, alpha_trend), title="Candle CrossOver Alarm", message="LAST BAR is ABOVE ALPHATREND")
alertcondition(ta.crossunder(high, alpha_trend), title="Candle CrossUnder Alarm", message="LAST BAR is BELOW ALPHATREND!")

alertcondition(ta.cross(close[1], alpha_trend[1]), title="Price Cross Alert After Bar Close", message="Price - AlphaTrend Crossing!")
alertcondition(ta.crossover(low[1], alpha_trend[1]), title="Candle CrossOver Alarm After Bar Close", message="LAST BAR is ABOVE ALPHATREND!")
alertcondition(ta.crossunder(high[1], alpha_trend[1]), title="Candle CrossUnder Alarm After Bar Close", message="LAST BAR is BELOW ALPHATREND!")
